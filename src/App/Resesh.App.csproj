<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\eng\WindowsAppSdk.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Resesh.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Releases are published as native code (Native AOT): no JIT at launch, and the
         install is a third the size of a ReadyToRun build. Applies to dotnet publish only;
         it also turns on the trimming and AOT analyzers for this project. -->
    <PublishAot>true</PublishAot>
    <GhosttyVtManifest>$(MSBuildThisFileDirectory)..\..\eng\ghostty-vt.json</GhosttyVtManifest>
  </PropertyGroup>

  <!-- Shown on the About page. The first "version" in ghostty-vt.json is libghostty-vt's
       (its own release line since vt-1.0.0, not the Ghostty app's). -->
  <ItemGroup>
    <AssemblyMetadata Include="WindowsAppSdkVersion" Value="$(WindowsAppSdkRuntimeVersion)" />
    <AssemblyMetadata Include="GhosttyVersion" Condition="Exists('$(GhosttyVtManifest)')"
                      Value="$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(GhosttyVtManifest)')), '&quot;version&quot;:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- No dot inside the name: MRT would read "LICENSE.<x>.txt" as a resource qualifier. -->
    <Content Include="..\Core\Storage\ColorSchemes\iTerm2-Color-Schemes-LICENSE.txt" Link="iTerm2-Color-Schemes-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\SessionTreeIcons\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\SessionTreeIcons\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AgentIcons\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AgentIcons\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\.artifacts\agent\agent-manifest.json')">
    <!-- The remote session agent for Linux hosts, built by eng/build-agent.ps1 and read
         through AgentPackage. Optional: without it persistence falls back to tmux. -->
    <Content Include="..\..\.artifacts\agent\**\*" Exclude="..\..\.artifacts\agent\**\resesh-agent-tests"
             Link="Agent\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="$(WindowsAppSdkInteractiveExperiencesVersion)" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="$(WindowsAppSdkRuntimeVersion)" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="$(WindowsAppSdkWinUIVersion)" />
    <!-- CommunityToolkit.WinUI still declares the old monolithic SDK package. Keep its
         dependency satisfied without importing that package's assets or build targets. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Resesh.Core.csproj" />
    <ProjectReference Include="..\Terminal\Resesh.Terminal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TryPost and OnTick, which every DispatcherQueue callback goes through. -->
    <Using Include="Resesh.Terminal.DispatcherQueueReporting" Static="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- The terminal page's JS/HTML are copied in from Resesh.Terminal; VS's fast
         up-to-date check otherwise ignores edits to them. -->
    <UpToDateCheckInput Include="..\Terminal\wwwroot\**" />
  </ItemGroup>

  <Import Project="..\..\eng\WinRTUnboxCheck.targets" />

  <!-- Native AOT links Brotli from the ILCompiler and runtime packs into the exe, and rewind
       decompresses with it. Brotli before 1.2.1 has a decoder overflow (CVE-2026-111497),
       fixed in .NET 10.0.14, so refuse to publish with older packs. This checks the versions
       the publish resolved, not the SDK's default, so RuntimeFrameworkVersion can't slip an
       old pack past it. -->
  <Target Name="RequirePatchedBrotli" BeforeTargets="PrepareForPublish"
          DependsOnTargets="ProcessFrameworkReferences">
    <ItemGroup>
      <_BrotliPack Include="@(PackageReference)" Condition="'%(PackageReference.Identity)' == 'Microsoft.DotNet.ILCompiler'">
        <PackVersion>%(PackageReference.Version)</PackVersion>
      </_BrotliPack>
      <_BrotliPack Include="@(RuntimePack)" Condition="$([System.String]::Copy('%(RuntimePack.Identity)').StartsWith('Microsoft.NETCore.App.Runtime.'))">
        <PackVersion>%(RuntimePack.NuGetPackageVersion)</PackVersion>
      </_BrotliPack>
    </ItemGroup>
    <Error Condition="'@(_BrotliPack)' != '' and $([MSBuild]::VersionLessThan('%(_BrotliPack.PackVersion)', '10.0.14'))"
           Text="%(_BrotliPack.Identity) %(_BrotliPack.PackVersion) links a Brotli vulnerable to CVE-2026-111497. Publish with .NET 10.0.14 or later." />
  </Target>

</Project>
