<Application
    x:Class="Resesh.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Colors used by more than one brush below, each defined once. Status colors
                 mean the same in every theme: blue for news (unseen output, a working agent),
                 green for connected or done, amber for waiting, red for failed or recording. -->
            <Color x:Key="SessionDefaultAccentColor">#0078D4</Color>
            <Color x:Key="SessionStatusSuccessColor">#16C60C</Color>
            <Color x:Key="SessionStatusCautionColor">#FFB900</Color>
            <Color x:Key="SessionStatusCriticalColor">#E74856</Color>
            <Color x:Key="SessionStatusNeutralColor">#8A8A8A</Color>
            <!-- Stable instances avoid WinUI's implicit brush transitions during a live
                 light/dark change. Their colors come from ThemeVisualPalette.ApplyToAppResources,
                 at startup and on every theme change, so the palettes live only in code. -->
            <SolidColorBrush x:Key="SessionShellBrush" />
            <!-- App pages hosted in tabs (Settings, Welcome, Import) sit on the selected tab's
                 color, so the tab and its page read as one surface as a terminal tab does. -->
            <SolidColorBrush x:Key="SessionPageBrush" />
            <SolidColorBrush x:Key="SessionChromeBrush" />
            <SolidColorBrush x:Key="SessionAccentBrush" />
            <SolidColorBrush x:Key="SessionInputBrush" />
            <SolidColorBrush x:Key="SessionChromeFrameBrush" />
            <SolidColorBrush x:Key="SessionTreeForegroundBrush" />
            <SolidColorBrush x:Key="SessionTreeMutedForegroundBrush" />
            <SolidColorBrush x:Key="SessionPlaceholderForegroundBrush" />
            <!-- Fluent draws placeholders in its secondary text color, a near match for typed text.
                 Every field app-wide takes the dimmer placeholder brush instead. -->
            <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="SessionPlaceholderForegroundBrush" />
            <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="SessionPlaceholderForegroundBrush" />
            <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="SessionPlaceholderForegroundBrush" />
            <StaticResource x:Key="ComboBoxPlaceHolderForeground" ResourceKey="SessionPlaceholderForegroundBrush" />
            <SolidColorBrush x:Key="SessionTreeSelectionBrush" />
            <SolidColorBrush x:Key="SessionTreeSelectionForegroundBrush" />
            <SolidColorBrush x:Key="SettingsCardBorderBrush" />
            <SolidColorBrush x:Key="SettingsCardBackgroundBrush" />
            <!-- A recessed surface for sample output and code on the Settings page. -->
            <Style x:Key="PreviewSurfaceStyle" TargetType="Border">
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource SettingsCardBorderBrush}" />
                <Setter Property="Background" Value="{StaticResource SettingsCardBackgroundBrush}" />
            </Style>
            <!-- Fluent's menu item and tooltip styles fix their brushes where the style is
                 defined, so brushes overridden at app level (theme colors set to Everything)
                 never reach them. These implicit styles look the same names up from the app. -->
            <Style TargetType="MenuFlyoutItem" BasedOn="{StaticResource DefaultMenuFlyoutItemStyle}">
                <Setter Property="Foreground" Value="{ThemeResource MenuFlyoutItemForeground}" />
            </Style>
            <Style TargetType="ToggleMenuFlyoutItem" BasedOn="{StaticResource DefaultToggleMenuFlyoutItemStyle}">
                <Setter Property="Foreground" Value="{ThemeResource MenuFlyoutItemForeground}" />
            </Style>
            <Style TargetType="MenuFlyoutSubItem" BasedOn="{StaticResource DefaultMenuFlyoutSubItemStyle}">
                <Setter Property="Foreground" Value="{ThemeResource MenuFlyoutItemForeground}" />
            </Style>
            <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTipStyle}">
                <Setter Property="Foreground" Value="{ThemeResource ToolTipForeground}" />
                <Setter Property="Background" Value="{ThemeResource ToolTipBackground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ToolTipBorderBrush}" />
            </Style>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SessionSurfaceBrush" Color="#181818" />
                    <SolidColorBrush x:Key="SessionFrameBrush" Color="#3C3C3C" />
                    <SolidColorBrush x:Key="SessionDividerBrush" Color="#424242" />
                    <SolidColorBrush x:Key="SessionSplitterHoverBrush" Color="{StaticResource SessionDefaultAccentColor}" />
                    <!-- Dims what sits behind an overlay: the strong scrim behind a modal panel,
                         the subtle one behind the floating sessions pane. -->
                    <SolidColorBrush x:Key="SessionScrimBrush" Color="#66000000" />
                    <SolidColorBrush x:Key="SessionScrimSubtleBrush" Color="#33000000" />
                    <SolidColorBrush x:Key="SessionRecordingBrush" Color="{StaticResource SessionStatusCriticalColor}" />
                    <!-- Tab state dots, agent badges and workspace alerts; PresentationValues
                         picks one by key. The badge symbol is dark on every fill. -->
                    <SolidColorBrush x:Key="SessionStatusInfoBrush" Color="{StaticResource SessionDefaultAccentColor}" />
                    <SolidColorBrush x:Key="SessionStatusSuccessBrush" Color="{StaticResource SessionStatusSuccessColor}" />
                    <SolidColorBrush x:Key="SessionStatusCautionBrush" Color="{StaticResource SessionStatusCautionColor}" />
                    <SolidColorBrush x:Key="SessionStatusCriticalBrush" Color="{StaticResource SessionStatusCriticalColor}" />
                    <SolidColorBrush x:Key="SessionStatusNeutralBrush" Color="{StaticResource SessionStatusNeutralColor}" />
                    <SolidColorBrush x:Key="SessionBadgeGlyphBrush" Color="#1B1B1B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SessionSurfaceBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="SessionFrameBrush" Color="#C8C8C8" />
                    <SolidColorBrush x:Key="SessionDividerBrush" Color="#E6E6E6" />
                    <SolidColorBrush x:Key="SessionSplitterHoverBrush" Color="{StaticResource SessionDefaultAccentColor}" />
                    <SolidColorBrush x:Key="SessionScrimBrush" Color="#66000000" />
                    <SolidColorBrush x:Key="SessionScrimSubtleBrush" Color="#33000000" />
                    <SolidColorBrush x:Key="SessionRecordingBrush" Color="{StaticResource SessionStatusCriticalColor}" />
                    <!-- Tab state dots, agent badges and workspace alerts; PresentationValues
                         picks one by key. The badge symbol is dark on every fill. -->
                    <SolidColorBrush x:Key="SessionStatusInfoBrush" Color="{StaticResource SessionDefaultAccentColor}" />
                    <SolidColorBrush x:Key="SessionStatusSuccessBrush" Color="{StaticResource SessionStatusSuccessColor}" />
                    <SolidColorBrush x:Key="SessionStatusCautionBrush" Color="{StaticResource SessionStatusCautionColor}" />
                    <SolidColorBrush x:Key="SessionStatusCriticalBrush" Color="{StaticResource SessionStatusCriticalColor}" />
                    <SolidColorBrush x:Key="SessionStatusNeutralBrush" Color="{StaticResource SessionStatusNeutralColor}" />
                    <SolidColorBrush x:Key="SessionBadgeGlyphBrush" Color="#1B1B1B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SessionSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SessionFrameBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SessionDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SessionSplitterHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <!-- High Contrast never dims content behind an overlay. -->
                    <SolidColorBrush x:Key="SessionScrimBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="SessionScrimSubtleBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="SessionRecordingBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <!-- High Contrast has no status hues: badges and alerts that carry a symbol
                         fill with the highlight and draw it in highlight text; plain news dots
                         take the link color; an exited tab or idle agent reads as disabled text. -->
                    <SolidColorBrush x:Key="SessionStatusInfoBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="SessionStatusSuccessBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SessionStatusCautionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SessionStatusCriticalBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SessionStatusNeutralBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="SessionBadgeGlyphBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
