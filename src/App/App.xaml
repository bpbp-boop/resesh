<Application
    x:Class="Resesh.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Stable instances avoid WinUI's implicit brush transitions during a live
                 light/dark change. MainWindow mutates their colors before the frame draws. -->
            <SolidColorBrush x:Key="SessionShellBrush" Color="#181818" />
            <SolidColorBrush x:Key="SessionChromeBrush" Color="#1E1E1E" />
            <SolidColorBrush x:Key="SessionAccentBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="SessionInputBrush" Color="#121212" />
            <SolidColorBrush x:Key="SessionChromeFrameBrush" Color="#2B2B2B" />
            <SolidColorBrush x:Key="SessionTreeForegroundBrush" Color="#CCCCCC" />
            <SolidColorBrush x:Key="SessionTreeMutedForegroundBrush" Color="#959595" />
            <SolidColorBrush x:Key="SessionPlaceholderForegroundBrush" Color="#777777" />
            <!-- Fluent draws placeholders in its secondary text color, a near match for typed text.
                 Every field app-wide takes the dimmer placeholder brush instead. -->
            <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="SessionPlaceholderForegroundBrush" />
            <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="SessionPlaceholderForegroundBrush" />
            <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="SessionPlaceholderForegroundBrush" />
            <StaticResource x:Key="ComboBoxPlaceHolderForeground" ResourceKey="SessionPlaceholderForegroundBrush" />
            <SolidColorBrush x:Key="SessionTreeSelectionBrush" Color="#264F78" />
            <SolidColorBrush x:Key="SessionTreeSelectionForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#2B2B2B" />
            <SolidColorBrush x:Key="SettingsCardBackgroundBrush" Color="#121212" />
            <!-- PresentationValues.AgentBadgeColor fills the agent badge the same in every theme,
                 so the symbol drawn on it stays dark in every theme too. -->
            <SolidColorBrush x:Key="SessionBadgeGlyphBrush" Color="#1B1B1B" />
            <!-- A recessed surface for sample output and code on the Settings page. -->
            <Style x:Key="PreviewSurfaceStyle" TargetType="Border">
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource SettingsCardBorderBrush}" />
                <Setter Property="Background" Value="{StaticResource SettingsCardBackgroundBrush}" />
            </Style>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SessionSurfaceBrush" Color="#181818" />
                    <SolidColorBrush x:Key="SessionFrameBrush" Color="#3C3C3C" />
                    <SolidColorBrush x:Key="SessionDividerBrush" Color="#424242" />
                    <SolidColorBrush x:Key="SessionSplitterHoverBrush" Color="#0078D4" />
                    <!-- Dims what sits behind an overlay: the strong scrim behind a modal panel,
                         the subtle one behind the floating sessions pane. -->
                    <SolidColorBrush x:Key="SessionScrimBrush" Color="#66000000" />
                    <SolidColorBrush x:Key="SessionScrimSubtleBrush" Color="#33000000" />
                    <SolidColorBrush x:Key="SessionRecordingBrush" Color="#E74856" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SessionSurfaceBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="SessionFrameBrush" Color="#C8C8C8" />
                    <SolidColorBrush x:Key="SessionDividerBrush" Color="#E6E6E6" />
                    <SolidColorBrush x:Key="SessionSplitterHoverBrush" Color="#0078D4" />
                    <SolidColorBrush x:Key="SessionScrimBrush" Color="#66000000" />
                    <SolidColorBrush x:Key="SessionScrimSubtleBrush" Color="#33000000" />
                    <SolidColorBrush x:Key="SessionRecordingBrush" Color="#E74856" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SessionSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SessionFrameBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SessionDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SessionSplitterHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <!-- High Contrast never dims content behind an overlay. -->
                    <SolidColorBrush x:Key="SessionScrimBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="SessionScrimSubtleBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="SessionRecordingBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
