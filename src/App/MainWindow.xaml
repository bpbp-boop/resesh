<Window
    x:Class="Resesh.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Resesh.App"
    xmlns:controls="using:Resesh.App.Controls"
    xmlns:vm="using:Resesh.App.ViewModels"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Title="Resesh">

    <Grid
        x:Name="Root"
        KeyboardAcceleratorPlacementMode="Hidden"
        Background="{StaticResource SessionShellBrush}">
        <Grid.Resources>
            <!-- These shared brushes are mutated during live theme previews. StaticResource
                 keeps every realized and virtualized tree row on the same brush instance. -->
            <SolidColorBrush x:Key="SessionTreeForegroundBrush" Color="#CCCCCC" />
            <SolidColorBrush x:Key="SessionTreeMutedForegroundBrush" Color="#959595" />

            <DataTemplate x:Key="FolderTemplate" x:DataType="vm:TreeNodeViewModel">
                <TreeViewItem
                    ItemsSource="{x:Bind Children}"
                    IsExpanded="{x:Bind IsExpanded, Mode=OneWay}"
                    Loaded="TreeViewItem_Loaded"
                    GotFocus="TreeNode_GotFocus"
                    AllowDrop="True"
                    Background="{x:Bind SelectionBackground, Mode=OneWay}"
                    Tapped="TreeNode_Tapped"
                    ContextRequested="TreeNode_ContextRequested">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            Glyph="&#xE8B7;"
                            FontSize="14"
                            Foreground="{StaticResource SessionTreeForegroundBrush}" />
                        <TextBlock
                            Text="{x:Bind Name}"
                            FontWeight="Normal"
                            Foreground="{StaticResource SessionTreeForegroundBrush}" />
                    </StackPanel>
                </TreeViewItem>
            </DataTemplate>

            <DataTemplate x:Key="SessionTemplate" x:DataType="vm:TreeNodeViewModel">
                <TreeViewItem
                    ItemsSource="{x:Bind Children}"
                    Loaded="TreeViewItem_Loaded"
                    GotFocus="TreeNode_GotFocus"
                    AllowDrop="True"
                    Background="{x:Bind SelectionBackground, Mode=OneWay}"
                    Tapped="TreeNode_Tapped"
                    ContextRequested="TreeNode_ContextRequested"
                    DoubleTapped="SessionNode_DoubleTapped">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5">
                            <Rectangle.Fill>
                                <SolidColorBrush Color="{x:Bind TagColor, Mode=OneWay}" />
                            </Rectangle.Fill>
                        </Rectangle>
                        <BitmapIcon
                            UriSource="{x:Bind IconUri, Mode=OneWay}"
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SessionTreeForegroundBrush}"
                            ShowAsMonochrome="True"
                            Visibility="{x:Bind TreeIconVisibility, Mode=OneWay}" />
                        <FontIcon
                            Glyph="&#xEDA2;"
                            FontSize="14"
                            Foreground="{StaticResource SessionTreeForegroundBrush}"
                            Visibility="{x:Bind DefaultTreeIconVisibility, Mode=OneWay}" />
                        <TextBlock
                            local:MatchHighlighter.Text="{x:Bind Name}"
                            local:MatchHighlighter.Query="{x:Bind HighlightQuery}"
                            Foreground="{StaticResource SessionTreeForegroundBrush}" />
                        <TextBlock
                            Text="{x:Bind HostSummary, Mode=OneWay}"
                            Foreground="{StaticResource SessionTreeMutedForegroundBrush}"
                            FontSize="12"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </TreeViewItem>
            </DataTemplate>

            <!-- The permanent virtual Local root: terminal glyph, no drag, no rename/delete. -->
            <DataTemplate x:Key="LocalRootTemplate" x:DataType="vm:TreeNodeViewModel">
                <TreeViewItem
                    ItemsSource="{x:Bind Children}"
                    IsExpanded="{x:Bind IsExpanded, Mode=OneWay}"
                    Loaded="TreeViewItem_Loaded"
                    GotFocus="TreeNode_GotFocus"
                    AllowDrop="True"
                    Background="{x:Bind SelectionBackground, Mode=OneWay}"
                    Tapped="TreeNode_Tapped"
                    ContextRequested="TreeNode_ContextRequested">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            Glyph="&#xE7F8;"
                            FontSize="14"
                            Foreground="{StaticResource SessionTreeForegroundBrush}" />
                        <TextBlock
                            Text="{x:Bind Name}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SessionTreeForegroundBrush}" />
                    </StackPanel>
                </TreeViewItem>
            </DataTemplate>

            <local:TreeNodeTemplateSelector
                x:Key="TreeNodeTemplateSelector"
                FolderTemplate="{StaticResource FolderTemplate}"
                SessionTemplate="{StaticResource SessionTemplate}"
                LocalRootTemplate="{StaticResource LocalRootTemplate}" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: menus + centered quick connect + window controls in one row.
             The whole strip is a system drag region; interactive controls are carved out
             via InputNonClientPointerSource passthrough rects (see UpdateTitleBarRegions). -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftPadding" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TitleBarRightPadding" Width="0" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="TitleBarDivider"
                Grid.ColumnSpan="6"
                Height="1"
                VerticalAlignment="Bottom"
                Background="{StaticResource SessionChromeFrameBrush}"
                IsHitTestVisible="False" />

            <Image
                x:Name="TitleBarIcon"
                Grid.Column="1"
                Width="16"
                Height="16"
                Margin="14,0,6,0"
                VerticalAlignment="Center" />

            <MenuBar x:Name="TitleBarMenus" Grid.Column="2" VerticalAlignment="Center">
                <MenuBarItem Title="File">
                    <MenuFlyoutItem Text="New Window" Click="NewWindow_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="New SSH Session…" Click="NewSession_Click" />
                    <MenuFlyoutItem Text="New Local Profile…" Click="NewLocalProfile_Click" />
                    <MenuFlyoutItem Text="New Folder…" Click="NewFolder_Click" />
                    <MenuFlyoutItem Text="Open Recording…" Click="OpenRecording_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Import from SecureCRT…" Click="Import_Click" />
                    <MenuFlyoutItem Text="SSH Keys…" Click="SshKeys_Click" />
                    <MenuFlyoutItem Text="Export backup…" Click="ExportBackup_Click" />
                    <MenuFlyoutItem Text="Import backup…" Click="ImportBackup_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Settings…" Click="Settings_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit" Click="Exit_Click" />
                </MenuBarItem>
                <MenuBarItem x:Name="WorkspacesMenu" Title="Workspaces" />
                <MenuBarItem Title="View">
                    <ToggleMenuFlyoutItem
                        x:Name="SessionsPaneMenuItem"
                        Text="Sessions pane"
                        IsChecked="True"
                        Click="SessionsPaneMenu_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Text="Command Palette…"
                        Click="CommandPaletteMenu_Click"
                        KeyboardAcceleratorTextOverride="Ctrl+Shift+P" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Expand All" Click="ExpandAll_Click" />
                    <MenuFlyoutItem Text="Collapse All" Click="CollapseAll_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Text="Split Right"
                        Click="SplitRightMenu_Click"
                        KeyboardAcceleratorTextOverride="Ctrl+Shift+\" />
                    <MenuFlyoutItem Text="Split Down" Click="SplitDownMenu_Click" />
                    <MenuFlyoutItem
                        Text="File Pane"
                        Click="FilePaneMenu_Click"
                        KeyboardAcceleratorTextOverride="Ctrl+Shift+E" />
                </MenuBarItem>
                <MenuBarItem Title="Session">
                    <MenuFlyoutItem x:Name="ReconnectMenuItem" Text="Reconnect" Click="ReconnectMenu_Click" />
                    <MenuFlyoutItem x:Name="DisconnectMenuItem" Text="Disconnect" Click="DisconnectMenu_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Clone" Click="CloneMenu_Click" />
                    <MenuFlyoutItem Text="Pin Tab" Click="PinTabMenu_Click" />
                    <MenuFlyoutItem Text="Session Options…" Click="SessionOptionsMenu_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="EndRemoteMenuItem" Text="End Remote Session…" Click="EndRemoteMenu_Click" />
                    <MenuFlyoutItem
                        Text="Close Tab"
                        Click="CloseTabMenu_Click"
                        KeyboardAcceleratorTextOverride="Ctrl+F4" />
                </MenuBarItem>
            </MenuBar>

            <Grid
                x:Name="QuickConnectHost"
                Grid.Column="3"
                MaxWidth="560"
                Margin="24,0"
                VerticalAlignment="Center">
                <AutoSuggestBox
                    x:Name="QuickConnectBox"
                    MaxSuggestionListHeight="480"
                    PlaceholderText="ssh user@host or search sessions…"
                    TextChanged="QuickConnect_TextChanged"
                    QuerySubmitted="QuickConnect_QuerySubmitted"
                    GotFocus="QuickConnect_FocusChanged"
                    LostFocus="QuickConnect_FocusChanged"
                    KeyDown="QuickConnect_KeyDown"
                    Background="{StaticResource SessionInputBrush}">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="local:QuickConnectSuggestion">
                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,4">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind Display}" VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Bind Detail}"
                                    Opacity="0.55"
                                    FontSize="12"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
                <Border
                    x:Name="QuickConnectHint"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Padding="6,1,6,2"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    IsHitTestVisible="False">
                    <TextBlock Text="Ctrl+Shift+K" FontSize="11" Opacity="0.6" />
                </Border>
            </Grid>

            <StackPanel
                x:Name="TitleBarButtons"
                Grid.Column="4"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center"
                Margin="0,0,8,0">
                <!-- Split button: primary click opens the default local profile; the menu
                     lists local profiles plus the two "new" entries (populated on opening). -->
                <SplitButton
                    x:Name="NewSessionButton"
                    Click="NewSessionButton_Click"
                    ToolTipService.ToolTip="Open the default local terminal (Ctrl+Shift+T)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Session" />
                    </StackPanel>
                    <SplitButton.Flyout>
                        <MenuFlyout x:Name="NewSessionFlyout" Opening="NewSessionFlyout_Opening" />
                    </SplitButton.Flyout>
                </SplitButton>
                <ToggleButton
                    x:Name="PinButton"
                    Click="PinButton_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Keep window on top">
                    <FontIcon Glyph="&#xE718;" FontSize="14" />
                </ToggleButton>
                <Button
                    Click="Settings_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="WorkspaceNotice"
            Grid.Row="1"
            Margin="12"
            MaxWidth="620"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Canvas.ZIndex="100"
            IsClosable="True"
            IsOpen="False"
            Severity="Informational"
            Title="Workspace note" />

        <!-- Main area: tree | splitter | tabs -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition x:Name="TreeColumn" Width="280" MinWidth="180" />
                <ColumnDefinition x:Name="TreeSplitterColumn" Width="1" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Compact tool rail. Its tabs select the adjacent pane; the top button
                 collapses that pane without removing access to the three tools. -->
            <Border
                Grid.Column="0"
                Canvas.ZIndex="2"
                Background="{StaticResource SessionShellBrush}"
                BorderBrush="{StaticResource SessionChromeFrameBrush}"
                BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Button
                        Width="44"
                        Height="44"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="SessionsPaneToggle_Click"
                        ToolTipService.ToolTip="Show or hide the sessions pane"
                        AutomationProperties.Name="Show or hide the sessions pane">
                        <FontIcon Glyph="&#xE700;" FontSize="16" />
                    </Button>
                    <Rectangle
                        Grid.Row="1"
                        Height="1"
                        Margin="8,0"
                        Fill="{StaticResource SessionChromeFrameBrush}" />
                    <NavigationView
                        x:Name="SessionsRail"
                        Grid.Row="2"
                        Width="44"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Left"
                        PaneDisplayMode="LeftCompact"
                        CompactPaneLength="44"
                        OpenPaneLength="44"
                        IsPaneOpen="False"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        AlwaysShowHeader="False"
                        Background="Transparent"
                        SelectionChanged="SessionsRail_SelectionChanged">
                        <NavigationView.MenuItems>
                            <NavigationViewItem
                                x:Name="SessionsRailItem"
                                Content="Sessions"
                                Tag="sessions"
                                ToolTipService.ToolTip="Sessions"
                                AutomationProperties.Name="Sessions">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem
                                x:Name="WorkspacesRailItem"
                                Content="Workspaces"
                                Tag="workspaces"
                                ToolTipService.ToolTip="Workspaces"
                                AutomationProperties.Name="Workspaces">
                                <NavigationViewItem.Icon>
                                    <ImageIcon>
                                        <ImageIcon.Source>
                                            <SvgImageSource UriSource="ms-appx:///Assets/workspaces.svg" />
                                        </ImageIcon.Source>
                                    </ImageIcon>
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem
                                x:Name="RecentRailItem"
                                Content="Recent sessions"
                                Tag="recent"
                                ToolTipService.ToolTip="Recent sessions"
                                AutomationProperties.Name="Recent sessions">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE823;" FontSize="16" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem
                                x:Name="RecordingsRailItem"
                                Content="Recordings"
                                Tag="recordings"
                                ToolTipService.ToolTip="Recordings"
                                AutomationProperties.Name="Recordings">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE8B2;" FontSize="16" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                        </NavigationView.MenuItems>
                    </NavigationView>
                </Grid>
            </Border>

            <!-- Left pane: dedicated tree-filter chrome above the session tree. -->
            <Grid x:Name="SessionsPane" Grid.Column="1" RowDefinitions="Auto,Auto,*">
                <Grid
                    x:Name="FilterBar"
                    Height="44"
                    Grid.Row="0"
                    ColumnDefinitions="*,Auto,Auto"
                    Padding="8,7"
                    ColumnSpacing="6"
                    Background="{StaticResource SessionShellBrush}">
                    <Border
                        x:Name="FilterFieldBorder"
                        Grid.Column="0"
                        Height="30"
                        Background="{StaticResource SessionInputBrush}"
                        BorderBrush="{StaticResource SessionChromeFrameBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                        <Grid ColumnDefinitions="14,*" Padding="8,0,0,0">
                            <FontIcon
                                Grid.Column="0"
                                Glyph="&#xE71C;"
                                Width="14"
                                FontSize="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource SessionTreeMutedForegroundBrush}" />
                            <TextBox
                                x:Name="FilterBox"
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                Padding="0,0,30,0"
                                MinHeight="0"
                                VerticalAlignment="Center"
                                PlaceholderText="Filter sessions"
                                Foreground="{StaticResource SessionTreeForegroundBrush}"
                                PlaceholderForeground="{StaticResource SessionTreeMutedForegroundBrush}"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalContentAlignment="Center"
                                TextChanged="FilterBox_TextChanged"
                                KeyDown="FilterBox_KeyDown"
                                Loaded="FilterBox_Loaded"
                                GotFocus="FilterBox_GotFocus"
                                LostFocus="FilterBox_LostFocus">
                                <!-- The containing Border owns all filter-field chrome. Keep the
                                     TextBox template transparent in every interaction state.
                                     MinHeight must be cleared too: the default (32) exceeds this
                                     28px slot, so the box overflows. With MinHeight and Padding
                                     gone the box collapses to one line of text, and centring the
                                     box centres the text, which is the only thing that lines the
                                     placeholder up. The template hands VerticalContentAlignment
                                     to ContentElement but not to PlaceholderTextContentPresenter,
                                     so the placeholder is always drawn at the box's top edge. -->
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                </TextBox.Resources>
                            </TextBox>
                            <Button
                                x:Name="ClearFilterButton"
                                Grid.Column="1"
                                Width="30"
                                Height="28"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="ClearFilterButton_Click"
                                ToolTipService.ToolTip="Clear filter"
                                AutomationProperties.Name="Clear filter">
                                <FontIcon
                                    Glyph="&#xE711;"
                                    FontSize="10"
                                    Foreground="{StaticResource SessionTreeForegroundBrush}" />
                            </Button>
                        </Grid>
                    </Border>
                    <!-- Fluent UI System Icons (MIT): chevron_up_down / chevron_down_up, 16px
                         regular variants used at their native 16-unit scale. The 24px assets
                         would need downscaling, which thins their strokes below a pixel here. -->
                    <Button
                        x:Name="ExpandAllButton"
                        Grid.Column="1"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Background="{StaticResource SessionInputBrush}"
                        Click="ExpandAll_Click"
                        ToolTipService.ToolTip="Expand all"
                        AutomationProperties.Name="Expand all">
                        <PathIcon
                            Foreground="{StaticResource SessionTreeForegroundBrush}"
                            Data="M0.19527 4.40237C0.39053 4.59764 0.70711 4.59764 0.90237 4.40237L4.04882 1.25593L7.19522 4.40237C7.39052 4.59764 7.70712 4.59764 7.90242 4.40237C8.09762 4.20711 8.09762 3.89053 7.90242 3.69527L4.40237 0.19527C4.20711 0 3.89053 0 3.69527 0.19527L0.19527 3.69527C0 3.89053 0 4.20711 0.19527 4.40237ZM0.19527 7.69527C0.39053 7.5 0.70711 7.5 0.90237 7.69527L4.04882 10.84172L7.19522 7.69527C7.39052 7.5 7.70712 7.5 7.90242 7.69527C8.09762 7.89053 8.09762 8.20712 7.90242 8.40242L4.40237 11.90242C4.20711 12.09762 3.89053 12.09762 3.69527 11.90242L0.19527 8.40242C0 8.20712 0 7.89053 0.19527 7.69527Z" />
                    </Button>
                    <Button
                        x:Name="CollapseAllButton"
                        Grid.Column="2"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Background="{StaticResource SessionInputBrush}"
                        Click="CollapseAll_Click"
                        ToolTipService.ToolTip="Collapse all"
                        AutomationProperties.Name="Collapse all">
                        <PathIcon
                            Foreground="{StaticResource SessionTreeForegroundBrush}"
                            Data="M7.90242 0.90237L4.40237 4.40237C4.20711 4.59764 3.89053 4.59764 3.69527 4.40237L0.19527 0.90237C0 0.70711 0 0.39053 0.19527 0.19527C0.39053 0 0.70711 0 0.90237 0.19527L4.04882 3.34171L7.19522 0.19527C7.39052 0 7.70712 0 7.90242 0.19527C8.09762 0.39053 8.09762 0.70711 7.90242 0.90237ZM7.90242 10.19522L4.40237 6.69527C4.20711 6.5 3.89053 6.5 3.69527 6.69527L0.19527 10.19522C0 10.39052 0 10.70712 0.19527 10.90242C0.39053 11.09762 0.70711 11.09762 0.90237 10.90242L4.04882 7.75592L7.19522 10.90242C7.39052 11.09762 7.70712 11.09762 7.90242 10.90242C8.09762 10.70712 8.09762 10.39052 7.90242 10.19522Z" />
                    </Button>
                </Grid>

                <TextBlock
                    Grid.Row="1"
                    Margin="12,6,12,4"
                    FontSize="11"
                    Foreground="{StaticResource SessionTreeMutedForegroundBrush}"
                    Visibility="{x:Bind ViewModel.IsFiltering, Mode=OneWay}"
                    Text="{x:Bind ViewModel.MatchSummary, Mode=OneWay}" />

                <TreeView
                    x:Name="SessionTree"
                    Grid.Row="2"
                    Foreground="{StaticResource SessionTreeForegroundBrush}"
                    ItemsSource="{x:Bind ViewModel.RootNodes}"
                    ItemTemplateSelector="{StaticResource TreeNodeTemplateSelector}"
                    SelectionMode="None"
                    CanDragItems="True"
                    CanReorderItems="True"
                    AllowDrop="True"
                    DragItemsStarting="SessionTree_DragItemsStarting"
                    DragItemsCompleted="SessionTree_DragItemsCompleted"
                    Expanding="SessionTree_Expanding"
                    Collapsed="SessionTree_Collapsed">
                    <TreeView.Resources>
                        <!-- Keep tree rows tight: content sets the height with no vertical gap between presenters. -->
                        <x:Double x:Key="TreeViewItemMinHeight">20</x:Double>
                        <Thickness x:Key="TreeViewItemPresenterMargin">4,0</Thickness>
                        <Thickness x:Key="TreeViewItemPresenterPadding">0</Thickness>
                    </TreeView.Resources>
                    <TreeView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="New SSH Session…" Click="NewSession_Click" />
                            <MenuFlyoutItem Text="New Local Profile…" Click="NewLocalProfile_Click" />
                            <MenuFlyoutItem Text="New Folder…" Click="NewFolder_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Expand All" Click="ExpandAll_Click" />
                            <MenuFlyoutItem Text="Collapse All" Click="CollapseAll_Click" />
                        </MenuFlyout>
                    </TreeView.ContextFlyout>
                </TreeView>

                <TextBlock
                    x:Name="NoFilterMatchesState"
                    Grid.Row="2"
                    Margin="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource SessionTreeMutedForegroundBrush}"
                    Text="No sessions match this filter."
                    Visibility="Collapsed" />

                <!-- First-run empty state -->
                <StackPanel
                    x:Name="EmptyState"
                    Grid.Row="2"
                    Margin="16"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="Collapsed">
                    <FontIcon
                        Glyph="&#xE8B7;"
                        FontSize="36"
                        Opacity="0.4"
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource SessionTreeForegroundBrush}" />
                    <TextBlock
                        Text="No sessions yet"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Foreground="{StaticResource SessionTreeForegroundBrush}"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="Create a session with the + button, or bring your existing sessions across with Import — it reads your SecureCRT configuration directly."
                        TextWrapping="Wrap"
                        Opacity="0.7"
                        Foreground="{StaticResource SessionTreeMutedForegroundBrush}"
                        TextAlignment="Center" />
                    <Button Content="Import from SecureCRT…" Click="Import_Click" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid
                x:Name="WorkspacesPane"
                Grid.Column="1"
                RowDefinitions="Auto,*"
                Visibility="Collapsed">
                <Grid
                    Grid.Row="0"
                    Height="44"
                    ColumnDefinitions="*,Auto"
                    Padding="12,7,6,7"
                    Background="{StaticResource SessionShellBrush}">
                    <TextBlock
                        Text="Workspaces"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SessionTreeForegroundBrush}" />
                    <Button
                        Grid.Column="1"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="SaveWorkspace_Click"
                        ToolTipService.ToolTip="Save current layout as a workspace"
                        AutomationProperties.Name="Save current layout as a workspace">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                    </Button>
                </Grid>
                <ListView
                    x:Name="WorkspaceList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind Workspaces}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    CanDragItems="True"
                    CanReorderItems="True"
                    AllowDrop="True"
                    ItemClick="WorkspaceList_ItemClick"
                    DragItemsCompleted="WorkspaceList_DragItemsCompleted">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="8" Padding="4,5">
                                <controls:WorkspaceLayoutIcon
                                    Layout="{Binding Layout}"
                                    Stroke="{StaticResource SessionTreeForegroundBrush}"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{StaticResource SessionTreeForegroundBrush}" />
                                    <TextBlock
                                        Text="{Binding LayoutSummary}"
                                        FontSize="11"
                                        Foreground="{StaticResource SessionTreeMutedForegroundBrush}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="2"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="Workspace actions"
                                    AutomationProperties.Name="Workspace actions">
                                    <FontIcon Glyph="&#xE712;" FontSize="13" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Text="Open"
                                                CommandParameter="{Binding}"
                                                Click="OpenWorkspaceMenu_Click" />
                                            <MenuFlyoutItem
                                                Text="Open in new window"
                                                CommandParameter="{Binding}"
                                                Click="OpenWorkspaceInNewWindowMenu_Click" />
                                            <MenuFlyoutItem
                                                Text="Open additively"
                                                CommandParameter="{Binding}"
                                                Click="OpenWorkspaceAdditivelyMenu_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem
                                                Text="Update from current layout…"
                                                CommandParameter="{Binding}"
                                                Click="UpdateWorkspaceMenu_Click" />
                                            <MenuFlyoutItem
                                                Text="Rename…"
                                                CommandParameter="{Binding}"
                                                Click="RenameWorkspaceMenu_Click" />
                                            <MenuFlyoutItem
                                                Text="Delete…"
                                                CommandParameter="{Binding}"
                                                Click="DeleteWorkspaceMenu_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    x:Name="NoWorkspacesState"
                    Grid.Row="1"
                    Margin="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="Save the current layout to add a workspace."
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Foreground="{StaticResource SessionTreeMutedForegroundBrush}" />
            </Grid>

            <Grid
                x:Name="RecentPane"
                Grid.Column="1"
                RowDefinitions="Auto,*"
                Visibility="Collapsed">
                <Border
                    Grid.Row="0"
                    Height="44"
                    Padding="12,0"
                    Background="{StaticResource SessionShellBrush}">
                    <TextBlock
                        Text="Recent sessions"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SessionTreeForegroundBrush}" />
                </Border>
                <ListView
                    x:Name="RecentSessionList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind RecentSessions}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="RecentSessionList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="3,20,*" ColumnSpacing="8" Padding="4,5">
                                <Rectangle Grid.Column="0" RadiusX="1.5" RadiusY="1.5">
                                    <Rectangle.Fill>
                                        <SolidColorBrush Color="{Binding TagColor}" />
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Grid Grid.Column="1">
                                    <Image
                                        Source="{Binding IconSource}"
                                        Width="16"
                                        Height="16"
                                        Visibility="{Binding IconVisibility}" />
                                    <FontIcon
                                        Glyph="&#xEDA2;"
                                        FontSize="14"
                                        Foreground="{StaticResource SessionTreeForegroundBrush}"
                                        Visibility="{Binding DefaultIconVisibility}" />
                                </Grid>
                                <StackPanel Grid.Column="2">
                                    <TextBlock
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{StaticResource SessionTreeForegroundBrush}" />
                                    <TextBlock
                                        Text="{Binding HostSummary}"
                                        FontSize="11"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{StaticResource SessionTreeMutedForegroundBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    x:Name="NoRecentSessionsState"
                    Grid.Row="1"
                    Margin="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="Open a saved session to add it here."
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Foreground="{StaticResource SessionTreeMutedForegroundBrush}" />
            </Grid>

            <Grid
                x:Name="RecordingsPane"
                Grid.Column="1"
                RowDefinitions="Auto,*,Auto"
                Visibility="Collapsed">
                <Grid
                    Height="44"
                    Grid.Row="0"
                    ColumnDefinitions="*,Auto,Auto"
                    Padding="12,7,6,7"
                    Background="{StaticResource SessionShellBrush}">
                    <TextBlock
                        Text="Recordings"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SessionTreeForegroundBrush}" />
                    <Button
                        Grid.Column="1"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="RefreshRecordings_Click"
                        ToolTipService.ToolTip="Refresh recordings"
                        AutomationProperties.Name="Refresh recordings">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OpenRecordingsFolder_Click"
                        ToolTipService.ToolTip="Open recordings folder"
                        AutomationProperties.Name="Open recordings folder">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                    </Button>
                </Grid>
                <ListView
                    x:Name="RecordingList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind Recordings}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="RecordingList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="20,*" ColumnSpacing="8" Padding="4,5">
                                <FontIcon
                                    Glyph="&#xE8B2;"
                                    FontSize="14"
                                    Foreground="{StaticResource SessionTreeForegroundBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{StaticResource SessionTreeForegroundBrush}" />
                                    <TextBlock
                                        Text="{Binding Detail}"
                                        FontSize="11"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{StaticResource SessionTreeMutedForegroundBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    x:Name="NoRecordingsState"
                    Grid.Row="1"
                    Margin="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="No recordings found in the configured folder."
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Foreground="{StaticResource SessionTreeMutedForegroundBrush}" />
                <Button
                    Grid.Row="2"
                    Margin="8"
                    HorizontalAlignment="Stretch"
                    Content="Open recording…"
                    Click="OpenRecording_Click" />
            </Grid>

            <Border
                x:Name="TreeSplitterLine"
                Grid.Column="2"
                Width="1"
                HorizontalAlignment="Center"
                Background="{ThemeResource SessionDividerBrush}"
                IsHitTestVisible="False" />

            <toolkit:GridSplitter
                x:Name="TreeSplitter"
                Grid.Column="2"
                Width="7"
                Canvas.ZIndex="1"
                HorizontalAlignment="Center"
                Background="Transparent"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Columns"
                ManipulationCompleted="TreeSplitter_ManipulationCompleted" />

            <!-- Recursive tab-group layout. Code builds equal row/column siblings and
                 inserts a GridSplitter between each pair. -->
            <Grid x:Name="GroupArea" Grid.Column="3" />
        </Grid>

        <!-- Status bar -->
        <Border
            x:Name="StatusBar"
            Grid.Row="2"
            Padding="12,6"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{StaticResource SessionChromeFrameBrush}"
            BorderThickness="0,1,0,0">
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12" Opacity="0.8" />
        </Border>

        <controls:CommandPaletteView
            x:Name="CommandPalette"
            Grid.RowSpan="3"
            Canvas.ZIndex="1000" />
    </Grid>
</Window>
