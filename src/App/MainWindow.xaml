<Window
    x:Class="Sessions.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sessions.App"
    xmlns:vm="using:Sessions.App.ViewModels"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Title="Sessions">

    <Grid
        x:Name="Root"
        KeyboardAcceleratorPlacementMode="Hidden"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <DataTemplate x:Key="FolderTemplate" x:DataType="vm:TreeNodeViewModel">
                <TreeViewItem
                    ItemsSource="{x:Bind Children}"
                    IsExpanded="{x:Bind IsExpanded, Mode=OneWay}"
                    AllowDrop="True"
                    Background="{x:Bind SelectionBackground, Mode=OneWay}"
                    Tapped="TreeNode_Tapped"
                    ContextRequested="TreeNode_ContextRequested">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        <TextBlock Text="{x:Bind Name}" />
                    </StackPanel>
                </TreeViewItem>
            </DataTemplate>

            <DataTemplate x:Key="SessionTemplate" x:DataType="vm:TreeNodeViewModel">
                <TreeViewItem
                    ItemsSource="{x:Bind Children}"
                    Background="{x:Bind SelectionBackground, Mode=OneWay}"
                    Tapped="TreeNode_Tapped"
                    ContextRequested="TreeNode_ContextRequested"
                    DoubleTapped="SessionNode_DoubleTapped">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5">
                            <Rectangle.Fill>
                                <SolidColorBrush Color="{x:Bind TagColor}" />
                            </Rectangle.Fill>
                        </Rectangle>
                        <Image
                            Source="{x:Bind IconSource}"
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind IconVisibility}" />
                        <FontIcon Glyph="&#xE756;" FontSize="14" Visibility="{x:Bind DefaultIconVisibility}" />
                        <TextBlock Text="{x:Bind Name}" />
                        <TextBlock
                            Text="{x:Bind HostSummary}"
                            Opacity="0.55"
                            FontSize="12"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </TreeViewItem>
            </DataTemplate>

            <!-- The permanent virtual Local root: terminal glyph, no drag, no rename/delete. -->
            <DataTemplate x:Key="LocalRootTemplate" x:DataType="vm:TreeNodeViewModel">
                <TreeViewItem
                    ItemsSource="{x:Bind Children}"
                    IsExpanded="{x:Bind IsExpanded, Mode=OneWay}"
                    AllowDrop="True"
                    Background="{x:Bind SelectionBackground, Mode=OneWay}"
                    Tapped="TreeNode_Tapped"
                    ContextRequested="TreeNode_ContextRequested">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7F8;" FontSize="14" />
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                    </StackPanel>
                </TreeViewItem>
            </DataTemplate>

            <local:TreeNodeTemplateSelector
                x:Key="TreeNodeTemplateSelector"
                FolderTemplate="{StaticResource FolderTemplate}"
                SessionTemplate="{StaticResource SessionTemplate}"
                LocalRootTemplate="{StaticResource LocalRootTemplate}" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: menus + centered quick connect + window controls in one row.
             The whole strip is a system drag region; interactive controls are carved out
             via InputNonClientPointerSource passthrough rects (see UpdateTitleBarRegions). -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftPadding" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TitleBarRightPadding" Width="0" />
            </Grid.ColumnDefinitions>

            <Image
                x:Name="TitleBarIcon"
                Grid.Column="1"
                Width="16"
                Height="16"
                Margin="14,0,6,0"
                VerticalAlignment="Center" />

            <MenuBar x:Name="TitleBarMenus" Grid.Column="2" VerticalAlignment="Center">
                <MenuBarItem Title="File">
                    <MenuFlyoutItem Text="New SSH Session…" Click="NewSession_Click" />
                    <MenuFlyoutItem Text="New Local Profile…" Click="NewLocalProfile_Click" />
                    <MenuFlyoutItem Text="New Folder…" Click="NewFolder_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Import from SecureCRT…" Click="Import_Click" />
                    <MenuFlyoutItem Text="Export backup…" Click="ExportBackup_Click" />
                    <MenuFlyoutItem Text="Import backup…" Click="ImportBackup_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Settings…" Click="Settings_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit" Click="Exit_Click" />
                </MenuBarItem>
                <MenuBarItem Title="View">
                    <MenuFlyoutItem Text="Expand All" Click="ExpandAll_Click" />
                    <MenuFlyoutItem Text="Collapse All" Click="CollapseAll_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Text="Split Right"
                        Click="SplitRightMenu_Click"
                        KeyboardAcceleratorTextOverride="Ctrl+Shift+\" />
                    <MenuFlyoutItem Text="Split Down" Click="SplitDownMenu_Click" />
                    <MenuFlyoutItem
                        Text="File Pane"
                        Click="FilePaneMenu_Click"
                        KeyboardAcceleratorTextOverride="Ctrl+Shift+E" />
                </MenuBarItem>
                <MenuBarItem Title="Session">
                    <MenuFlyoutItem x:Name="ReconnectMenuItem" Text="Reconnect" Click="ReconnectMenu_Click" />
                    <MenuFlyoutItem x:Name="DisconnectMenuItem" Text="Disconnect" Click="DisconnectMenu_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Clone" Click="CloneMenu_Click" />
                    <MenuFlyoutItem Text="Pin Tab" Click="PinTabMenu_Click" />
                    <MenuFlyoutItem Text="Session Options…" Click="SessionOptionsMenu_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="EndRemoteMenuItem" Text="End Remote Session…" Click="EndRemoteMenu_Click" />
                    <MenuFlyoutItem
                        Text="Close Tab"
                        Click="CloseTabMenu_Click"
                        KeyboardAcceleratorTextOverride="Ctrl+F4" />
                </MenuBarItem>
            </MenuBar>

            <Grid
                x:Name="QuickConnectHost"
                Grid.Column="3"
                MaxWidth="560"
                Margin="24,0"
                VerticalAlignment="Center">
                <AutoSuggestBox
                    x:Name="QuickConnectBox"
                    PlaceholderText="ssh user@host or search sessions…"
                    TextChanged="QuickConnect_TextChanged"
                    QuerySubmitted="QuickConnect_QuerySubmitted"
                    GotFocus="QuickConnect_FocusChanged"
                    LostFocus="QuickConnect_FocusChanged"
                    KeyDown="QuickConnect_KeyDown">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="local:QuickConnectSuggestion">
                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,4">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind Display}" VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Bind Detail}"
                                    Opacity="0.55"
                                    FontSize="12"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
                <Border
                    x:Name="QuickConnectHint"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Padding="6,1,6,2"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    IsHitTestVisible="False">
                    <TextBlock Text="Ctrl+K" FontSize="11" Opacity="0.6" />
                </Border>
            </Grid>

            <StackPanel
                x:Name="TitleBarButtons"
                Grid.Column="4"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center"
                Margin="0,0,8,0">
                <!-- Split button: primary click opens the default local profile; the menu
                     lists local profiles plus the two "new" entries (populated on opening). -->
                <SplitButton
                    x:Name="NewSessionButton"
                    Click="NewSessionButton_Click"
                    ToolTipService.ToolTip="Open the default local terminal (Ctrl+Shift+T)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Session" />
                    </StackPanel>
                    <SplitButton.Flyout>
                        <MenuFlyout x:Name="NewSessionFlyout" Opening="NewSessionFlyout_Opening" />
                    </SplitButton.Flyout>
                </SplitButton>
                <ToggleButton
                    x:Name="PinButton"
                    Click="PinButton_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Keep window on top">
                    <FontIcon Glyph="&#xE718;" FontSize="14" />
                </ToggleButton>
                <Button
                    Click="Settings_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main area: tree | splitter | tabs -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="280" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Left pane: filter on top, session tree below -->
            <Grid Grid.Column="0" Margin="4,0,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBox
                    x:Name="FilterBox"
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    PlaceholderText="Filter sessions"
                    TextChanged="FilterBox_TextChanged"
                    KeyDown="FilterBox_KeyDown" />

                <TreeView
                    x:Name="SessionTree"
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.RootNodes}"
                    ItemTemplateSelector="{StaticResource TreeNodeTemplateSelector}"
                    SelectionMode="None"
                    CanDragItems="True"
                    CanReorderItems="True"
                    AllowDrop="True"
                    DragItemsStarting="SessionTree_DragItemsStarting"
                    DragItemsCompleted="SessionTree_DragItemsCompleted"
                    Expanding="SessionTree_Expanding"
                    Collapsed="SessionTree_Collapsed">
                    <TreeView.Resources>
                        <!-- Row height is content (20) + presenter padding + margin; MinHeight alone never binds. -->
                        <x:Double x:Key="TreeViewItemMinHeight">20</x:Double>
                        <Thickness x:Key="TreeViewItemPresenterMargin">4,1</Thickness>
                        <Thickness x:Key="TreeViewItemPresenterPadding">0</Thickness>
                    </TreeView.Resources>
                    <TreeView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="New SSH Session…" Click="NewSession_Click" />
                            <MenuFlyoutItem Text="New Local Profile…" Click="NewLocalProfile_Click" />
                            <MenuFlyoutItem Text="New Folder…" Click="NewFolder_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Expand All" Click="ExpandAll_Click" />
                            <MenuFlyoutItem Text="Collapse All" Click="CollapseAll_Click" />
                        </MenuFlyout>
                    </TreeView.ContextFlyout>
                </TreeView>

                <!-- First-run empty state -->
                <StackPanel
                    x:Name="EmptyState"
                    Grid.Row="1"
                    Margin="16"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="Collapsed">
                    <FontIcon Glyph="&#xE8B7;" FontSize="36" Opacity="0.4" HorizontalAlignment="Center" />
                    <TextBlock
                        Text="No sessions yet"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="Create a session with the + button, or bring your existing sessions across with Import — it reads your SecureCRT configuration directly."
                        TextWrapping="Wrap"
                        Opacity="0.7"
                        TextAlignment="Center" />
                    <Button Content="Import from SecureCRT…" Click="Import_Click" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <toolkit:GridSplitter
                x:Name="TreeSplitter"
                Grid.Column="1"
                Width="8"
                ResizeBehavior="BasedOnAlignment"
                ManipulationCompleted="TreeSplitter_ManipulationCompleted" />

            <!-- Recursive tab-group layout. Code builds equal row/column siblings and
                 inserts a GridSplitter between each pair. -->
            <Grid x:Name="GroupArea" Grid.Column="2" Margin="0,0,4,4" />
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="2" Padding="12,6" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12" Opacity="0.8" />
        </Grid>
    </Grid>
</Window>
