<Window
    x:Class="Sessions.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sessions.App"
    xmlns:vm="using:Sessions.App.ViewModels"
    xmlns:models="using:Sessions.Core.Models"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Title="Sessions">

    <Grid
        x:Name="Root"
        KeyboardAcceleratorPlacementMode="Hidden"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <DataTemplate x:Key="FolderTemplate" x:DataType="vm:TreeNodeViewModel">
                <TreeViewItem
                    ItemsSource="{x:Bind Children}"
                    IsExpanded="{x:Bind IsExpanded, Mode=OneWay}"
                    AllowDrop="True">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        <TextBlock Text="{x:Bind Name}" />
                    </StackPanel>
                    <TreeViewItem.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="New Session…" Click="FolderNewSession_Click" />
                            <MenuFlyoutItem Text="New Folder…" Click="FolderNewFolder_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Rename…" Click="FolderRename_Click" />
                            <MenuFlyoutItem Text="Delete" Click="FolderDelete_Click" />
                        </MenuFlyout>
                    </TreeViewItem.ContextFlyout>
                </TreeViewItem>
            </DataTemplate>

            <DataTemplate x:Key="SessionTemplate" x:DataType="vm:TreeNodeViewModel">
                <TreeViewItem
                    ItemsSource="{x:Bind Children}"
                    DoubleTapped="SessionNode_DoubleTapped">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5">
                            <Rectangle.Fill>
                                <SolidColorBrush Color="{x:Bind TagColor}" />
                            </Rectangle.Fill>
                        </Rectangle>
                        <FontIcon Glyph="&#xE756;" FontSize="14" />
                        <TextBlock Text="{x:Bind Name}" />
                        <TextBlock
                            Text="{x:Bind HostSummary}"
                            Opacity="0.55"
                            FontSize="12"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TreeViewItem.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Connect" Click="SessionConnect_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Edit…" Click="SessionEdit_Click" />
                            <MenuFlyoutItem Text="Delete" Click="SessionDelete_Click" />
                        </MenuFlyout>
                    </TreeViewItem.ContextFlyout>
                </TreeViewItem>
            </DataTemplate>

            <local:TreeNodeTemplateSelector
                x:Key="TreeNodeTemplateSelector"
                FolderTemplate="{StaticResource FolderTemplate}"
                SessionTemplate="{StaticResource SessionTemplate}" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar: search + quick actions -->
        <Grid Grid.Row="0" Padding="8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="0"
                PlaceholderText="Search sessions — name, host, user, folder, notes"
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged"
                QuerySubmitted="SearchBox_QuerySubmitted">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Session">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Name}" />
                            <TextBlock Text="{x:Bind Host}" Opacity="0.55" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>

            <Button Grid.Column="1" Click="NewSession_Click" ToolTipService.ToolTip="New session">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Session" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Click="NewFolder_Click" ToolTipService.ToolTip="New folder">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                    <TextBlock Text="Folder" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Click="Import_Click" ToolTipService.ToolTip="Import sessions from SecureCRT">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                    <TextBlock Text="Import" />
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Click="Settings_Click" ToolTipService.ToolTip="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Main area: tree | tabs -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TreeView
                x:Name="SessionTree"
                Grid.Column="0"
                Margin="4,0,0,4"
                ItemsSource="{x:Bind ViewModel.RootNodes}"
                ItemTemplateSelector="{StaticResource TreeNodeTemplateSelector}"
                SelectionMode="Single"
                CanDragItems="True"
                CanReorderItems="True"
                AllowDrop="True"
                DragItemsStarting="SessionTree_DragItemsStarting"
                DragItemsCompleted="SessionTree_DragItemsCompleted"
                Expanding="SessionTree_Expanding"
                Collapsed="SessionTree_Collapsed">
                <TreeView.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="New Session…" Click="NewSession_Click" />
                        <MenuFlyoutItem Text="New Folder…" Click="NewFolder_Click" />
                    </MenuFlyout>
                </TreeView.ContextFlyout>
            </TreeView>

            <!-- First-run empty state -->
            <StackPanel
                x:Name="EmptyState"
                Grid.Column="0"
                Margin="16"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed">
                <FontIcon Glyph="&#xE8B7;" FontSize="36" Opacity="0.4" HorizontalAlignment="Center" />
                <TextBlock
                    Text="No sessions yet"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="Create a session with the + button, or bring your existing sessions across with Import — it reads your SecureCRT configuration directly."
                    TextWrapping="Wrap"
                    Opacity="0.7"
                    TextAlignment="Center" />
                <Button Content="Import from SecureCRT…" Click="Import_Click" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Tab group area: up to two side-by-side groups; group views are created in code. -->
            <Grid x:Name="GroupArea" Grid.Column="1" Margin="0,0,4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftGroupColumn" Width="*" />
                    <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                    <ColumnDefinition x:Name="RightGroupColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <toolkit:GridSplitter
                    x:Name="Splitter"
                    Grid.Column="1"
                    Width="8"
                    Visibility="Collapsed"
                    ResizeBehavior="BasedOnAlignment"
                    ManipulationCompleted="Splitter_ManipulationCompleted" />
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="2" Padding="12,6" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12" Opacity="0.8" />
        </Grid>
    </Grid>
</Window>
