<UserControl
    x:Class="Resesh.App.Controls.HighlightRulesEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Resesh.App.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <FontFamily x:Key="CodeFont">Cascadia Mono, Consolas</FontFamily>
        <Style x:Key="GroupHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="1,20,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ==== Rules, with a standing preview of every enabled rule ==== -->
        <StackPanel x:Name="ListPanel" Spacing="4">
            <TextBlock Text="Highlighting rules" Style="{StaticResource GroupHeader}" Margin="1,4,0,4" />
            <ListView
                x:Name="RuleList"
                SelectionMode="Single"
                ItemsSource="{x:Bind Rules}"
                AutomationProperties.Name="Highlighting rules"
                AutomationProperties.AutomationId="SettingsHighlightRules"
                SelectionChanged="RuleList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:HighlightRuleItem">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox
                                MinWidth="32"
                                VerticalAlignment="Center"
                                IsChecked="{x:Bind Enabled, Mode=TwoWay}"
                                AutomationProperties.Name="{x:Bind Name}"
                                AutomationProperties.AutomationId="{x:Bind EnabledAutomationId}" />
                            <Border Width="14" Height="14" CornerRadius="2" VerticalAlignment="Center" Background="{x:Bind SwatchBrush}" />
                            <TextBlock MinWidth="190" VerticalAlignment="Center" Text="{x:Bind Name}" FontWeight="{x:Bind NameWeight}" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind PackTag}" FontSize="12" Opacity="0.6" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                <Button x:Name="AddButton" Content="Add custom rule" AutomationProperties.AutomationId="SettingsHighlightAdd" Click="Add_Click" />
                <Button x:Name="EditButton" Content="Edit" IsEnabled="False" AutomationProperties.AutomationId="SettingsHighlightEdit" Click="Edit_Click" />
                <Button x:Name="DeleteButton" Content="Delete" IsEnabled="False" AutomationProperties.AutomationId="SettingsHighlightDelete" Click="Delete_Click" />
            </StackPanel>

            <!-- Paste a line from your own terminal to see how the current rules treat it.
                 Overlaps resolve as in the terminal: the later rule wins. -->
            <TextBlock Text="Preview" Style="{StaticResource GroupHeader}" />
            <toolkit:SettingsCard Header="Sample text">
                <TextBox
                    x:Name="ListSampleBox"
                    MinWidth="360"
                    AcceptsReturn="False"
                    AutomationProperties.Name="Sample text"
                    AutomationProperties.AutomationId="SettingsHighlightListSample"
                    TextChanged="ListSample_TextChanged" />
            </toolkit:SettingsCard>
            <Border Style="{StaticResource PreviewSurfaceStyle}">
                <TextBlock x:Name="CombinedPreview" FontFamily="{StaticResource CodeFont}" FontSize="13" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- ==== Add or edit one rule, in place of the list ==== -->
        <StackPanel x:Name="FormPanel" Spacing="4" Visibility="Collapsed">
            <TextBlock Text="Rule" Style="{StaticResource GroupHeader}" Margin="1,4,0,4" />
            <toolkit:SettingsCard Header="Name">
                <TextBox
                    x:Name="NameBox"
                    MinWidth="320"
                    PlaceholderText="e.g. Customer VRF names"
                    AutomationProperties.Name="Name"
                    AutomationProperties.AutomationId="SettingsHighlightName" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Regular expression (applied per line)">
                <TextBox
                    x:Name="PatternBox"
                    MinWidth="320"
                    PlaceholderText="\bVRF-[A-Z]+\b"
                    FontFamily="{StaticResource CodeFont}"
                    AutomationProperties.Name="Regular expression"
                    AutomationProperties.AutomationId="SettingsHighlightPattern"
                    TextChanged="FormField_TextChanged" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Match case">
                <ToggleSwitch
                    x:Name="MatchCaseSwitch"
                    AutomationProperties.Name="Match case"
                    AutomationProperties.AutomationId="SettingsHighlightMatchCase"
                    Toggled="FormField_Toggled" />
            </toolkit:SettingsCard>

            <TextBlock Text="Appearance" Style="{StaticResource GroupHeader}" />
            <toolkit:SettingsCard Header="Color (#RRGGBB)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox
                        x:Name="ColorBox"
                        MinWidth="160"
                        AutomationProperties.Name="Color"
                        AutomationProperties.AutomationId="SettingsHighlightColor"
                        TextChanged="FormField_TextChanged" />
                    <Border x:Name="Swatch" Width="20" Height="20" CornerRadius="3" VerticalAlignment="Center" />
                </StackPanel>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Bold (renders as a background tint)">
                <ToggleSwitch
                    x:Name="BoldSwitch"
                    AutomationProperties.Name="Bold"
                    AutomationProperties.AutomationId="SettingsHighlightBold"
                    Toggled="FormField_Toggled" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Underline">
                <ToggleSwitch
                    x:Name="UnderlineSwitch"
                    AutomationProperties.Name="Underline"
                    AutomationProperties.AutomationId="SettingsHighlightUnderline"
                    Toggled="FormField_Toggled" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Mark hits in the scrollbar overview">
                <ToggleSwitch
                    x:Name="OverviewSwitch"
                    AutomationProperties.Name="Mark hits in the scrollbar overview"
                    AutomationProperties.AutomationId="SettingsHighlightOverview" />
            </toolkit:SettingsCard>

            <TextBlock Text="Preview" Style="{StaticResource GroupHeader}" />
            <toolkit:SettingsCard Header="Sample text">
                <TextBox
                    x:Name="FormSampleBox"
                    MinWidth="360"
                    AcceptsReturn="False"
                    AutomationProperties.Name="Sample text"
                    AutomationProperties.AutomationId="SettingsHighlightFormSample"
                    TextChanged="FormSample_TextChanged" />
            </toolkit:SettingsCard>
            <Border Style="{StaticResource PreviewSurfaceStyle}">
                <TextBlock x:Name="FormPreview" FontFamily="{StaticResource CodeFont}" TextWrapping="Wrap" />
            </Border>

            <TextBlock x:Name="FormStatus" Margin="1,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />

            <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                <Button
                    Content="Save rule"
                    Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.AutomationId="SettingsHighlightSave"
                    Click="SaveRule_Click" />
                <Button Content="Cancel" AutomationProperties.AutomationId="SettingsHighlightCancel" Click="CancelRule_Click" />
                <Button
                    x:Name="ResetButton"
                    Margin="16,0,0,0"
                    Content="Reset to default"
                    AutomationProperties.AutomationId="SettingsHighlightReset"
                    Click="ResetRule_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
