<UserControl
    x:Class="Resesh.App.Controls.FontFamilyPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Resesh.App.Controls">

    <!-- Editable, so a fallback list ("Cascadia Mono, Consolas") or a font missing from the
         list can still be typed. Each entry is drawn in its own font. -->
    <ComboBox
        x:Name="Box"
        IsEditable="True"
        HorizontalAlignment="Stretch"
        MaxDropDownHeight="360">
        <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
                <TextBlock Text="{x:Bind}" controls:FontFamilyPicker.PreviewFamily="{x:Bind}" />
            </DataTemplate>
        </ComboBox.ItemTemplate>
    </ComboBox>
</UserControl>
