<UserControl
    x:Class="Resesh.App.Controls.ThemeSwatch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A small terminal in the theme's colors: the cursor and "Aa", a prompt, log lines in
         its ANSI colors, then the eight normal ANSI colors. Code-behind colors it. The colors
         are one shape, a dot per color, filled by a gradient with a hard stop at each dot's
         edges: a card is built and torn down for every theme scrolled past, and eight
         ellipses cost a fifth of it. -->
    <StackPanel Width="296" Spacing="7">
        <Border x:Name="SelectionFrame" BorderThickness="2" CornerRadius="9" Padding="2" BorderBrush="Transparent">
            <StackPanel x:Name="Preview" Padding="12,10" CornerRadius="5" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border x:Name="Cursor" Width="4" Height="26" VerticalAlignment="Center" />
                    <TextBlock x:Name="Sample" Text="Aa" FontFamily="Cascadia Mono, Consolas" FontSize="26" />
                </StackPanel>
                <StackPanel x:Name="Lines" Spacing="1" />
                <Path x:Name="Dots" Width="161" Height="14" HorizontalAlignment="Left" Margin="0,2,0,0" StrokeThickness="1">
                    <Path.Data>
                        <GeometryGroup>
                            <EllipseGeometry Center="7,7" RadiusX="6.5" RadiusY="6.5" />
                            <EllipseGeometry Center="28,7" RadiusX="6.5" RadiusY="6.5" />
                            <EllipseGeometry Center="49,7" RadiusX="6.5" RadiusY="6.5" />
                            <EllipseGeometry Center="70,7" RadiusX="6.5" RadiusY="6.5" />
                            <EllipseGeometry Center="91,7" RadiusX="6.5" RadiusY="6.5" />
                            <EllipseGeometry Center="112,7" RadiusX="6.5" RadiusY="6.5" />
                            <EllipseGeometry Center="133,7" RadiusX="6.5" RadiusY="6.5" />
                            <EllipseGeometry Center="154,7" RadiusX="6.5" RadiusY="6.5" />
                        </GeometryGroup>
                    </Path.Data>
                </Path>
            </StackPanel>
        </Border>
        <TextBlock x:Name="ThemeName" Margin="5,0" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SessionTreeForegroundBrush}" />
    </StackPanel>
</UserControl>
