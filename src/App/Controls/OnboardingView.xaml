<UserControl
    x:Class="Resesh.App.Controls.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="FinishSetup_Invoked" />
    </UserControl.KeyboardAccelerators>

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- These semantic brushes are local to Welcome. The code-behind updates
                 them from the active app palette and enforces contrast for custom themes. -->
            <SolidColorBrush x:Key="OnboardingPrimaryTextBrush" Color="#CCCCCC" />
            <SolidColorBrush x:Key="OnboardingSecondaryTextBrush" Color="#959595" />
            <SolidColorBrush x:Key="OnboardingAccentTextBrush" Color="#4CC2FF" />
            <SolidColorBrush x:Key="OnboardingAccentForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="OnboardingPreviewBackgroundBrush" Color="#181818" />
            <SolidColorBrush x:Key="OnboardingPreviewHeaderBrush" Color="#121212" />
            <SolidColorBrush x:Key="OnboardingPreviewBorderBrush" Color="#5A5A5A" />
            <SolidColorBrush x:Key="OnboardingPreviewTextBrush" Color="#CCCCCC" />

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="OnboardingHoverBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="OnboardingPressedBrush" Color="#2AFFFFFF" />
                    <StaticResource x:Key="ButtonBackground" ResourceKey="SessionShellBrush" />
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="OnboardingHoverBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="OnboardingPressedBrush" />
                    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SessionShellBrush" />
                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SessionChromeFrameBrush" />
                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SessionChromeFrameBrush" />
                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SessionChromeFrameBrush" />
                    <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SessionChromeFrameBrush" />
                    <StaticResource x:Key="ButtonForeground" ResourceKey="OnboardingPrimaryTextBrush" />
                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="OnboardingPrimaryTextBrush" />
                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="OnboardingPrimaryTextBrush" />
                    <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="OnboardingSecondaryTextBrush" />
                    <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SessionShellBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SessionAccentBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SessionAccentBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SessionAccentBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="OnboardingAccentForegroundBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="OnboardingAccentForegroundBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="OnboardingAccentForegroundBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="OnboardingHoverBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="OnboardingPressedBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SessionChromeFrameBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="SessionChromeFrameBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SessionChromeFrameBrush" />
                    <StaticResource x:Key="ToggleButtonForeground" ResourceKey="OnboardingPrimaryTextBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="OnboardingPrimaryTextBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="OnboardingPrimaryTextBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="OnboardingHoverBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="OnboardingPressedBrush" Color="#22000000" />
                    <StaticResource x:Key="ButtonBackground" ResourceKey="SessionShellBrush" />
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="OnboardingHoverBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="OnboardingPressedBrush" />
                    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SessionShellBrush" />
                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SessionChromeFrameBrush" />
                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SessionChromeFrameBrush" />
                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SessionChromeFrameBrush" />
                    <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SessionChromeFrameBrush" />
                    <StaticResource x:Key="ButtonForeground" ResourceKey="OnboardingPrimaryTextBrush" />
                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="OnboardingPrimaryTextBrush" />
                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="OnboardingPrimaryTextBrush" />
                    <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="OnboardingSecondaryTextBrush" />
                    <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SessionShellBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SessionAccentBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SessionAccentBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SessionAccentBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="OnboardingAccentForegroundBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="OnboardingAccentForegroundBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="OnboardingAccentForegroundBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="OnboardingHoverBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="OnboardingPressedBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SessionChromeFrameBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="SessionChromeFrameBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SessionChromeFrameBrush" />
                    <StaticResource x:Key="ToggleButtonForeground" ResourceKey="OnboardingPrimaryTextBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="OnboardingPrimaryTextBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="OnboardingPrimaryTextBrush" />
                </ResourceDictionary>
                <!-- High Contrast keeps native control resources. The semantic page
                     brushes above are updated from Windows system colors. -->
                <ResourceDictionary x:Key="HighContrast" />
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{ThemeResource SessionShellBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="Narrow" />
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ImportSecondColumn.Width" Value="*" />
                        <Setter Target="ImportThirdColumn.Width" Value="*" />
                        <Setter Target="OpenSshImportCard.(Grid.Row)" Value="0" />
                        <Setter Target="OpenSshImportCard.(Grid.Column)" Value="1" />
                        <Setter Target="SecureCrtImportCard.(Grid.Row)" Value="0" />
                        <Setter Target="SecureCrtImportCard.(Grid.Column)" Value="2" />
                        <Setter Target="AppearanceDividerColumn.Width" Value="1" />
                        <Setter Target="AppearancePreviewColumn.Width" Value="*" />
                        <Setter Target="AppearanceDivider.Visibility" Value="Visible" />
                        <Setter Target="AppearancePreview.(Grid.Row)" Value="0" />
                        <Setter Target="AppearancePreview.(Grid.Column)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="HeroWidthStates">
                <VisualState x:Name="NarrowHero" />
                <VisualState x:Name="WideHero">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeroActions.Orientation" Value="Horizontal" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="1000" Padding="32" HorizontalAlignment="Center">
                <StackPanel Spacing="24">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Welcome to resesh" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock Text="Open a terminal, create a connection, or import sessions."
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource OnboardingSecondaryTextBrush}" />
                    </StackPanel>

                    <StackPanel x:Name="HeroActions" Orientation="Vertical" Spacing="12">
                        <Button x:Name="WelcomeNewSessionButton" Click="NewSession_Click"
                                Style="{ThemeResource AccentButtonStyle}" Padding="16,8"
                                AutomationProperties.AutomationId="WelcomeNewSessionButton"
                                AutomationProperties.Name="New SSH session">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="16" />
                                <TextBlock Text="New SSH session" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="WelcomeLocalShellButton" Click="LocalShell_Click" Padding="16,8"
                                AutomationProperties.AutomationId="WelcomeLocalShellButton"
                                AutomationProperties.Name="Open local shell">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE756;" FontSize="16" />
                                <TextBlock x:Name="WelcomeLocalShellLabel" Text="Open local shell" Style="{ThemeResource BodyTextBlockStyle}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Rectangle Height="1" Fill="{ThemeResource SessionChromeFrameBrush}" />

                    <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                        <FontIcon Glyph="&#xE896;" FontSize="20" Foreground="{ThemeResource OnboardingAccentTextBrush}"
                                  VerticalAlignment="Top" Margin="0,2,0,0" />
                        <StackPanel Grid.Column="1" Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Import sessions" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="Import from common tools and formats."
                                           Style="{ThemeResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource OnboardingSecondaryTextBrush}" />
                            </StackPanel>

                            <Grid x:Name="ImportCardsGrid" ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="ImportSecondColumn" Width="0" />
                                    <ColumnDefinition x:Name="ImportThirdColumn" Width="0" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border x:Name="PuttyImportCard" Grid.Row="0" Padding="16" MinHeight="172" CornerRadius="{ThemeResource ControlCornerRadius}"
                                        Background="{ThemeResource SessionInputBrush}" BorderThickness="1"
                                        BorderBrush="{ThemeResource SessionChromeFrameBrush}">
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE968;" FontSize="20" Foreground="{ThemeResource OnboardingAccentTextBrush}" />
                                            <TextBlock Text="PuTTY" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="Import saved sessions from the PuTTY registry or export files."
                                                   TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}"
                                                   Foreground="{ThemeResource OnboardingSecondaryTextBrush}" />
                                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock x:Name="PuttyImportLabel" Text="Scanning…" Style="{ThemeResource BodyTextBlockStyle}"
                                                       Foreground="{ThemeResource OnboardingSecondaryTextBrush}" VerticalAlignment="Center" />
                                            <Button x:Name="PuttyImportButton" Grid.Column="1" Content="Review…" Padding="12,6"
                                                    IsEnabled="False" Click="PuttyImport_Click"
                                                    AutomationProperties.AutomationId="PuttyImportButton"
                                                    AutomationProperties.Name="Review PuTTY sessions" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border x:Name="OpenSshImportCard" Grid.Row="1" Padding="16" MinHeight="172" CornerRadius="{ThemeResource ControlCornerRadius}"
                                        Background="{ThemeResource SessionInputBrush}" BorderThickness="1"
                                        BorderBrush="{ThemeResource SessionChromeFrameBrush}">
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource OnboardingAccentTextBrush}" />
                                            <TextBlock Text="OpenSSH" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="Import from your existing SSH config (~/.ssh/config)."
                                                   TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}"
                                                   Foreground="{ThemeResource OnboardingSecondaryTextBrush}" />
                                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock x:Name="OpenSshImportLabel" Text="Scanning…" Style="{ThemeResource BodyTextBlockStyle}"
                                                       Foreground="{ThemeResource OnboardingSecondaryTextBrush}" VerticalAlignment="Center" />
                                            <Button x:Name="OpenSshImportButton" Grid.Column="1" Content="Review…" Padding="12,6"
                                                    IsEnabled="False" Click="OpenSshImport_Click"
                                                    AutomationProperties.AutomationId="OpenSshImportButton"
                                                    AutomationProperties.Name="Review OpenSSH sessions" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border x:Name="SecureCrtImportCard" Grid.Row="2" Padding="16" MinHeight="172" CornerRadius="{ThemeResource ControlCornerRadius}"
                                        Background="{ThemeResource SessionInputBrush}" BorderThickness="1"
                                        BorderBrush="{ThemeResource SessionChromeFrameBrush}">
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="20" Foreground="{ThemeResource OnboardingAccentTextBrush}" />
                                            <TextBlock Text="SecureCRT" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="Import sessions while keeping folder trees and custom settings."
                                                   TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}"
                                                   Foreground="{ThemeResource OnboardingSecondaryTextBrush}" />
                                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock x:Name="SecureCrtImportLabel" Text="Scanning…" Style="{ThemeResource BodyTextBlockStyle}"
                                                       Foreground="{ThemeResource OnboardingSecondaryTextBrush}" VerticalAlignment="Center" />
                                            <Button x:Name="SecureCrtImportButton" Grid.Column="1" Content="Review…" Padding="12,6"
                                                    IsEnabled="False" Click="SecureCrtImport_Click"
                                                    AutomationProperties.AutomationId="SecureCrtImportButton"
                                                    AutomationProperties.Name="Review SecureCRT sessions" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                            <InfoBar x:Name="ImportStatus" IsOpen="False" IsClosable="True" />
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource SessionChromeFrameBrush}" />

                    <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                        <FontIcon Glyph="&#xE790;" FontSize="20" Foreground="{ThemeResource OnboardingAccentTextBrush}"
                                  VerticalAlignment="Top" Margin="0,2,0,0" />
                        <StackPanel Grid.Column="1" Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Appearance" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="Mode is a shortcut for the default palettes. A fixed color theme takes that mode; System follows your Windows setting. The color theme changes the entire app: menus, session tree, tabs, and terminal colors. A theme override for one session changes only that terminal."
                                           TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource OnboardingSecondaryTextBrush}" />
                            </StackPanel>

                            <Grid x:Name="AppearanceContentGrid" ColumnSpacing="24" RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="AppearanceDividerColumn" Width="0" />
                                    <ColumnDefinition x:Name="AppearancePreviewColumn" Width="0" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Mode" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <ToggleButton x:Name="LightThemeToggle" Click="LightTheme_Click" HorizontalAlignment="Stretch"
                                                          AutomationProperties.AutomationId="LightThemeToggle"
                                                          AutomationProperties.Name="Light mode">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE706;" FontSize="16" />
                                                    <TextBlock Text="Light" Style="{ThemeResource BodyTextBlockStyle}" />
                                                </StackPanel>
                                            </ToggleButton>
                                            <ToggleButton x:Name="DarkThemeToggle" Grid.Column="1" Click="DarkTheme_Click" HorizontalAlignment="Stretch"
                                                          AutomationProperties.AutomationId="DarkThemeToggle"
                                                          AutomationProperties.Name="Dark mode">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE708;" FontSize="16" />
                                                    <TextBlock Text="Dark" Style="{ThemeResource BodyTextBlockStyle}" />
                                                </StackPanel>
                                            </ToggleButton>
                                            <ToggleButton x:Name="SystemThemeToggle" Grid.Column="2" Click="SystemTheme_Click" HorizontalAlignment="Stretch"
                                                          AutomationProperties.AutomationId="SystemThemeToggle"
                                                          AutomationProperties.Name="System mode">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE770;" FontSize="16" />
                                                    <TextBlock Text="System" Style="{ThemeResource BodyTextBlockStyle}" />
                                                </StackPanel>
                                            </ToggleButton>
                                        </Grid>
                                    </StackPanel>

                                    <ComboBox x:Name="ThemePicker" Header="Color theme" DisplayMemberPath="Name"
                                              HorizontalAlignment="Stretch" SelectionChanged="ThemePicker_SelectionChanged"
                                              AutomationProperties.AutomationId="ThemePicker"
                                              AutomationProperties.Name="Color theme" />
                                    <TextBlock x:Name="SystemThemeHint" TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource OnboardingSecondaryTextBrush}" Visibility="Collapsed" />
                                </StackPanel>

                                <Rectangle x:Name="AppearanceDivider" Grid.Column="1" Width="1"
                                           Fill="{ThemeResource SessionChromeFrameBrush}" Visibility="Collapsed" />

                                <StackPanel x:Name="AppearancePreview" Grid.Row="1" Spacing="8">
                                    <TextBlock Text="Terminal preview" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <Border x:Name="ThemePreviewSurface" MinHeight="124" CornerRadius="{ThemeResource ControlCornerRadius}"
                                            Background="{ThemeResource OnboardingPreviewBackgroundBrush}"
                                            BorderBrush="{ThemeResource OnboardingPreviewBorderBrush}" BorderThickness="1"
                                            IsHitTestVisible="False">
                                        <Grid RowDefinitions="32,*">
                                            <Border Background="{ThemeResource OnboardingPreviewHeaderBrush}"
                                                    BorderBrush="{ThemeResource OnboardingPreviewBorderBrush}" BorderThickness="0,0,0,1">
                                                <TextBlock Text="Terminal" Margin="12,0" VerticalAlignment="Center"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource OnboardingPreviewTextBrush}" />
                                            </Border>
                                            <StackPanel Grid.Row="1" Padding="12" Spacing="4">
                                                <TextBlock Text="user@host:~$ ssh user@server" FontFamily="Cascadia Mono, Consolas"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource OnboardingPreviewTextBrush}" />
                                                <TextBlock Text="Welcome to resesh!" FontFamily="Cascadia Mono, Consolas"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource OnboardingPreviewTextBrush}" />
                                                <TextBlock Text="user@host:~$ _" FontFamily="Cascadia Mono, Consolas"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource OnboardingPreviewTextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource SessionChromeFrameBrush}" />

                    <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="20" Foreground="{ThemeResource OnboardingAccentTextBrush}"
                                  VerticalAlignment="Top" Margin="0,2,0,0" />
                        <StackPanel Grid.Column="1" Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Preferences" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="Set startup, clipboard, and diagnostic preferences."
                                           Style="{ThemeResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource OnboardingSecondaryTextBrush}" />
                            </StackPanel>
                            <Border CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource SessionInputBrush}"
                                    BorderBrush="{ThemeResource SessionChromeFrameBrush}" BorderThickness="1" Padding="16">
                                <StackPanel Spacing="12">
                                    <ToggleSwitch x:Name="ConfirmCloseToggle" Header="Confirm before closing active sessions" Toggled="PreferenceToggle_Toggled" AutomationProperties.AutomationId="ConfirmCloseToggle" />
                                    <ToggleSwitch x:Name="CopyOnSelectToggle" Header="Copy selected text" Toggled="PreferenceToggle_Toggled" AutomationProperties.AutomationId="CopyOnSelectToggle" />
                                    <ToggleSwitch x:Name="RightClickPasteToggle" Header="Paste with right-click" Toggled="PreferenceToggle_Toggled" AutomationProperties.AutomationId="RightClickPasteToggle" />
                                    <ToggleSwitch x:Name="CrashReportsToggle" Header="Save crash reports on this computer" Toggled="PreferenceToggle_Toggled" AutomationProperties.AutomationId="CrashReportsToggle" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource SessionChromeFrameBrush}" />

                    <Grid>
                        <Button x:Name="FinishSetupButton" Content="Save and close" Click="FinishSetup_Click"
                                HorizontalAlignment="Right" Padding="16,8"
                                AutomationProperties.AutomationId="FinishSetupButton"
                                AutomationProperties.Name="Save preferences and close Welcome"
                                ToolTipService.ToolTip="Save preferences and close Welcome (Ctrl+Enter)" />
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
