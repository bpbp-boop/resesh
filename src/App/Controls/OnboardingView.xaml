<UserControl
    x:Class="Resesh.App.Controls.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="FinishSetup_Invoked" />
    </UserControl.KeyboardAccelerators>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Bar with Brand & Finish Setup Action -->
        <Border
            Grid.Row="0"
            Padding="28,14"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border
                        Width="34"
                        Height="34"
                        CornerRadius="6"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <FontIcon Glyph="&#xE756;" FontSize="17" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="Welcome to Resesh" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="15" />
                        <TextBlock
                            Text="Quick setup and configuration"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <Button
                    x:Name="FinishSetupButton"
                    Grid.Column="2"
                    AutomationProperties.Name="Finish Setup"
                    Style="{ThemeResource AccentButtonStyle}"
                    Padding="16,7"
                    Click="FinishSetup_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Finish Setup" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border
                            Padding="6,1"
                            CornerRadius="4"
                            Background="#24FFFFFF"
                            BorderBrush="#38FFFFFF"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                            <TextBlock Text="Ctrl+Enter" FontSize="11" FontWeight="Normal" />
                        </Border>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main Scrollable Content -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel
                MaxWidth="1140"
                Padding="36,36,36,60"
                HorizontalAlignment="Stretch"
                Spacing="40">

                <!-- Hero Section Header -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Make Resesh yours" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" FontSize="26" />
                    <TextBlock
                        MaxWidth="840"
                        HorizontalAlignment="Left"
                        Text="Customize your terminal theme, import existing SSH sessions from your system, and configure practical defaults. You can revisit this page at any time from View → Welcome or the Command Palette."
                        TextWrapping="Wrap"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Section 1: Application Theme & Previews -->
                <StackPanel Spacing="18">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE790;" FontSize="17" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Application Theme" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock
                                Text="This setting changes the entire app: menus, session tree, tabs, and terminal colors. A theme override for one session changes only that terminal."
                                TextWrapping="Wrap"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- [ Light | Dark | System ] Segment Toggle -->
                        <Border
                            Grid.Column="1"
                            Padding="3"
                            CornerRadius="7"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <ToggleButton
                                    x:Name="LightThemeToggle"
                                    AutomationProperties.Name="Light Theme"
                                    Padding="14,6"
                                    Click="LightTheme_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE706;" FontSize="13" />
                                        <TextBlock Text="Light" FontSize="12" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="DarkThemeToggle"
                                    AutomationProperties.Name="Dark Theme"
                                    Padding="14,6"
                                    Click="DarkTheme_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE708;" FontSize="13" />
                                        <TextBlock Text="Dark" FontSize="12" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="SystemThemeToggle"
                                    AutomationProperties.Name="System Theme"
                                    Padding="14,6"
                                    Click="SystemTheme_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE770;" FontSize="13" />
                                        <TextBlock Text="System" FontSize="12" />
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Featured themes" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock
                                Text="Select a preview card, or open the full theme list."
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <DropDownButton
                            x:Name="BrowseAllThemesButton"
                            Grid.Column="1"
                            Content="Browse all themes..."
                            AutomationProperties.Name="Browse all themes">
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="AllThemesFlyout" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>

                    <!-- Theme Preview Cards Grid: Tokyo Night and Phthalo Green -->
                    <Grid x:Name="ThemeCardsGrid" ColumnSpacing="20" RowSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="ThemeSecondColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Tokyo Night Preview Card -->
                        <ToggleButton
                            x:Name="TokyoNightThemeCard"
                            AutomationProperties.Name="Use Tokyo Night"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Padding="0"
                            CornerRadius="10"
                            Click="TokyoNightTheme_Click">
                            <Grid Padding="22,20" RowSpacing="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="Tokyo Night" FontWeight="SemiBold" FontSize="15" />
                                            <Border Padding="7,2" CornerRadius="4" Background="#1FFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                                                <TextBlock Text="Dark Palette" FontSize="10" Opacity="0.8" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Cool dark palette with vibrant accents and neon hues" FontSize="12" Opacity="0.7" />
                                    </StackPanel>
                                    <FontIcon x:Name="TokyoNightCheck" Grid.Column="1" Glyph="&#xE73E;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" />
                                </Grid>

                                <!-- Native Windows Terminal Frame (Tokyo Night) -->
                                <Border
                                    Grid.Row="1"
                                    MinHeight="190"
                                    CornerRadius="8"
                                    Background="#1A1B26"
                                    BorderBrush="#292E42"
                                    BorderThickness="1">
                                    <Grid RowDefinitions="Auto,*">
                                        <!-- Windows Terminal Tab Bar -->
                                        <Border Grid.Row="0" Padding="10,0" Background="#16161E" BorderBrush="#1F2335" BorderThickness="0,0,0,1" Height="34">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <!-- Windows Terminal Tab -->
                                                <Border
                                                    Padding="12,0"
                                                    Height="34"
                                                    Background="#1A1B26"
                                                    BorderBrush="#292E42"
                                                    BorderThickness="1,0,1,0"
                                                    VerticalAlignment="Stretch">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE756;" FontSize="11" Foreground="#7AA2F7" />
                                                        <TextBlock Text="admin@edge-gw01: ~/production" FontSize="11" Foreground="#C0CAF5" FontFamily="Segoe UI" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Windows Caption Buttons (_ □ ✕) -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Opacity="0.5">
                                                    <FontIcon Glyph="&#xE921;" FontSize="9" Foreground="#C0CAF5" />
                                                    <FontIcon Glyph="&#xE922;" FontSize="9" Foreground="#C0CAF5" />
                                                    <FontIcon Glyph="&#xE8BB;" FontSize="9" Foreground="#C0CAF5" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Terminal Output Area -->
                                        <StackPanel Grid.Row="1" Padding="16,14" Spacing="7">
                                            <StackPanel.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
                                                    <Setter Property="FontSize" Value="12.5" />
                                                </Style>
                                            </StackPanel.Resources>

                                            <!-- Prompt Line 1: User & Folder Green -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="developer@tokyo" Foreground="#BB9AF7" FontWeight="SemiBold" />
                                                <TextBlock Text=":" Foreground="#565F89" />
                                                <TextBlock Text="~/projects/production" Foreground="#9ECE6A" FontWeight="Bold" />
                                                <TextBlock Text=" (main)" Foreground="#7DCFFF" />
                                            </StackPanel>

                                            <!-- Prompt Line 2: Prompt glyph & SSH Command Blue -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="$ " Foreground="#C0CAF5" />
                                                <TextBlock Text="ssh -p 2200 admin@edge-gw01" Foreground="#7AA2F7" FontWeight="SemiBold" />
                                            </StackPanel>

                                            <!-- Line 3: Connection status & output -->
                                            <TextBlock Text="Authenticated to 10.0.1.5 (aes256-gcm) • Linux 6.8.0-31 x86_64" Foreground="#565F89" FontSize="11.5" />

                                            <!-- Line 4: Next prompt with cursor -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="admin@edge-gw01:~$ " Foreground="#9ECE6A" />
                                                <TextBlock Text="▋" Foreground="#C0CAF5" Opacity="0.9" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ToggleButton>

                        <!-- Phthalo Green Preview Card -->
                        <ToggleButton
                            x:Name="PhthaloGreenThemeCard"
                            AutomationProperties.Name="Use Phthalo Green"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Padding="0"
                            CornerRadius="10"
                            Click="PhthaloGreenTheme_Click">
                            <Grid Padding="22,20" RowSpacing="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="Phthalo Green" FontWeight="SemiBold" FontSize="15" />
                                            <Border Padding="7,2" CornerRadius="4" Background="#14000000" BorderBrush="#28000000" BorderThickness="1">
                                                <TextBlock Text="Deep Emerald" FontSize="10" Opacity="0.8" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Rich organic emerald palette with mint and gold accents" FontSize="12" Opacity="0.7" />
                                    </StackPanel>
                                    <FontIcon x:Name="PhthaloGreenCheck" Grid.Column="1" Glyph="&#xE73E;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" />
                                </Grid>

                                <!-- Native Windows Terminal Frame (Phthalo Green) -->
                                <Border
                                    Grid.Row="1"
                                    MinHeight="190"
                                    CornerRadius="8"
                                    Background="#123524"
                                    BorderBrush="#1D4B35"
                                    BorderThickness="1">
                                    <Grid RowDefinitions="Auto,*">
                                        <!-- Windows Terminal Tab Bar -->
                                        <Border Grid.Row="0" Padding="10,0" Background="#0B2118" BorderBrush="#183D2C" BorderThickness="0,0,0,1" Height="34">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <!-- Windows Terminal Tab -->
                                                <Border
                                                    Padding="12,0"
                                                    Height="34"
                                                    Background="#123524"
                                                    BorderBrush="#1D4B35"
                                                    BorderThickness="1,0,1,0"
                                                    VerticalAlignment="Stretch">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE756;" FontSize="11" Foreground="#69A7FF" />
                                                        <TextBlock Text="admin@edge-gw01: ~/production" FontSize="11" Foreground="#D7EEE5" FontFamily="Segoe UI" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Windows Caption Buttons (_ □ ✕) -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Opacity="0.5">
                                                    <FontIcon Glyph="&#xE921;" FontSize="9" Foreground="#D7EEE5" />
                                                    <FontIcon Glyph="&#xE922;" FontSize="9" Foreground="#D7EEE5" />
                                                    <FontIcon Glyph="&#xE8BB;" FontSize="9" Foreground="#D7EEE5" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Terminal Output Area -->
                                        <StackPanel Grid.Row="1" Padding="16,14" Spacing="7">
                                            <StackPanel.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
                                                    <Setter Property="FontSize" Value="12.5" />
                                                </Style>
                                            </StackPanel.Resources>

                                            <!-- Prompt Line 1: User & Folder Green -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="developer@phthalo" Foreground="#CF8DF7" FontWeight="SemiBold" />
                                                <TextBlock Text=":" Foreground="#3B6B58" />
                                                <TextBlock Text="~/projects/production" Foreground="#62D796" FontWeight="Bold" />
                                                <TextBlock Text=" (main)" Foreground="#59D6C3" />
                                            </StackPanel>

                                            <!-- Prompt Line 2: Prompt glyph & SSH Command Blue -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="$ " Foreground="#D7EEE5" />
                                                <TextBlock Text="ssh -p 2200 admin@edge-gw01" Foreground="#69A7FF" FontWeight="SemiBold" />
                                            </StackPanel>

                                            <!-- Line 3: Connection status & output -->
                                            <TextBlock Text="Authenticated to 10.0.1.5 (aes256-gcm) • Linux 6.8.0-31 x86_64" Foreground="#3B6B58" FontSize="11.5" />

                                            <!-- Line 4: Next prompt with cursor -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="admin@edge-gw01:~$ " Foreground="#62D796" />
                                                <TextBlock Text="▋" Foreground="#72E0AD" Opacity="0.9" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ToggleButton>
                    </Grid>

                    <TextBlock
                        x:Name="SystemThemeHint"
                        Text="System mode dynamically tracks your Windows color scheme."
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="Collapsed" />
                </StackPanel>

                <!-- Section 2: Import Sessions (PuTTY, OpenSSH, SecureCRT) -->
                <StackPanel Spacing="18">
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE896;" FontSize="17" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Import Sessions" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock
                            Text="Automatically scanned from your environment. Click import to bring in your hosts with passwords safely stored in Windows Credential Manager."
                            TextWrapping="Wrap"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- 3-Card Import Grid -->
                    <Grid x:Name="ImportCardsGrid" ColumnSpacing="20" RowSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="ImportSecondColumn" Width="*" />
                            <ColumnDefinition x:Name="ImportThirdColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Card 1: PuTTY Registry Sessions -->
                        <Border
                            x:Name="PuttyCard"
                            Grid.Column="0"
                            Padding="22,20"
                            CornerRadius="10"
                            MinHeight="185"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <Grid RowSpacing="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xE756;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="PuTTY Sessions" FontWeight="SemiBold" FontSize="14.5" />
                                        <TextBlock Text="Windows Registry" FontSize="11.5" Opacity="0.65" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock
                                    Grid.Row="1"
                                    Text="Reads saved sessions, hostnames, and custom ports from HKCU\Software\SimonTatham\PuTTY."
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <Button
                                    x:Name="PuttyImportButton"
                                    Grid.Row="2"
                                    AutomationProperties.Name="Import PuTTY sessions"
                                    HorizontalAlignment="Stretch"
                                    Height="36"
                                    Click="PuttyImport_Click"
                                    IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <TextBlock x:Name="PuttyImportLabel" Text="Scanning…" />
                                        <InfoBadge x:Name="PuttyBadge" Visibility="Collapsed" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Card 2: OpenSSH Config -->
                        <Border
                            x:Name="OpenSshCard"
                            Grid.Column="1"
                            Padding="22,20"
                            CornerRadius="10"
                            MinHeight="185"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <Grid RowSpacing="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xE8D7;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="OpenSSH Config" FontWeight="SemiBold" FontSize="14.5" />
                                        <TextBlock Text="~/.ssh/config" FontSize="11.5" Opacity="0.65" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock
                                    Grid.Row="1"
                                    Text="Parses Host entries with configured aliases, usernames, and custom ports."
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <Button
                                    x:Name="OpenSshImportButton"
                                    Grid.Row="2"
                                    AutomationProperties.Name="Import OpenSSH sessions"
                                    HorizontalAlignment="Stretch"
                                    Height="36"
                                    Click="OpenSshImport_Click"
                                    IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <TextBlock x:Name="OpenSshImportLabel" Text="Scanning…" />
                                        <InfoBadge x:Name="OpenSshBadge" Visibility="Collapsed" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Card 3: SecureCRT Sessions -->
                        <Border
                            x:Name="SecureCrtCard"
                            Grid.Column="2"
                            Padding="22,20"
                            CornerRadius="10"
                            MinHeight="185"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <Grid RowSpacing="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="SecureCRT" FontWeight="SemiBold" FontSize="14.5" />
                                        <TextBlock Text="Config\Sessions" FontSize="11.5" Opacity="0.65" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock
                                    Grid.Row="1"
                                    Text="Imports profiles while keeping folder trees and custom session properties."
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <Button
                                    x:Name="SecureCrtImportButton"
                                    Grid.Row="2"
                                    AutomationProperties.Name="Import SecureCRT sessions"
                                    HorizontalAlignment="Stretch"
                                    Height="36"
                                    Click="SecureCrtImport_Click"
                                    IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <TextBlock x:Name="SecureCrtImportLabel" Text="Scanning…" />
                                        <InfoBadge x:Name="SecureCrtBadge" Visibility="Collapsed" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <InfoBar x:Name="ImportStatus" IsOpen="False" IsClosable="True" />
                </StackPanel>

                <!-- Section 3: Settings & Toggles -->
                <StackPanel Spacing="18">
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE713;" FontSize="17" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Settings &amp; Preferences" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock
                            Text="Configure safety guards, terminal clipboard behavior, and diagnostic logging."
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Settings Card Container -->
                    <Border
                        CornerRadius="10"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel>
                            <!-- Row 1: Session Close Guard (Security) -->
                            <Grid Padding="24,18" ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Confirm before closing active sessions" FontWeight="SemiBold" FontSize="14.5" />
                                    <TextBlock
                                        Text="Prompt before closing tabs with running processes or live SSH connections."
                                        TextWrapping="Wrap"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="ConfirmCloseToggle"
                                    Grid.Column="1"
                                    AutomationProperties.Name="Confirm before closing active sessions"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <!-- Row 2: Copy on Select (Terminal Default) -->
                            <Grid Padding="24,18" ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Copy selected terminal text" FontWeight="SemiBold" FontSize="14.5" />
                                    <TextBlock
                                        Text="Automatically copy highlighted terminal text to the clipboard without extra keystrokes."
                                        TextWrapping="Wrap"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="CopyOnSelectToggle"
                                    Grid.Column="1"
                                    AutomationProperties.Name="Copy selected terminal text"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <!-- Row 3: Paste with Right Click (Terminal Default) -->
                            <Grid Padding="24,18" ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Paste with right-click" FontWeight="SemiBold" FontSize="14.5" />
                                    <TextBlock
                                        Text="Send clipboard text to the terminal immediately upon right-clicking."
                                        TextWrapping="Wrap"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="RightClickPasteToggle"
                                    Grid.Column="1"
                                    AutomationProperties.Name="Paste with right-click"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <!-- Row 4: Crash Reports (Diagnostics / Privacy) -->
                            <Grid Padding="24,18" ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Keep local crash logs" FontWeight="SemiBold" FontSize="14.5" />
                                    <TextBlock
                                        Text="Save diagnostic stack traces locally in %LOCALAPPDATA%\Resesh (never uploaded to the network)."
                                        TextWrapping="Wrap"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="CrashReportsToggle"
                                    Grid.Column="1"
                                    AutomationProperties.Name="Keep local crash logs"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Responsive Adaptive Layout Triggers -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide" />
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ThemeSecondColumn.Width" Value="0" />
                        <Setter Target="PhthaloGreenThemeCard.(Grid.Row)" Value="1" />
                        <Setter Target="PhthaloGreenThemeCard.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
