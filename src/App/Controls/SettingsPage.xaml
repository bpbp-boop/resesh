<UserControl
    x:Class="Resesh.App.Controls.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Resesh.App"
    xmlns:controls="using:Resesh.App.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:recording="using:Resesh.Core.Recording"
    Background="{StaticResource SessionPageBrush}"
    Foreground="{StaticResource SessionTreeForegroundBrush}"
    ActualThemeChanged="SettingsPage_ActualThemeChanged">

    <UserControl.Resources>
        <!-- Cards sit on the recessed input surface of the active theme palette. -->
        <StaticResource x:Key="SettingsCardBackground" ResourceKey="SettingsCardBackgroundBrush" />
        <!-- NavigationView lays a lighter Fluent layer and a card border over its content;
             the page itself is the surface, continuous with the selected tab above it. -->
        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />

        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="GroupHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="1,20,0,4" />
        </Style>
        <Style x:Key="SectionScroller" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <!-- Section content is left-aligned beside the navigation and capped at a readable width. -->
        <Style x:Key="SectionBody" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="28,20,28,28" />
            <Setter Property="Spacing" Value="4" />
        </Style>
    </UserControl.Resources>

    <NavigationView
        x:Name="Sections"
        PaneDisplayMode="Left"
        OpenPaneLength="220"
        IsPaneToggleButtonVisible="False"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        AlwaysShowHeader="False"
        Background="Transparent"
        AutomationProperties.AutomationId="SettingsSectionSelector"
        SelectionChanged="Sections_SelectionChanged"
        SizeChanged="Sections_SizeChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="GeneralItem" Content="General" Tag="General" AutomationProperties.AutomationId="SettingsGeneralTab">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="ThemeItem" Content="Theme" Tag="Theme" AutomationProperties.AutomationId="SettingsThemeTab">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE790;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="SessionsItem" Content="Sessions" Tag="Sessions" AutomationProperties.AutomationId="SettingsSessionsTab">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="IdentitiesItem" Content="Identities &amp; Keys" Tag="Identities" AutomationProperties.AutomationId="SettingsIdentitiesTab">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="RecordingItem" Content="Recording" Tag="Recording" AutomationProperties.AutomationId="SettingsRecordingTab">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE7C8;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="HighlightingItem" Content="Highlighting" Tag="Highlighting" AutomationProperties.AutomationId="SettingsHighlightingTab">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE7E6;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="AgentsItem" Content="Agents" Tag="Agents" AutomationProperties.AutomationId="SettingsAgentsTab">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE99A;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="ShortcutsItem" Content="Keyboard Shortcuts" Tag="Shortcuts" AutomationProperties.AutomationId="SettingsShortcutsTab">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE765;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItemSeparator />
            <NavigationViewItem x:Name="AboutItem" Content="About" Tag="About" AutomationProperties.AutomationId="SettingsAboutTab">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <!-- One section shows at a time; each keeps its own scroll position. -->
        <Grid AutomationProperties.AutomationId="SettingsTabContent">

            <!-- ==== General ==== -->
            <ScrollViewer x:Name="GeneralSection" Style="{StaticResource SectionScroller}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1000" />
                    </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource SectionBody}">
                    <TextBlock Text="General" Style="{StaticResource SectionTitle}" />

                    <TextBlock Text="Fonts" Style="{StaticResource GroupHeader}" />
                    <!-- The saved setting is one list: this font, then the fallbacks. Picking a font
                         replaces only the first entry, so the fallbacks survive it. -->
                    <toolkit:SettingsCard x:Name="FontFamilyCard" Header="Terminal font">
                        <controls:FontFamilyPicker
                            x:Name="FontFamilyBox"
                            MinWidth="280"
                            FamilyName="{x:Bind ViewModel.TerminalFont, Mode=TwoWay}"
                            AutomationProperties.Name="Terminal font"
                            AutomationProperties.AutomationId="SettingsFontFamily" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="FallbackFontsCard" Header="Fallback fonts">
                        <TextBox
                            x:Name="FallbackFontsBox"
                            MinWidth="280"
                            Text="{x:Bind ViewModel.FallbackFonts, Mode=TwoWay}"
                            PlaceholderText="Built-in fallbacks only"
                            AutomationProperties.Name="Fallback fonts"
                            AutomationProperties.AutomationId="SettingsFallbackFonts" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Restore default fonts">
                        <Button
                            Content="Reset"
                            Command="{x:Bind ViewModel.ResetFontsCommand}"
                            AutomationProperties.AutomationId="SettingsResetFonts" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="FontSizeCard" Header="Font size">
                        <NumberBox
                            x:Name="FontSizeBox"
                            MinWidth="160"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.FontSize, Mode=TwoWay}"
                            AutomationProperties.Name="Font size"
                            AutomationProperties.AutomationId="SettingsFontSize" />
                    </toolkit:SettingsCard>

                    <TextBlock Text="Terminal" Style="{StaticResource GroupHeader}" />
                    <toolkit:SettingsCard x:Name="ScrollbackCard" Header="Scrollback lines">
                        <NumberBox
                            x:Name="ScrollbackBox"
                            MinWidth="160"
                            SmallChange="1000"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.Scrollback, Mode=TwoWay}"
                            AutomationProperties.Name="Scrollback lines"
                            AutomationProperties.AutomationId="SettingsScrollback" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="CopyOnSelectCard" Header="Copy selected text">
                        <ToggleSwitch
                            x:Name="CopyOnSelectSwitch"
                            IsOn="{x:Bind ViewModel.CopyOnSelect, Mode=TwoWay}"
                            AutomationProperties.Name="Copy selected text"
                            AutomationProperties.AutomationId="SettingsCopyOnSelect" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="RightClickPasteCard" Header="Paste with right-click">
                        <ToggleSwitch
                            x:Name="RightClickPasteSwitch"
                            IsOn="{x:Bind ViewModel.RightClickPaste, Mode=TwoWay}"
                            AutomationProperties.Name="Paste with right-click"
                            AutomationProperties.AutomationId="SettingsRightClickPaste" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="MouseCaptureCard" Header="Mouse in programs">
                        <ComboBox
                            x:Name="MouseCaptureBox"
                            MinWidth="220"
                            ItemsSource="{x:Bind ViewModel.MouseCaptureChoices}"
                            DisplayMemberPath="Name"
                            x:SuppressXamlTrimWarnings="True"
                            SelectedItem="{x:Bind ViewModel.MouseCapture, Mode=TwoWay}"
                            AutomationProperties.Name="Mouse in programs"
                            AutomationProperties.AutomationId="SettingsMouseCapture" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="ConfirmMultilinePasteCard" Header="Confirm multi-line pastes">
                        <ToggleSwitch
                            x:Name="ConfirmMultilinePasteSwitch"
                            IsOn="{x:Bind ViewModel.ConfirmMultilinePaste, Mode=TwoWay}"
                            AutomationProperties.Name="Confirm multi-line pastes"
                            AutomationProperties.AutomationId="SettingsConfirmMultilinePaste" />
                    </toolkit:SettingsCard>

                    <TextBlock Text="Startup and interface" Style="{StaticResource GroupHeader}" />
                    <toolkit:SettingsCard x:Name="ShowStatusBarCard" Header="Show status bar">
                        <ToggleSwitch
                            x:Name="ShowStatusBarSwitch"
                            IsOn="{x:Bind ViewModel.ShowStatusBar, Mode=TwoWay}"
                            AutomationProperties.Name="Show status bar"
                            AutomationProperties.AutomationId="SettingsShowStatusBar" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="SessionsPaneLayoutCard" Header="Sessions pane">
                        <ComboBox
                            x:Name="SessionsPaneLayoutBox"
                            MinWidth="220"
                            ItemsSource="{x:Bind ViewModel.SessionsPaneLayoutChoices}"
                            DisplayMemberPath="Name"
                            x:SuppressXamlTrimWarnings="True"
                            SelectedItem="{x:Bind ViewModel.SessionsPaneLayout, Mode=TwoWay}"
                            AutomationProperties.Name="Sessions pane"
                            AutomationProperties.AutomationId="SettingsSessionsPaneLayout" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="ReopenLastLayoutCard" Header="Reopen last layout at startup">
                        <ToggleSwitch
                            x:Name="ReopenLastLayoutSwitch"
                            IsOn="{x:Bind ViewModel.ReopenLastLayoutAtStartup, Mode=TwoWay}"
                            AutomationProperties.Name="Reopen last layout at startup"
                            AutomationProperties.AutomationId="SettingsReopenLastLayout" />
                    </toolkit:SettingsCard>
                    <!-- Hidden with a custom data folder or in demo mode: a sign-in launch would open the usual data. -->
                    <toolkit:SettingsCard
                        x:Name="LaunchAtSignInCard"
                        Header="Start resesh when I sign in to Windows"
                        Visibility="{x:Bind app:PresentationValues.Visible(ViewModel.CanLaunchAtSignIn)}">
                        <ToggleSwitch
                            x:Name="LaunchAtSignInSwitch"
                            IsOn="{x:Bind ViewModel.LaunchAtSignIn, Mode=TwoWay}"
                            AutomationProperties.Name="Start resesh when I sign in to Windows"
                            AutomationProperties.AutomationId="SettingsLaunchAtSignIn" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="ConfirmCloseCard" Header="Confirm before closing active sessions">
                        <ToggleSwitch
                            x:Name="ConfirmCloseSwitch"
                            IsOn="{x:Bind ViewModel.ConfirmCloseActiveSessions, Mode=TwoWay}"
                            AutomationProperties.Name="Confirm before closing active sessions"
                            AutomationProperties.AutomationId="SettingsConfirmCloseActiveSessions" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="CrashReportsCard" Header="Write crash reports">
                        <ToggleSwitch
                            x:Name="CrashReportsSwitch"
                            IsOn="{x:Bind ViewModel.WriteCrashReports, Mode=TwoWay}"
                            AutomationProperties.Name="Write crash reports"
                            AutomationProperties.AutomationId="SettingsWriteCrashReports" />
                    </toolkit:SettingsCard>
                </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ==== Theme ==== -->
            <ScrollViewer x:Name="ThemeSection" Style="{StaticResource SectionScroller}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1000" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Style="{StaticResource SectionBody}">
                        <TextBlock Text="Theme" Style="{StaticResource SectionTitle}" />
                        <toolkit:SettingsCard x:Name="AppearanceCard" Header="Appearance">
                            <ComboBox x:Name="AppearanceBox" MinWidth="240"
                                      ItemsSource="{x:Bind ViewModel.AppearanceChoices}"
                                      DisplayMemberPath="Name" x:SuppressXamlTrimWarnings="True"
                                      SelectedItem="{x:Bind ViewModel.Appearance, Mode=TwoWay}"
                                      AutomationProperties.Name="Appearance"
                                      AutomationProperties.AutomationId="SettingsAppearance" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard x:Name="ThemeColorsCard" Header="Color the app with the theme">
                            <ComboBox x:Name="ThemeColorsBox" MinWidth="240"
                                      ItemsSource="{x:Bind ViewModel.ThemeColorsChoices}"
                                      DisplayMemberPath="Name" x:SuppressXamlTrimWarnings="True"
                                      SelectedItem="{x:Bind ViewModel.ThemeColors, Mode=TwoWay}"
                                      AutomationProperties.Name="Color the app with the theme"
                                      AutomationProperties.AutomationId="SettingsThemeColors" />
                        </toolkit:SettingsCard>
                        <controls:ThemeFilterBar x:Name="ThemeFilter" Margin="0,16,0,0" ShowCategories="False"
                                                 QueryChanged="ThemeFilter_QueryChanged" />

                        <!-- Theme: every theme, a row per category. -->
                        <StackPanel x:Name="FixedThemePanel" Margin="0,12,0,0"
                                    Visibility="{x:Bind app:PresentationValues.Collapsed(ViewModel.IsFollowingWindows), Mode=OneWay}">
                            <controls:ThemeCategoryRows x:Name="FixedGallery"
                                                        Themes="{x:Bind ViewModel.AllThemes}"
                                                        SelectedTheme="{x:Bind ViewModel.Theme, Mode=TwoWay}"
                                                        AutomationProperties.Name="Theme"
                                                        AutomationProperties.AutomationId="SettingsTheme" />
                        </StackPanel>

                        <!-- System: a theme for each Windows mode. -->
                        <StackPanel x:Name="SystemThemesPanel"
                                    Visibility="{x:Bind app:PresentationValues.Visible(ViewModel.IsFollowingWindows), Mode=OneWay}">
                            <TextBlock x:Name="LightThemeHeader" Text="Light mode" Style="{StaticResource SubtitleTextBlockStyle}" Margin="1,20,0,0" />
                            <controls:ThemeCategoryRows x:Name="LightGallery"
                                                   Themes="{x:Bind ViewModel.LightThemes}"
                                                   SelectedTheme="{x:Bind ViewModel.LightTheme, Mode=TwoWay}"
                                                   AutomationProperties.Name="Theme when Windows is in light mode"
                                                   AutomationProperties.AutomationId="SettingsLightTheme" />
                            <TextBlock x:Name="DarkThemeHeader" Text="Dark mode" Style="{StaticResource SubtitleTextBlockStyle}" Margin="1,28,0,0" />
                            <controls:ThemeCategoryRows x:Name="DarkGallery"
                                                   Themes="{x:Bind ViewModel.DarkThemes}"
                                                   SelectedTheme="{x:Bind ViewModel.DarkTheme, Mode=TwoWay}"
                                                   AutomationProperties.Name="Theme when Windows is in dark mode"
                                                   AutomationProperties.AutomationId="SettingsDarkTheme" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ==== Sessions: the table scrolls within its own list. ==== -->
            <Grid
                x:Name="SessionsSection"
                Padding="28,20,28,20"
                Visibility="Collapsed">
                <controls:SessionsManagerView x:Name="SessionsManager" />
            </Grid>

            <!-- ==== Identities and keys ==== -->
            <ScrollViewer x:Name="IdentitiesSection" Style="{StaticResource SectionScroller}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1000" />
                    </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource SectionBody}">
                    <TextBlock Text="Identities &amp; Keys" Style="{StaticResource SectionTitle}" />
                    <InfoBar x:Name="IdentityStatus" IsOpen="False" IsClosable="True" />

                    <TextBlock Text="Identities" Style="{StaticResource GroupHeader}" />
                    <toolkit:SettingsCard x:Name="DefaultIdentityCard" Header="Default identity">
                        <ComboBox
                            x:Name="DefaultIdentityBox"
                            MinWidth="240"
                            DisplayMemberPath="Label"
                            x:SuppressXamlTrimWarnings="True"
                            SelectionChanged="DefaultIdentityBox_SelectionChanged"
                            AutomationProperties.Name="Default identity"
                            AutomationProperties.AutomationId="SettingsDefaultIdentity" />
                    </toolkit:SettingsCard>
                    <StackPanel x:Name="IdentityRows" Spacing="4" />
                    <Button
                        Margin="0,6,0,0"
                        Content="New identity…"
                        Click="NewIdentity_Click"
                        AutomationProperties.AutomationId="SettingsNewIdentity" />

                    <TextBlock Text="SSH keys" Style="{StaticResource GroupHeader}" />
                    <StackPanel x:Name="KeyRows" Spacing="4" />
                    <Button
                        Margin="0,6,0,0"
                        Content="Add key…"
                        Click="AddKey_Click"
                        AutomationProperties.AutomationId="SettingsAddKey" />

                    <TextBlock x:Name="SshAlgorithmsHeader" Text="SSH algorithms" Style="{StaticResource GroupHeader}" />
                    <ContentControl
                        x:Name="SshAlgorithmsHost"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" />
                </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ==== Recording ==== -->
            <ScrollViewer x:Name="RecordingSection" Style="{StaticResource SectionScroller}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1000" />
                    </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource SectionBody}">
                    <TextBlock Text="Recording" Style="{StaticResource SectionTitle}" />

                    <TextBlock Text="Command history" Style="{StaticResource GroupHeader}" />
                    <toolkit:SettingsCard x:Name="KeepHistoryCard" Header="Keep a searchable command history">
                        <ToggleSwitch
                            x:Name="KeepHistorySwitch"
                            IsOn="{x:Bind ViewModel.KeepCommandHistory, Mode=TwoWay}"
                            AutomationProperties.Name="Keep a searchable command history"
                            AutomationProperties.AutomationId="SettingsKeepCommandHistory" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="HistoryDaysCard" Header="Keep history for (days)">
                        <NumberBox
                            x:Name="HistoryDaysBox"
                            MinWidth="160"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.CommandHistoryDays, Mode=TwoWay}"
                            AutomationProperties.Name="Keep history for (days)"
                            AutomationProperties.AutomationId="SettingsCommandHistoryDays" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Saved history" Description="{x:Bind ViewModel.HistoryUsageText, Mode=OneWay}">
                        <Button
                            x:Name="ClearHistoryButton"
                            Content="Clear History…"
                            IsEnabled="{x:Bind ViewModel.CanClearHistory, Mode=OneWay}"
                            AutomationProperties.AutomationId="SettingsClearCommandHistory">
                            <Button.Flyout>
                                <Flyout x:Name="ClearHistoryFlyout">
                                    <StackPanel MaxWidth="300" Spacing="12">
                                        <TextBlock Text="Delete every saved command and its output? This cannot be undone." TextWrapping="Wrap" />
                                        <Button Content="Delete All History" Click="ConfirmClearHistory_Click" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </toolkit:SettingsCard>

                    <TextBlock Text="Disk recording" Style="{StaticResource GroupHeader}" />
                    <toolkit:SettingsCard x:Name="RecordingDirectoryCard" Header="Recording directory">
                        <TextBox
                            x:Name="RecordingDirectoryBox"
                            MinWidth="320"
                            Text="{x:Bind ViewModel.RecordingDirectory, Mode=TwoWay}"
                            AutomationProperties.Name="Recording directory"
                            AutomationProperties.AutomationId="SettingsRecordingDirectory" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="AlwaysRecordCard" Header="Record new sessions automatically">
                        <ToggleSwitch
                            x:Name="AlwaysRecordSwitch"
                            IsOn="{x:Bind ViewModel.AlwaysRecord, Mode=TwoWay}"
                            AutomationProperties.Name="Record new sessions automatically"
                            AutomationProperties.AutomationId="SettingsAlwaysRecord" />
                    </toolkit:SettingsCard>

                    <TextBlock Text="Instant rewind" Style="{StaticResource GroupHeader}" />
                    <toolkit:SettingsCard x:Name="RewindMinutesCard" Header="Rewind history (minutes)">
                        <NumberBox
                            x:Name="RewindMinutesBox"
                            MinWidth="160"
                            Minimum="{x:Bind recording:RewindLimits.MinimumMinutes}"
                            Maximum="{x:Bind recording:RewindLimits.MaximumMinutes}"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.RewindMinutes, Mode=TwoWay}"
                            AutomationProperties.Name="Rewind history (minutes)"
                            AutomationProperties.AutomationId="SettingsRewindMinutes" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="RewindMegabytesCard" Header="Memory limit per tab (MiB)">
                        <NumberBox
                            x:Name="RewindMegabytesBox"
                            MinWidth="160"
                            Minimum="{x:Bind recording:RewindLimits.MinimumMegabytes}"
                            Maximum="{x:Bind recording:RewindLimits.MaximumMegabytes}"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.RewindMegabytes, Mode=TwoWay}"
                            AutomationProperties.Name="Memory limit per tab (MiB)"
                            AutomationProperties.AutomationId="SettingsRewindMegabytes" />
                    </toolkit:SettingsCard>
                </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ==== Highlighting ==== -->
            <ScrollViewer x:Name="HighlightingSection" Style="{StaticResource SectionScroller}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1000" />
                    </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource SectionBody}" Spacing="12">
                    <TextBlock Text="Highlighting" Style="{StaticResource SectionTitle}" />
                    <InfoBar
                        x:Name="HighlightSaveError"
                        IsOpen="False"
                        IsClosable="True"
                        Severity="Error"
                        Message="Could not save highlighting rules. Your last change is kept here; make another change to try again." />
                    <ContentPresenter x:Name="HighlightEditorHost" />
                </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ==== Agents ==== -->
            <ScrollViewer x:Name="AgentsSection" Style="{StaticResource SectionScroller}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1000" />
                    </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource SectionBody}">
                    <TextBlock Text="Agents" Style="{StaticResource SectionTitle}" />

                    <TextBlock Text="Status" Style="{StaticResource GroupHeader}" />
                    <!-- Alerts depend on the recognition the icons turn on, so they sit inside it. -->
                    <toolkit:SettingsExpander
                        x:Name="AgentIconsCard"
                        Header="Show agent icons"
                        IsExpanded="{x:Bind ViewModel.AgentAlertsEnabled, Mode=OneWay}">
                        <ToggleSwitch
                            x:Name="AgentIconsSwitch"
                            IsOn="{x:Bind ViewModel.ShowAgentIcons, Mode=TwoWay}"
                            AutomationProperties.Name="Show agent icons"
                            AutomationProperties.AutomationId="SettingsShowAgentIcons" />
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard
                                x:Name="AgentFlashCard"
                                Header="Flash the taskbar"
                                IsEnabled="{x:Bind ViewModel.AgentAlertsEnabled, Mode=OneWay}">
                                <ToggleSwitch
                                    x:Name="AgentFlashSwitch"
                                    IsOn="{x:Bind ViewModel.AgentAlertFlash, Mode=TwoWay}"
                                    AutomationProperties.Name="Flash the taskbar"
                                    AutomationProperties.AutomationId="SettingsAgentAlertFlash" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                x:Name="AgentSoundCard"
                                Header="Play the notification sound"
                                IsEnabled="{x:Bind ViewModel.AgentAlertsEnabled, Mode=OneWay}">
                                <ToggleSwitch
                                    x:Name="AgentSoundSwitch"
                                    IsOn="{x:Bind ViewModel.AgentAlertSound, Mode=TwoWay}"
                                    AutomationProperties.Name="Play the notification sound"
                                    AutomationProperties.AutomationId="SettingsAgentAlertSound" />
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>

                    <TextBlock Text="Agent adapters" Style="{StaticResource GroupHeader}" />
                    <controls:AgentAdaptersView />
                </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ==== Keyboard shortcuts: the reference scrolls within its own list. ==== -->
            <Grid
                x:Name="ShortcutsSection"
                Padding="28,20,28,20"
                RowDefinitions="Auto,*"
                RowSpacing="12"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="944" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Keyboard Shortcuts" Style="{StaticResource SectionTitle}" />
                <controls:ShortcutsReference x:Name="Shortcuts" Grid.Row="1" />
            </Grid>

            <!-- ==== About ==== -->
            <ScrollViewer x:Name="AboutSection" Style="{StaticResource SectionScroller}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1000" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Style="{StaticResource SectionBody}">
                        <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
                        <controls:AboutView />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </NavigationView>
</UserControl>
