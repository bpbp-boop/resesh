<UserControl
    x:Class="Resesh.App.Controls.ShortcutsReference"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Resesh.App.Controls">

    <UserControl.Resources>
        <!-- One key cap: raised bottom edge, like the key it names. -->
        <DataTemplate x:Key="KeyCapTemplate" x:DataType="x:String">
            <Border
                MinWidth="26"
                Padding="6,1,6,2"
                CornerRadius="4"
                BorderThickness="1,1,1,2"
                BorderBrush="{StaticResource SettingsCardBorderBrush}"
                Background="{StaticResource SessionInputBrush}">
                <TextBlock Text="{x:Bind}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
            </Border>
        </DataTemplate>

        <!-- A chord (Ctrl + Shift + P), or the word between two chords ("or", "to"). -->
        <DataTemplate x:Key="KeyTokenTemplate" x:DataType="local:KeyToken">
            <Grid VerticalAlignment="Center">
                <TextBlock
                    Text="{x:Bind Text}"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource SessionTreeMutedForegroundBrush}"
                    Visibility="{x:Bind IsSeparator}" />
                <ItemsControl
                    ItemsSource="{x:Bind Keys}"
                    ItemTemplate="{StaticResource KeyCapTemplate}"
                    Visibility="{x:Bind IsChord}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ShortcutRowTemplate" x:DataType="local:ShortcutEntry">
            <Grid
                Padding="0,5"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="16"
                AutomationProperties.Name="{x:Bind AutomationName}"
                AutomationProperties.AutomationId="{x:Bind AutomationId}">
                <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind Note}"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource SessionTreeMutedForegroundBrush}"
                        Visibility="{x:Bind HasNote}" />
                </StackPanel>
                <ItemsControl
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    ItemsSource="{x:Bind Tokens}"
                    ItemTemplate="{StaticResource KeyTokenTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <TextBlock
            Text="Terminal shortcuts work while a terminal has focus. All others work anywhere in the window, including the terminal. Ctrl with a single letter always goes to the shell."
            TextWrapping="Wrap"
            Foreground="{StaticResource SessionTreeMutedForegroundBrush}" />

        <TextBox
            x:Name="SearchBox"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            PlaceholderText="Search shortcuts"
            AutomationProperties.Name="Search shortcuts"
            AutomationProperties.AutomationId="KeyboardShortcutsSearch"
            TextChanged="SearchBox_TextChanged" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="0,0,16,0" Spacing="20">
                <ItemsControl ItemsSource="{x:Bind Groups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="20" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ShortcutGroup">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    Text="{x:Bind Category}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    AutomationProperties.HeadingLevel="Level2" />
                                <ItemsControl
                                    ItemsSource="{x:Bind Entries}"
                                    ItemTemplate="{StaticResource ShortcutRowTemplate}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    x:Name="NoMatchesText"
                    Text="No matching shortcuts"
                    Foreground="{StaticResource SessionTreeMutedForegroundBrush}"
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
