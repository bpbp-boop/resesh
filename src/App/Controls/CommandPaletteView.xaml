<UserControl
    x:Class="Resesh.App.Controls.CommandPaletteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Resesh.App.Controls"
    Visibility="Collapsed"
    AutomationProperties.Name="Command palette">

    <Grid>
        <Button
            x:Name="Backdrop"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#66000000"
            BorderThickness="0"
            IsTabStop="False"
            Click="Backdrop_Click"
            AutomationProperties.Name="Close command palette" />

        <Border
            x:Name="PaletteCard"
            MaxWidth="680"
            Margin="24,72,24,24"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid RowDefinitions="Auto,*">
                <TextBox
                    x:Name="SearchBox"
                    Margin="12"
                    PlaceholderText="Search commands and settings"
                    TextChanged="SearchBox_TextChanged"
                    AutomationProperties.Name="Search commands and settings" />

                <Grid Grid.Row="1">
                    <ListView
                        x:Name="CommandList"
                        MaxHeight="480"
                        Margin="8,0,8,8"
                        SelectionMode="Single"
                        IsItemClickEnabled="True"
                        ItemClick="CommandList_ItemClick"
                        AutomationProperties.Name="Command results">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="48" />
                                <Setter Property="Padding" Value="10,6" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="controls:CommandPaletteEntry">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{x:Bind Category}"
                                            FontSize="12"
                                            Opacity="0.6"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Shortcut}"
                                        FontSize="12"
                                        Opacity="0.6"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        x:Name="NoResultsText"
                        Margin="20,12,20,24"
                        Text="No matching commands"
                        Opacity="0.65"
                        HorizontalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
