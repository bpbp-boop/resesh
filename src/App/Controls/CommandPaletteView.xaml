<UserControl
    x:Class="Resesh.App.Controls.CommandPaletteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Resesh.App.Controls"
    Visibility="Collapsed"
    AutomationProperties.Name="Command palette">

    <Grid>
        <Button
            x:Name="Backdrop"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#66000000"
            BorderThickness="0"
            IsTabStop="False"
            Click="Backdrop_Click"
            AutomationProperties.Name="Close command palette" />

        <Border
            x:Name="PaletteCard"
            MaxWidth="680"
            Margin="24,72,24,24"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Background="{StaticResource SessionShellBrush}"
            BorderBrush="{StaticResource SessionChromeFrameBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid RowDefinitions="Auto,*">
                <!-- The palette is made of the same material as the session tree: the card
                     is a shell surface, the search field is recessed to the input surface, and
                     rows select with the tree's selection color. Only the focus underline
                     spends the theme accent. -->
                <TextBox
                    x:Name="SearchBox"
                    Margin="12"
                    PlaceholderText="Search commands and settings"
                    Foreground="{StaticResource SessionTreeForegroundBrush}"
                    PlaceholderForeground="{StaticResource SessionTreeMutedForegroundBrush}"
                    SelectionHighlightColor="{StaticResource SessionAccentBrush}"
                    TextChanged="SearchBox_TextChanged"
                    AutomationProperties.Name="Search commands and settings">
                    <TextBox.Resources>
                        <StaticResource x:Key="TextControlBackground" ResourceKey="SessionInputBrush" />
                        <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SessionInputBrush" />
                        <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SessionInputBrush" />
                        <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="SessionInputBrush" />
                        <StaticResource x:Key="TextControlBorderBrush" ResourceKey="SessionChromeFrameBrush" />
                        <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="SessionChromeFrameBrush" />
                        <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="SessionAccentBrush" />
                        <StaticResource x:Key="TextControlForeground" ResourceKey="SessionTreeForegroundBrush" />
                        <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="SessionTreeForegroundBrush" />
                        <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="SessionTreeForegroundBrush" />
                        <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="SessionTreeMutedForegroundBrush" />
                        <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="SessionTreeMutedForegroundBrush" />
                        <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="SessionTreeMutedForegroundBrush" />
                    </TextBox.Resources>
                </TextBox>

                <Grid Grid.Row="1">
                    <ListView
                        x:Name="CommandList"
                        MaxHeight="480"
                        Margin="8,0,8,8"
                        SelectionMode="Single"
                        IsItemClickEnabled="True"
                        ItemClick="CommandList_ItemClick"
                        Foreground="{StaticResource SessionTreeForegroundBrush}"
                        AutomationProperties.Name="Command results">
                        <ListView.Resources>
                            <!-- Pointer-over keeps WinUI's translucent overlay: it reads on any
                                 theme surface. Selection takes the tree's own selection color. -->
                            <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="SessionTreeSelectionBrush" />
                            <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="SessionTreeSelectionBrush" />
                            <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="SessionTreeSelectionBrush" />
                            <StaticResource x:Key="ListViewItemForeground" ResourceKey="SessionTreeForegroundBrush" />
                            <StaticResource x:Key="ListViewItemForegroundPointerOver" ResourceKey="SessionTreeForegroundBrush" />
                            <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="SessionTreeSelectionForegroundBrush" />
                        </ListView.Resources>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="48" />
                                <Setter Property="Padding" Value="10,6" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="controls:CommandPaletteEntry">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{x:Bind Category}"
                                            FontSize="12"
                                            Opacity="0.6"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Shortcut}"
                                        FontSize="12"
                                        Opacity="0.6"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        x:Name="NoResultsText"
                        Margin="20,12,20,24"
                        Text="No matching commands"
                        Foreground="{StaticResource SessionTreeMutedForegroundBrush}"
                        HorizontalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
