<UserControl
    x:Class="Resesh.App.Controls.TabGroupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Resesh.App"
    xmlns:vm="using:Resesh.App.ViewModels">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- VS Code-style tab strip: square flush tabs, selected tabs blend into their
                 terminals, and the selected tab in an unfocused pane gains an underline. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TabViewBackground" Color="#181818" />
                    <SolidColorBrush x:Key="TabViewBorderBrush" Color="#181818" />
                    <!-- The header DataTemplate paints the whole tab; kill the built-in chrome. -->
                    <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="Transparent" />
                    <!-- WinUI's strip has 8px top padding (generic.xaml: TabViewHeaderPadding
                         0,8,0,0) which shoves tabs down and clips them; VS Code tabs sit flush. -->
                    <Thickness x:Key="TabViewHeaderPadding">0,0,0,0</Thickness>
                    <Thickness x:Key="TabViewItemHeaderPadding">0,0,0,0</Thickness>
                    <x:Double x:Key="TabViewItemMinHeight">44</x:Double>
                    <x:Double x:Key="TabViewItemHeaderMinHeight">44</x:Double>
                    <SolidColorBrush x:Key="CodeTabSeparatorBrush" Color="#2B2B2B" />
                    <!-- Matches VS Code's dark editor-group drop preview. -->
                    <SolidColorBrush x:Key="TabDropOverlayBrush" Color="#8053595D" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TabViewBackground" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="TabViewBorderBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="Transparent" />
                    <Thickness x:Key="TabViewHeaderPadding">0,0,0,0</Thickness>
                    <Thickness x:Key="TabViewItemHeaderPadding">0,0,0,0</Thickness>
                    <x:Double x:Key="TabViewItemMinHeight">44</x:Double>
                    <x:Double x:Key="TabViewItemHeaderMinHeight">44</x:Double>
                    <SolidColorBrush x:Key="CodeTabSeparatorBrush" Color="#D8D8D8" />
                    <SolidColorBrush x:Key="TabDropOverlayBrush" Color="#332677CB" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="TabViewBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TabViewBorderBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="Transparent" />
                    <Thickness x:Key="TabViewHeaderPadding">0,0,0,0</Thickness>
                    <Thickness x:Key="TabViewItemHeaderPadding">0,0,0,0</Thickness>
                    <x:Double x:Key="TabViewItemMinHeight">44</x:Double>
                    <x:Double x:Key="TabViewItemHeaderMinHeight">44</x:Double>
                    <SolidColorBrush x:Key="CodeTabSeparatorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TabDropOverlayBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Browser-style sizing: tabs stay at the normal 220px width until the strip
                 needs the space, then shrink together to a usable 100px floor. Beyond that,
                 TabView keeps the minimum and exposes its built-in horizontal scrolling. -->
            <x:Double x:Key="TabViewItemMaxWidth">220</x:Double>
            <x:Double x:Key="TabViewItemMinWidth">100</x:Double>

            <!-- Minimal TabViewItem chrome with the native drag and reorder states retained.
                 The header DataTemplate still paints the tab edge to edge. -->
            <Style x:Key="CodeTabStyle" TargetType="TabViewItem">
                <Setter Property="MinWidth" Value="{ThemeResource TabViewItemMinWidth}" />
                <Setter Property="MaxWidth" Value="{ThemeResource TabViewItemMaxWidth}" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabViewItem">
                            <Grid
                                x:Name="LayoutRoot"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="LayoutRootScale" />
                                </Grid.RenderTransform>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="ReorderHintStates">
                                        <VisualState x:Name="NoReorderHint" />
                                        <VisualState x:Name="BottomReorderHint">
                                            <Storyboard>
                                                <DragOverThemeAnimation
                                                    TargetName="LayoutRoot"
                                                    ToOffset="{ThemeResource ListViewItemReorderHintThemeOffset}"
                                                    Direction="Bottom" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="TopReorderHint">
                                            <Storyboard>
                                                <DragOverThemeAnimation
                                                    TargetName="LayoutRoot"
                                                    ToOffset="{ThemeResource ListViewItemReorderHintThemeOffset}"
                                                    Direction="Top" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="RightReorderHint">
                                            <Storyboard>
                                                <DragOverThemeAnimation
                                                    TargetName="LayoutRoot"
                                                    ToOffset="{ThemeResource ListViewItemReorderHintThemeOffset}"
                                                    Direction="Right" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="LeftReorderHint">
                                            <Storyboard>
                                                <DragOverThemeAnimation
                                                    TargetName="LayoutRoot"
                                                    ToOffset="{ThemeResource ListViewItemReorderHintThemeOffset}"
                                                    Direction="Left" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition To="NoReorderHint" GeneratedDuration="0:0:0.2" />
                                        </VisualStateGroup.Transitions>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="DragStates">
                                        <VisualState x:Name="NotDragging" />
                                        <VisualState x:Name="Dragging">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="LayoutRoot"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="{ThemeResource ListViewItemDragThemeOpacity}"
                                                    Duration="0" />
                                                <DragItemThemeAnimation TargetName="LayoutRoot" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="DraggingTarget" />
                                        <VisualState x:Name="MultipleDraggingPrimary" />
                                        <VisualState x:Name="MultipleDraggingSecondary" />
                                        <VisualState x:Name="DraggedPlaceholder" />
                                        <VisualState x:Name="Reordering">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="LayoutRoot"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="{ThemeResource ListViewItemReorderThemeOpacity}"
                                                    Duration="0:0:0.240" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="ReorderingTarget">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="LayoutRoot"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="{ThemeResource ListViewItemReorderTargetThemeOpacity}"
                                                    Duration="0:0:0.240" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="MultipleReorderingPrimary" />
                                        <VisualState x:Name="ReorderedPlaceholder">
                                            <Storyboard>
                                                <FadeOutThemeAnimation TargetName="LayoutRoot" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="DragOver">
                                            <Storyboard>
                                                <DropTargetItemThemeAnimation TargetName="LayoutRoot" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition To="NotDragging" GeneratedDuration="0:0:0.2" />
                                        </VisualStateGroup.Transitions>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tab strip only; terminals render in TerminalHost so WebView2 gets real space. -->
        <Grid
            x:Name="TabStripHost"
            Grid.Row="0"
            Background="Transparent"
            AllowDrop="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TabView
                x:Name="Tabs"
                Grid.Column="0"
                Height="44"
                Margin="0"
                Padding="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Loaded="Tabs_Loaded"
                TabItemsSource="{x:Bind Group.Tabs, Mode=OneWay}"
                SelectedItem="{x:Bind Group.SelectedTab, Mode=TwoWay}"
                SelectionChanged="Tabs_SelectionChanged"
                IsAddTabButtonVisible="False"
                TabWidthMode="Equal"
                CanDragTabs="True"
                CanReorderTabs="True"
                TabCloseRequested="Tabs_TabCloseRequested"
                TabDragStarting="Tabs_TabDragStarting"
                TabDragCompleted="Tabs_TabDragCompleted"
                TabStripDragOver="Tabs_TabStripDragOver"
                TabStripDrop="Tabs_TabStripDrop">
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="vm:TabViewModel">
                    <TabViewItem
                        Style="{StaticResource CodeTabStyle}"
                        IsClosable="False"
                        CanDrag="{x:Bind CanDrag}"
                        Height="44">
                        <TabViewItem.Header>
                            <!-- The tab is painted entirely here: background, focus indicators,
                                 and a custom close button. The right border is the VS Code-style
                                 1px divider between tabs. -->
                            <Grid
                                Height="44"
                                Margin="0"
                                BorderThickness="0,0,1,0"
                                PointerEntered="TabHeader_PointerEntered"
                                PointerExited="TabHeader_PointerExited">
                                <Grid.Background>
                                    <SolidColorBrush Color="{x:Bind local:PresentationValues.TabHeaderBackgroundColor(AppTheme, IsActive, IsPointerOver), Mode=OneWay}" />
                                </Grid.Background>
                                <Grid.BorderBrush>
                                    <SolidColorBrush Color="{x:Bind local:PresentationValues.TabHeaderBorderColor(AppTheme), Mode=OneWay}" />
                                </Grid.BorderBrush>
                                <Rectangle
                                    Height="1"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Stretch"
                                    Visibility="{x:Bind local:PresentationValues.FocusedAccentVisibility(IsActive, IsGroupFocused), Mode=OneWay}">
                                    <Rectangle.Fill>
                                        <SolidColorBrush Color="{x:Bind local:PresentationValues.FocusedTabBorderColor(AppTheme, ColorTag), Mode=OneWay}" />
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle
                                    Height="1"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Stretch"
                                    Visibility="{x:Bind local:PresentationValues.InactiveUnderlineVisibility(IsActive, IsGroupFocused), Mode=OneWay}">
                                    <Rectangle.Fill>
                                        <SolidColorBrush Color="{x:Bind local:PresentationValues.TabHeaderBorderColor(AppTheme), Mode=OneWay}" />
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Grid
                                    Margin="10,0,6,0"
                                    VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle
                                        Grid.Column="0"
                                        Width="3"
                                        Height="22"
                                        Margin="0,0,6,0"
                                        RadiusX="1.5"
                                        RadiusY="1.5"
                                        VerticalAlignment="Center">
                                        <Rectangle.Fill>
                                            <SolidColorBrush Color="{x:Bind local:PresentationValues.ColorTag(ColorTag), Mode=OneWay}" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="5"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center">
                                        <Ellipse
                                            Width="7"
                                            Height="7"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{x:Bind StateText, Mode=OneWay}">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{x:Bind local:PresentationValues.StateColor(State, HasUnseenOutput), Mode=OneWay}" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse
                                            Width="7"
                                            Height="7"
                                            Fill="#E74856"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind local:PresentationValues.Visible(IsRecording), Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind RecordingTooltip, Mode=OneWay}" />
                                    </StackPanel>
                                    <!-- Tabs stay icon-free unless an agent is active. The
                                         attention badge stays attached to the agent icon. -->
                                    <Grid
                                        Grid.Column="2"
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="{x:Bind AgentTooltip, Mode=OneWay}"
                                        Visibility="{x:Bind local:PresentationValues.AgentIconVisibility(AgentIconKey), Mode=OneWay}">
                                        <Image
                                            Source="{x:Bind local:PresentationValues.AgentIcon(AgentIconKey), Mode=OneWay}"
                                            Width="16"
                                            Height="16" />
                                        <Border
                                            Width="{x:Bind AgentBadgeSize, Mode=OneWay}"
                                            Height="{x:Bind AgentBadgeSize, Mode=OneWay}"
                                            Margin="0,0,-2,-2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            CornerRadius="6"
                                            BorderThickness="1"
                                            Visibility="{x:Bind local:PresentationValues.AgentBadgeVisibility(AgentIconKey, Agent.Attention), Mode=OneWay}">
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="{x:Bind local:PresentationValues.TabHeaderBackgroundColor(AppTheme, IsActive, IsPointerOver), Mode=OneWay}" />
                                            </Border.BorderBrush>
                                            <Border.Background>
                                                <SolidColorBrush Color="{x:Bind local:PresentationValues.AgentBadgeColor(Agent.Attention), Mode=OneWay}" />
                                            </Border.Background>
                                            <TextBlock
                                                Text="{x:Bind AgentBadgeGlyph, Mode=OneWay}"
                                                Foreground="White"
                                                FontSize="8"
                                                FontWeight="Bold"
                                                IsTextScaleFactorEnabled="False"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <FontIcon
                                        Grid.Column="3"
                                        Glyph="&#xE840;"
                                        FontSize="11"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Pinned"
                                        Visibility="{x:Bind local:PresentationValues.Visible(IsPinned), Mode=OneWay}">
                                        <FontIcon.Foreground>
                                            <SolidColorBrush Color="{x:Bind local:PresentationValues.TabHeaderForegroundColor(AppTheme, IsActive, IsGroupFocused, IsPointerOver), Mode=OneWay}" />
                                        </FontIcon.Foreground>
                                    </FontIcon>
                                    <FontIcon
                                        Grid.Column="4"
                                        Glyph="&#xE72E;"
                                        FontSize="11"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind local:PresentationValues.Visible(IsLocked), Mode=OneWay}">
                                        <FontIcon.Foreground>
                                            <SolidColorBrush Color="{x:Bind local:PresentationValues.TabHeaderForegroundColor(AppTheme, IsActive, IsGroupFocused, IsPointerOver), Mode=OneWay}" />
                                        </FontIcon.Foreground>
                                    </FontIcon>
                                    <!-- Two lines: the session name, and whatever best identifies
                                         this particular tab (running program, cwd, or endpoint) —
                                         so several tabs of one host aren't interchangeable. -->
                                    <StackPanel
                                        Grid.Column="5"
                                        MinWidth="0"
                                        VerticalAlignment="Center"
                                        Spacing="0">
                                        <!-- Explicit line heights: the default leading on two
                                             stacked lines is what makes the strip look tall. -->
                                        <TextBlock
                                            x:Name="TabTitleText"
                                            Text="{x:Bind Header, Mode=OneWay}"
                                            FontSize="13"
                                            LineHeight="17"
                                            LineStackingStrategy="BlockLineHeight"
                                            FontWeight="{x:Bind local:PresentationValues.TabHeaderFontWeight(HasUnseenOutput), Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Header, Mode=OneWay}">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{x:Bind local:PresentationValues.TabHeaderForegroundColor(AppTheme, IsActive, IsGroupFocused, IsPointerOver), Mode=OneWay}" />
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <TextBlock
                                            x:Name="TabSubtitleText"
                                            Text="{x:Bind Subtitle, Mode=OneWay}"
                                            FontSize="11"
                                            LineHeight="14"
                                            LineStackingStrategy="BlockLineHeight"
                                            TextTrimming="CharacterEllipsis"
                                            Opacity="0.7"
                                            ToolTipService.ToolTip="{x:Bind Subtitle, Mode=OneWay}">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{x:Bind local:PresentationValues.TabHeaderForegroundColor(AppTheme, IsActive, IsGroupFocused, IsPointerOver), Mode=OneWay}" />
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button
                                        Grid.Column="6"
                                        Click="TabCloseGlyph_Click"
                                        Padding="3"
                                        Margin="6,0,0,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Opacity="{x:Bind CloseOpacity, Mode=OneWay}"
                                        IsHitTestVisible="{x:Bind CloseInteractive, Mode=OneWay}"
                                        IsEnabled="{x:Bind CloseInteractive, Mode=OneWay}"
                                        IsTabStop="{x:Bind CloseInteractive, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind CloseAutomationName, Mode=OneWay}"
                                        AutomationProperties.AutomationId="{x:Bind CloseAutomationId, Mode=OneWay}">
                                        <FontIcon
                                            Glyph="&#xE711;"
                                            FontSize="10">
                                            <FontIcon.Foreground>
                                                <SolidColorBrush Color="{x:Bind local:PresentationValues.TabHeaderForegroundColor(AppTheme, IsActive, IsGroupFocused, IsPointerOver), Mode=OneWay}" />
                                            </FontIcon.Foreground>
                                        </FontIcon>
                                    </Button>
                                </Grid>
                            </Grid>
                        </TabViewItem.Header>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
            </TabView>
            <Grid
                x:Name="TabStripActions"
                Grid.Column="1"
                Height="44"
                Background="{ThemeResource TabViewBackground}">
                <Grid.Resources>
                    <!-- Tab-bar actions stay flat at rest. Hover and press reveal a small
                         surface; checked toggles use an accent glyph without a persistent
                         box. Theme-local aliases keep those states consistent in both themes. -->
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Dark">
                                <SolidColorBrush x:Key="TabActionButtonRestBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="TabActionButtonHoverBrush" Color="#1FFFFFFF" />
                                <SolidColorBrush x:Key="TabActionButtonPressedBrush" Color="#2AFFFFFF" />
                                <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="AccentTextFillColorPrimaryBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="AccentTextFillColorPrimaryBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="AccentTextFillColorSecondaryBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="AccentTextFillColorPrimaryBrush" />
                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentTextFillColorPrimaryBrush" />
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="TabActionButtonHoverBrush" />
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="TabActionButtonPressedBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="TabActionButtonHoverBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="TabActionButtonPressedBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="TabActionButtonRestBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="TabActionButtonHoverBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="TabActionButtonPressedBrush" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="TabActionButtonRestBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="TabActionButtonHoverBrush" Color="#14000000" />
                                <SolidColorBrush x:Key="TabActionButtonPressedBrush" Color="#22000000" />
                                <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="AccentTextFillColorPrimaryBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="AccentTextFillColorPrimaryBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="AccentTextFillColorSecondaryBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="AccentTextFillColorPrimaryBrush" />
                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentTextFillColorPrimaryBrush" />
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="TabActionButtonHoverBrush" />
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="TabActionButtonPressedBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="TabActionButtonHoverBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="TabActionButtonPressedBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="TabActionButtonRestBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="TabActionButtonHoverBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="TabActionButtonPressedBrush" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="HighContrast">
                                <SolidColorBrush x:Key="TabActionButtonRestBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="TabActionButtonHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                                <SolidColorBrush x:Key="TabActionButtonPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                                <SolidColorBrush x:Key="TabActionButtonForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TabActionButtonForegroundBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TabActionButtonForegroundBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TabActionButtonForegroundBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="TabActionButtonForegroundBrush" />
                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TabActionButtonForegroundBrush" />
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="TabActionButtonHoverBrush" />
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="TabActionButtonPressedBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="TabActionButtonHoverBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="TabActionButtonPressedBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="TabActionButtonRestBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="TabActionButtonHoverBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="TabActionButtonPressedBrush" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ResourceDictionary>
                </Grid.Resources>
                <StackPanel
                    x:Name="ExpandedTabActions"
                    Orientation="Horizontal"
                    Spacing="6"
                    Margin="0,0,6,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <ToggleButton
                        x:Name="RecordButton"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Click="RecordButton_Click"
                        ToolTipService.ToolTip="Start recording">
                        <Grid Width="10" Height="10">
                            <Ellipse
                                x:Name="RecordStartIcon"
                                Width="10"
                                Height="10"
                                Fill="{Binding Foreground, ElementName=RecordButton}" />
                            <Rectangle
                                x:Name="RecordStopIcon"
                                Width="10"
                                Height="10"
                                RadiusX="1"
                                RadiusY="1"
                                Fill="{Binding Foreground, ElementName=RecordButton}"
                                Visibility="Collapsed" />
                        </Grid>
                    </ToggleButton>
                    <ToggleButton
                        x:Name="RewindButton"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Click="RewindButton_Click"
                        ToolTipService.ToolTip="Instant rewind">
                        <FontIcon Glyph="&#xE81C;" FontSize="14" />
                    </ToggleButton>
                    <ToggleButton
                        x:Name="ShowCommandsButton"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Click="ShowCommandsButton_Click"
                        ToolTipService.ToolTip="Show commands (Ctrl+Shift+O)">
                        <!-- Segoe CommandPrompt glyph: the terminal page's typed-command
                             overview panel (annotated-scrollbar command marks). Checked
                             follows the page's reported panel state, not just clicks:
                             Ctrl+Shift+O and the panel's ✕ change it page-side. -->
                        <FontIcon Glyph="&#xE756;" FontSize="14" />
                    </ToggleButton>
                    <Button
                        x:Name="CurrentFolderButton"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Click="CurrentFolderButton_Click"
                        ToolTipService.ToolTip="Open file pane at terminal folder">
                        <!-- Folder with a ">_" prompt inside: the terminal's folder. The badge
                             sits in the glyph's empty interior so it works at 14–16px, and both
                             icon elements inherit Foreground for hover/disabled states. -->
                        <Grid Width="18" Height="18">
                            <FontIcon
                                Glyph="&#xE8B7;"
                                FontSize="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <PathIcon
                                Width="8.4"
                                Height="5.9"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,3,0,0"
                                Data="M0,1.1 L1.1,0 L3.9,2.8 L1.1,5.6 L0,4.5 L1.7,2.8 Z M4.9,4.5 L8.4,4.5 L8.4,5.9 L4.9,5.9 Z" />
                        </Grid>
                    </Button>
                    <ToggleButton
                        x:Name="FilePaneToggle"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Click="FilePaneToggle_Click"
                        ToolTipService.ToolTip="Show file pane (Ctrl+Shift+E)">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                    </ToggleButton>
                </StackPanel>
                <Button
                    x:Name="TabActionsOverflowButton"
                    Width="30"
                    Height="30"
                    Margin="0,0,6,0"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="More tab actions"
                    AutomationProperties.Name="More tab actions">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <ToggleMenuFlyoutItem
                                x:Name="RecordOverflowItem"
                                Text="Start recording"
                                Click="RecordButton_Click" />
                            <ToggleMenuFlyoutItem
                                x:Name="RewindOverflowItem"
                                Text="Instant rewind"
                                Click="RewindButton_Click" />
                            <ToggleMenuFlyoutItem
                                x:Name="ShowCommandsOverflowItem"
                                Text="Show commands"
                                Click="ShowCommandsButton_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                x:Name="CurrentFolderOverflowItem"
                                Text="Open file pane at terminal folder"
                                Click="CurrentFolderButton_Click" />
                            <ToggleMenuFlyoutItem
                                x:Name="FilePaneOverflowItem"
                                Text="Show file pane"
                                Click="FilePaneToggle_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <!-- Two overlay segments own the divider. Their widths follow the selected
                 container, leaving only the active tab open to the terminal surface. -->
            <Rectangle
                x:Name="LeftTabStripDivider"
                Grid.ColumnSpan="2"
                Canvas.ZIndex="1"
                Width="0"
                Height="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Fill="{ThemeResource CodeTabSeparatorBrush}"
                IsHitTestVisible="False" />
            <Rectangle
                x:Name="RightTabStripDivider"
                Grid.ColumnSpan="2"
                Canvas.ZIndex="1"
                Width="0"
                Height="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Fill="{ThemeResource CodeTabSeparatorBrush}"
                IsHitTestVisible="False" />
        </Grid>

        <Grid x:Name="TerminalHost" Grid.Row="1" />

        <!-- Visible only during an in-app tab drag. It sits above WebView2 so the XAML
             drag target stays reliable, while the rectangle previews the resulting group. -->
        <Grid
            x:Name="ContentDropSurface"
            Grid.Row="1"
            Background="Transparent"
            AllowDrop="True"
            Visibility="Collapsed"
            DragOver="ContentDropSurface_DragOver"
            DragLeave="ContentDropSurface_DragLeave"
            Drop="ContentDropSurface_Drop">
            <Rectangle
                x:Name="ContentDropOverlay"
                Margin="3"
                Fill="{ThemeResource TabDropOverlayBrush}"
                IsHitTestVisible="False"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
