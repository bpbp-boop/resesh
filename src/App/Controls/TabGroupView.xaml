<UserControl
    x:Class="Sessions.App.Controls.TabGroupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Sessions.App.ViewModels">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- VS Code-style tab strip: square flush tabs, active tab blends into the
                 terminal, inactive tabs dimmed. Scoped here so only this TabView changes. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TabViewBackground" Color="#181818" />
                    <SolidColorBrush x:Key="TabViewBorderBrush" Color="#181818" />
                    <!-- The header DataTemplate paints the whole tab; kill the built-in chrome. -->
                    <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="Transparent" />
                    <!-- WinUI's strip has 8px top padding (generic.xaml: TabViewHeaderPadding
                         0,8,0,0) which shoves tabs down and clips them; VS Code tabs sit flush. -->
                    <Thickness x:Key="TabViewHeaderPadding">0,0,0,0</Thickness>
                    <Thickness x:Key="TabViewItemHeaderPadding">0,0,0,0</Thickness>
                    <x:Double x:Key="TabViewItemMinHeight">40</x:Double>
                    <x:Double x:Key="TabViewItemHeaderMinHeight">40</x:Double>
                    <SolidColorBrush x:Key="CodeTabSeparatorBrush" Color="#2B2B2B" />
                    <!-- Matches VS Code's dark editor-group drop preview. -->
                    <SolidColorBrush x:Key="TabDropOverlayBrush" Color="#8053595D" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TabViewBackground" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="TabViewBorderBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="Transparent" />
                    <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="Transparent" />
                    <Thickness x:Key="TabViewHeaderPadding">0,0,0,0</Thickness>
                    <Thickness x:Key="TabViewItemHeaderPadding">0,0,0,0</Thickness>
                    <x:Double x:Key="TabViewItemMinHeight">40</x:Double>
                    <x:Double x:Key="TabViewItemHeaderMinHeight">40</x:Double>
                    <SolidColorBrush x:Key="CodeTabSeparatorBrush" Color="#D8D8D8" />
                    <SolidColorBrush x:Key="TabDropOverlayBrush" Color="#332677CB" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Minimal TabViewItem template: no chrome, no insets — the header
                 DataTemplate paints the entire tab, edge to edge. -->
            <Style x:Key="CodeTabStyle" TargetType="TabViewItem">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabViewItem">
                            <ContentPresenter
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tab strip only; terminals render in TerminalHost so WebView2 gets real space. -->
        <Grid
            x:Name="TabStripHost"
            Grid.Row="0"
            Background="Transparent"
            AllowDrop="True">
            <TabView
                x:Name="Tabs"
                Height="40"
                Margin="0"
                Padding="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Loaded="Tabs_Loaded"
                TabItemsSource="{x:Bind Group.Tabs}"
                SelectedItem="{x:Bind Group.SelectedTab, Mode=TwoWay}"
                SelectionChanged="Tabs_SelectionChanged"
                IsAddTabButtonVisible="False"
                TabWidthMode="SizeToContent"
                CanDragTabs="True"
                CanReorderTabs="True"
                TabCloseRequested="Tabs_TabCloseRequested"
                TabDragStarting="Tabs_TabDragStarting"
                TabDragCompleted="Tabs_TabDragCompleted"
                TabStripDragOver="Tabs_TabStripDragOver"
                TabStripDrop="Tabs_TabStripDrop">
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="vm:TabViewModel">
                    <TabViewItem
                        Style="{StaticResource CodeTabStyle}"
                        IsClosable="False"
                        Height="40">
                        <TabViewItem.Header>
                            <!-- The tab is painted entirely here: background, VS Code-style top
                                 accent on the active tab, and a custom close button. -->
                            <!-- The right border is the VS Code-style 1px divider between tabs. -->
                            <Grid
                                Height="40"
                                Margin="0"
                                Background="{x:Bind HeaderBackground, Mode=OneWay}"
                                BorderThickness="0,0,1,0"
                                BorderBrush="{ThemeResource CodeTabSeparatorBrush}"
                                PointerEntered="TabHeader_PointerEntered"
                                PointerExited="TabHeader_PointerExited">
                                <Rectangle
                                    Height="1"
                                    Fill="#0078D4"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Stretch"
                                    Visibility="{x:Bind AccentVisibility, Mode=OneWay}" />
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    Margin="10,0,6,0"
                                    VerticalAlignment="Center">
                                    <Rectangle
                                        Width="3"
                                        Height="22"
                                        RadiusX="1.5"
                                        RadiusY="1.5"
                                        VerticalAlignment="Center">
                                        <Rectangle.Fill>
                                            <SolidColorBrush Color="{x:Bind TagColor}" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Ellipse
                                        Width="7"
                                        Height="7"
                                        Margin="-3,0,3,0"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="{x:Bind StateText, Mode=OneWay}">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{x:Bind StateColor, Mode=OneWay}" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <!-- Tabs stay icon-free unless an agent is active. The
                                         attention badge stays attached to the agent icon. -->
                                    <Grid
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="{x:Bind AgentTooltip, Mode=OneWay}"
                                        Visibility="{x:Bind IconVisibility, Mode=OneWay}">
                                        <Image
                                            Source="{x:Bind IconSource, Mode=OneWay}"
                                            Width="16"
                                            Height="16" />
                                        <Border
                                            Width="{x:Bind AgentBadgeSize, Mode=OneWay}"
                                            Height="{x:Bind AgentBadgeSize, Mode=OneWay}"
                                            Margin="0,0,-2,-2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            CornerRadius="6"
                                            BorderThickness="1"
                                            BorderBrush="{x:Bind HeaderBackground, Mode=OneWay}"
                                            Visibility="{x:Bind AgentBadgeVisibility, Mode=OneWay}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{x:Bind AgentBadgeColor, Mode=OneWay}" />
                                            </Border.Background>
                                            <TextBlock
                                                Text="{x:Bind AgentBadgeGlyph, Mode=OneWay}"
                                                Foreground="White"
                                                FontSize="8"
                                                FontWeight="Bold"
                                                IsTextScaleFactorEnabled="False"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <FontIcon
                                        Glyph="&#xE840;"
                                        FontSize="11"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Pinned"
                                        Foreground="{x:Bind HeaderForeground, Mode=OneWay}"
                                        Visibility="{x:Bind PinIconVisibility, Mode=OneWay}" />
                                    <FontIcon
                                        Glyph="&#xE72E;"
                                        FontSize="11"
                                        VerticalAlignment="Center"
                                        Foreground="{x:Bind HeaderForeground, Mode=OneWay}"
                                        Visibility="{x:Bind LockIconVisibility, Mode=OneWay}" />
                                    <!-- Two lines: the session name, and whatever best identifies
                                         this particular tab (running program, cwd, or endpoint) —
                                         so several tabs of one host aren't interchangeable. -->
                                    <StackPanel VerticalAlignment="Center" Spacing="0">
                                        <!-- Explicit line heights: the default leading on two
                                             stacked lines is what makes the strip look tall. -->
                                        <TextBlock
                                            x:Name="TabTitleText"
                                            Text="{x:Bind Header, Mode=OneWay}"
                                            FontSize="13"
                                            LineHeight="17"
                                            LineStackingStrategy="BlockLineHeight"
                                            FontWeight="{x:Bind HeaderFontWeight, Mode=OneWay}"
                                            SizeChanged="TabTitleText_SizeChanged"
                                            Foreground="{x:Bind HeaderForeground, Mode=OneWay}" />
                                        <!-- MaxWidth is set from the title's width in code-behind:
                                             the subtitle is free text from the host and must never
                                             be what decides how wide the tab is. -->
                                        <TextBlock
                                            x:Name="TabSubtitleText"
                                            Text="{x:Bind Subtitle, Mode=OneWay}"
                                            FontSize="11"
                                            LineHeight="14"
                                            LineStackingStrategy="BlockLineHeight"
                                            TextTrimming="CharacterEllipsis"
                                            Opacity="0.7"
                                            ToolTipService.ToolTip="{x:Bind Subtitle, Mode=OneWay}"
                                            Foreground="{x:Bind HeaderForeground, Mode=OneWay}" />
                                    </StackPanel>
                                    <Button
                                        Click="TabCloseGlyph_Click"
                                        Padding="3"
                                        Margin="2,0,0,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Opacity="{x:Bind CloseOpacity, Mode=OneWay}"
                                        IsHitTestVisible="{x:Bind CloseInteractive, Mode=OneWay}">
                                        <FontIcon
                                            Glyph="&#xE711;"
                                            FontSize="10"
                                            Foreground="{x:Bind HeaderForeground, Mode=OneWay}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </TabViewItem.Header>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
            </TabView>
        </Grid>

        <Grid x:Name="TerminalHost" Grid.Row="1" />

        <!-- Visible only during an in-app tab drag. It sits above WebView2 so the XAML
             drag target stays reliable, while the rectangle previews the resulting group. -->
        <Grid
            x:Name="ContentDropSurface"
            Grid.Row="1"
            Background="Transparent"
            AllowDrop="True"
            Visibility="Collapsed"
            DragOver="ContentDropSurface_DragOver"
            DragLeave="ContentDropSurface_DragLeave"
            Drop="ContentDropSurface_Drop">
            <Rectangle
                x:Name="ContentDropOverlay"
                Margin="3"
                Fill="{ThemeResource TabDropOverlayBrush}"
                IsHitTestVisible="False"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
