<UserControl
    x:Class="Resesh.App.Controls.SessionAppearanceForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Resesh.App.Controls">

    <!-- The Appearance section both session editors share: the colour tag (the icon has its
         own tab) and the terminal settings a session can override. -->
    <StackPanel Spacing="12">
        <ComboBox x:Name="ColorBox" Header="Color tag" Width="280" HorizontalAlignment="Left" />

        <StackPanel Spacing="2" Margin="0,4,0,0">
            <TextBlock
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="Appearance overrides" />
            <TextBlock
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Blank fields use the app-wide setting."
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="OverrideThemeBox" Grid.Column="0" Header="Theme" HorizontalAlignment="Stretch" />
            <controls:FontFamilyPicker x:Name="OverrideFontFamilyBox" Grid.Column="1" Header="Terminal font" ShowAppSettingChoice="True" PlaceholderText="Use app setting" />
        </Grid>

        <!-- Minimum and Maximum come from SettingRanges, set in code. -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <NumberBox
                x:Name="OverrideFontSizeBox"
                Grid.Column="0"
                Header="Font size"
                PlaceholderText="(app setting)"
                SpinButtonPlacementMode="Compact" />
            <NumberBox
                x:Name="OverrideScrollbackBox"
                Grid.Column="1"
                Header="Scrollback lines"
                PlaceholderText="(app setting)"
                SmallChange="1000"
                SpinButtonPlacementMode="Compact" />
        </Grid>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="OverrideRecordingBox"
                Grid.Column="0"
                Header="Automatic recording"
                SelectedIndex="0"
                HorizontalAlignment="Stretch">
                <x:String>Use app setting</x:String>
                <x:String>Always record</x:String>
                <x:String>Never record</x:String>
            </ComboBox>
            <ComboBox
                x:Name="OverrideHistoryBox"
                Grid.Column="1"
                Header="Command history"
                SelectedIndex="0"
                HorizontalAlignment="Stretch">
                <x:String>Use app setting</x:String>
                <x:String>Keep history</x:String>
                <x:String>Don't keep history</x:String>
            </ComboBox>
        </Grid>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="OverrideMouseBox"
                Grid.Column="0"
                Header="Mouse in programs"
                HorizontalAlignment="Stretch" />
        </Grid>
    </StackPanel>
</UserControl>
