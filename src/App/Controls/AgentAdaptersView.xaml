<UserControl
    x:Class="Resesh.App.Controls.AgentAdaptersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Resesh.App.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <FontFamily x:Key="CodeFont">Cascadia Mono, Consolas</FontFamily>
    </UserControl.Resources>

    <StackPanel Spacing="4">
        <TextBlock
            Margin="1,0,0,6"
            Opacity="0.75"
            TextWrapping="Wrap"
            Text="Manual setup: copy an adapter to the target shown below. resesh does not install adapters or change any host. An adapter only reports status; it cannot approve requests or send input." />

        <!-- One adapter per expander: its destination stays visible and Copy works without
             expanding; the explanation and code stay behind the chevron. -->
        <ItemsControl ItemsSource="{x:Bind Adapters}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:AgentAdapterItem">
                    <toolkit:SettingsExpander
                        Header="{x:Bind Title}"
                        IsExpanded="False"
                        AutomationProperties.AutomationId="{x:Bind AutomationId}">
                        <toolkit:SettingsExpander.Description>
                            <TextBlock
                                Text="{x:Bind Target}"
                                TextWrapping="Wrap"
                                FontFamily="{StaticResource CodeFont}"
                                FontSize="12" />
                        </toolkit:SettingsExpander.Description>
                        <Button
                            MinWidth="72"
                            Content="Copy"
                            Tag="{x:Bind}"
                            AutomationProperties.AutomationId="{x:Bind CopyAutomationId}"
                            Click="Copy_Click" />
                        <toolkit:SettingsExpander.ItemsHeader>
                            <StackPanel Padding="16,12" Spacing="10">
                                <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Opacity="0.78" />
                                <!-- A selectable TextBlock, not a TextBox: a TextBox measures
                                     programmatically set multi-line text as one line. -->
                                <Border Style="{StaticResource PreviewSurfaceStyle}">
                                    <ScrollViewer
                                        MaxHeight="190"
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Auto">
                                        <TextBlock
                                            Text="{x:Bind Text}"
                                            IsTextSelectionEnabled="True"
                                            TextWrapping="NoWrap"
                                            FontFamily="{StaticResource CodeFont}"
                                            FontSize="12" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </toolkit:SettingsExpander.ItemsHeader>
                    </toolkit:SettingsExpander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <toolkit:SettingsExpander
            Header="Protocol reference"
            Description="For custom integrations"
            AutomationProperties.AutomationId="SettingsAgentProtocolReference">
            <toolkit:SettingsExpander.ItemsHeader>
                <Border Margin="16,12" Style="{StaticResource PreviewSurfaceStyle}">
                    <TextBlock
                        Text="{x:Bind ProtocolReference}"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap"
                        FontFamily="{StaticResource CodeFont}"
                        FontSize="12" />
                </Border>
            </toolkit:SettingsExpander.ItemsHeader>
        </toolkit:SettingsExpander>
    </StackPanel>
</UserControl>
