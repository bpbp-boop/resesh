<UserControl
    x:Class="Resesh.App.Controls.IconPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Resesh.App"
    xmlns:controls="using:Resesh.App.Controls">

    <!-- A filter (with an optional control beside it), then the icons that match it in titled
         sections. Each cell draws one of: a font glyph, a 16×16 path, an image (a brand mark
         or a custom file), or a few letters. -->
    <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBox
                x:Name="FilterBox"
                PlaceholderText="Filter icons (server, mysql, k8s…)"
                TextChanged="FilterBox_TextChanged"
                KeyDown="FilterBox_KeyDown"
                AutomationProperties.Name="Filter icons" />
            <ContentPresenter x:Name="HeaderHost" Grid.Column="1" VerticalAlignment="Center" />
        </Grid>

        <GridView
            x:Name="IconGrid"
            Grid.Row="1"
            SelectionMode="Single"
            SelectionChanged="IconGrid_SelectionChanged"
            AutomationProperties.Name="Icon">
            <GridView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="controls:IconPickerGroup">
                            <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </GridView.GroupStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="controls:IconPickerChoice">
                    <Grid
                        Width="48"
                        Height="48"
                        ToolTipService.ToolTip="{x:Bind Name}"
                        AutomationProperties.Name="{x:Bind Name}">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="22" />
                        <Image Source="{x:Bind Image}" Width="24" Height="24" />
                        <Viewbox Width="22" Height="22">
                            <Path
                                Width="16"
                                Height="16"
                                Data="{x:Bind app:PresentationValues.IconPathGeometry(Path)}"
                                Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                StrokeThickness="1"
                                StrokeLineJoin="Round" />
                        </Viewbox>
                        <TextBlock
                            Text="{x:Bind Text}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <TextBlock
            x:Name="NoMatchText"
            Grid.Row="1"
            Text="No icons match."
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
