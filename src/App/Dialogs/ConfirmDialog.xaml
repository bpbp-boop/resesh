<ContentDialog
    x:Class="Resesh.App.Dialogs.ConfirmDialog"
    Style="{StaticResource DefaultContentDialogStyle}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Cancel"
    DefaultButton="Close">

    <StackPanel MaxWidth="480" Spacing="8">
        <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" />
        <!-- An optional extra action taken on confirm, such as ending a persistent session. -->
        <CheckBox
            x:Name="OptionBox"
            Content="{x:Bind OptionText}"
            Visibility="{x:Bind HasOption}" />
        <TextBlock
            Text="{x:Bind Note}"
            TextWrapping="Wrap"
            Opacity="0.72"
            Visibility="{x:Bind HasNote}" />
    </StackPanel>
</ContentDialog>
