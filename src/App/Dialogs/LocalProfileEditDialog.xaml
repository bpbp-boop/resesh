<ContentDialog
    x:Class="Resesh.App.Dialogs.LocalProfileEditDialog"
    Style="{StaticResource DefaultContentDialogStyle}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:Resesh.App.Icons"
    xmlns:controls="using:Resesh.App.Controls"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <!-- Laid out like the SSH session editor: same width, same tabs-over-a-fixed-host shape,
         so the two dialogs feel like one form. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">660</x:Double>
    </ContentDialog.Resources>

    <StackPanel x:Name="ProfileForm" Spacing="12" Width="600">
        <SelectorBar x:Name="SectionBar" SelectionChanged="SectionBar_SelectionChanged">
            <SelectorBarItem x:Name="ShellSection" Text="Shell" IsSelected="True" />
            <SelectorBarItem x:Name="AppearanceSection" Text="Appearance" />
            <SelectorBarItem x:Name="IconSection" Text="Icon" />
            <SelectorBarItem x:Name="NotesSection" Text="Notes" />
        </SelectorBar>

        <!-- A fixed height keeps the dialog from resizing as sections change. Each
             section scrolls inside it, so a short window still reaches every field. -->
        <Grid x:Name="SectionHost" Height="440">
            <ScrollViewer
                x:Name="ShellPanel"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="0,0,12,0">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBox x:Name="NameBox" Header="Name" PlaceholderText="PowerShell" />
                            <TextBlock x:Name="NameError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <ComboBox
                            x:Name="FolderBox"
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Header="Folder (under Local)"
                            IsEditable="True"
                            PlaceholderText="(Local)"
                            HorizontalAlignment="Stretch" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBox x:Name="ExecutableBox" Header="Executable" PlaceholderText="%SystemRoot%\System32\cmd.exe" />
                            <TextBlock x:Name="ExecutableError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <TextBox x:Name="StartDirBox" Grid.Column="1" VerticalAlignment="Top" Header="Starting directory" PlaceholderText="Your user profile folder" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBox
                                x:Name="ArgumentsBox"
                                Header="Arguments"
                                Height="96"
                                AcceptsReturn="True"
                                TextWrapping="NoWrap"
                                ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            <TextBlock
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="One per line. No quoting needed."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBox
                                x:Name="EnvironmentBox"
                                Header="Environment"
                                Height="96"
                                AcceptsReturn="True"
                                TextWrapping="NoWrap"
                                ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            <TextBlock
                                x:Name="EnvironmentHint"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="NAME=value per line. An empty value removes the variable."
                                TextWrapping="Wrap" />
                            <TextBlock x:Name="EnvironmentError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4">
                        <ToggleSwitch
                            x:Name="ShellIntegrationSwitch"
                            Header="Shell integration (experimental)"
                            AutomationProperties.AutomationId="LocalShellIntegrationToggle" />
                        <TextBlock
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Detects Bash, Zsh, Fish and PowerShell when a new terminal starts, and reports commands and the working directory without editing shell profiles."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="MakeDefaultBox" Grid.Column="0" Content="Default local profile (Ctrl+Shift+T)" />
                        <Button
                            x:Name="ResetButton"
                            Grid.Column="1"
                            Content="Reset to discovered defaults"
                            Visibility="Collapsed"
                            Click="Reset_Click" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer
                x:Name="AppearancePanel"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="0,0,12,0"
                Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <!-- The icon has its own tab; the colour tag stays with the appearance settings. -->
                    <ComboBox x:Name="ColorBox" Header="Color tag" SelectedIndex="0" Width="280" HorizontalAlignment="Left" />

                    <StackPanel Spacing="2" Margin="0,4,0,0">
                        <TextBlock
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="Appearance overrides" />
                        <TextBlock
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Blank fields use the app-wide setting."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="OverrideThemeBox" Grid.Column="0" Header="Theme" SelectedIndex="0" HorizontalAlignment="Stretch" />
                        <controls:FontFamilyPicker x:Name="OverrideFontFamilyBox" Grid.Column="1" Header="Terminal font" ShowAppSettingChoice="True" PlaceholderText="Use app setting" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox
                            x:Name="OverrideFontSizeBox"
                            Grid.Column="0"
                            Header="Font size"
                            PlaceholderText="(app setting)"
                            Minimum="8"
                            Maximum="32"
                            SpinButtonPlacementMode="Compact" />
                        <NumberBox
                            x:Name="OverrideScrollbackBox"
                            Grid.Column="1"
                            Header="Scrollback lines"
                            PlaceholderText="(app setting)"
                            Minimum="1000"
                            Maximum="100000"
                            SmallChange="1000"
                            SpinButtonPlacementMode="Compact" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="OverrideRecordingBox" Grid.Column="0" Header="Automatic recording" SelectedIndex="0" HorizontalAlignment="Stretch">
                            <x:String>Use app setting</x:String>
                            <x:String>Always record</x:String>
                            <x:String>Never record</x:String>
                        </ComboBox>
                        <ComboBox x:Name="OverrideHistoryBox" Grid.Column="1" Header="Command history" SelectedIndex="0" HorizontalAlignment="Stretch">
                            <x:String>Use app setting</x:String>
                            <x:String>Keep history</x:String>
                            <x:String>Don't keep history</x:String>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- The shared icon picker; custom files in the icons folder appear in "Your icons". -->
            <Grid x:Name="IconPanel" RowDefinitions="*,Auto" RowSpacing="8" Visibility="Collapsed">
                <controls:IconPicker x:Name="IconPicker" />
                <TextBlock
                    Grid.Row="1"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Drop your own PNG or SVG files into %APPDATA%\Resesh\icons\ and they appear under Your icons."
                    TextWrapping="Wrap" />
            </Grid>
            <TextBox
                x:Name="NotesBox"
                Header="Notes"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                VerticalAlignment="Stretch"
                Visibility="Collapsed" />
        </Grid>
    </StackPanel>
</ContentDialog>
