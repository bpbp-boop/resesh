<ContentDialog
    x:Class="Resesh.App.Dialogs.TextPromptDialog"
    Style="{StaticResource DefaultContentDialogStyle}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="OK"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <!-- One field: plain text for names, or a password box for secrets. -->
    <Grid MinWidth="360">
        <TextBox
            x:Name="TextField"
            Header="{x:Bind FieldHeader}"
            PlaceholderText="{x:Bind Placeholder}"
            Visibility="{x:Bind IsText}" />
        <PasswordBox
            x:Name="PasswordField"
            Header="{x:Bind FieldHeader}"
            PasswordRevealMode="Peek"
            Visibility="{x:Bind IsPassword}" />
    </Grid>
</ContentDialog>
