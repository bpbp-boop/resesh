<ContentDialog
    x:Class="Sessions.App.Dialogs.ExportBackupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Export backup"
    PrimaryButtonText="Choose file"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="12" MinWidth="500">
        <TextBlock
            Text="The backup includes sessions, folders, settings, known hosts, registered SSH key references, highlight rules, custom icons, and workspaces when present. Private-key files and recordings are not included."
            TextWrapping="Wrap" />
        <ComboBox
            x:Name="ScopeBox"
            Header="Sessions to export"
            ItemsSource="{x:Bind Scopes}"
            DisplayMemberPath="Label"
            HorizontalAlignment="Stretch" />
        <CheckBox
            x:Name="IncludeSecretsCheck"
            Content="Include passwords and key passphrases"
            Click="IncludeSecrets_Click" />
        <StackPanel x:Name="PassphrasePanel" Spacing="8" Visibility="Collapsed">
            <InfoBar
                IsOpen="True"
                Severity="Warning"
                Message="The complete backup will be encrypted. You cannot recover it if you lose the passphrase." />
            <PasswordBox x:Name="PassphraseBox" Header="Backup passphrase" PasswordRevealMode="Peek" />
            <PasswordBox x:Name="ConfirmPassphraseBox" Header="Confirm passphrase" PasswordRevealMode="Peek" />
            <TextBlock
                x:Name="ValidationText"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Visibility="Collapsed"
                TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
