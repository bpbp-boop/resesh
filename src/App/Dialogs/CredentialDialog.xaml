<ContentDialog
    x:Class="Resesh.App.Dialogs.CredentialDialog"
    Style="{StaticResource DefaultContentDialogStyle}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Connect"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel MinWidth="360" Spacing="12">
        <PasswordBox x:Name="SecretBox" Header="{x:Bind Prompt}" />
        <CheckBox x:Name="SaveBox" Content="Save in Windows Credential Manager" IsChecked="True" />
    </StackPanel>
</ContentDialog>
