<ContentDialog
    x:Class="Resesh.App.Dialogs.WorkspaceIconDialog"
    Style="{StaticResource DefaultContentDialogStyle}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Resesh.App.Controls"
    Title="Workspace Icon"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <!-- Room for a wide grid of sections; the default caps dialogs at 548 px. -->
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
    </ContentDialog.Resources>

    <!-- The chosen icon and its name with the workspace's initials, then the shared picker,
         with whether the initials label the icon beside its filter. -->
    <StackPanel Width="600" Spacing="12">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Grid Width="48" Height="48">
                <StackPanel x:Name="PreviewIcon" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="1">
                    <Grid Width="24" Height="24" HorizontalAlignment="Center">
                        <FontIcon x:Name="PreviewGlyph" FontSize="24" />
                        <Image x:Name="PreviewBrand" Width="24" Height="24" />
                        <Viewbox Width="24" Height="24">
                            <Path
                                x:Name="PreviewPath"
                                Width="16"
                                Height="16"
                                Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                StrokeThickness="1"
                                StrokeLineJoin="Round" />
                        </Viewbox>
                    </Grid>
                    <TextBlock
                        x:Name="PreviewCaption"
                        FontSize="11"
                        FontWeight="SemiBold"
                        LineHeight="12"
                        LineStackingStrategy="BlockLineHeight"
                        HorizontalAlignment="Center" />
                </StackPanel>
                <TextBlock
                    x:Name="PreviewMonogram"
                    FontSize="17"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    x:Name="PreviewName"
                    TextTrimming="CharacterEllipsis"
                    Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    x:Name="PreviewIconName"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <!-- Typing initials picks Initials unless they label an icon; the placeholder shows
                 the ones from the name. -->
            <TextBox
                x:Name="InitialsBox"
                Grid.Column="2"
                Width="76"
                VerticalAlignment="Center"
                TextChanged="InitialsBox_TextChanged"
                ToolTipService.ToolTip="Up to 3 characters, shown in place of an icon or under it"
                AutomationProperties.Name="Initials" />
        </Grid>

        <controls:IconPicker
            x:Name="Picker"
            Height="496"
            SelectionChanged="Picker_SelectionChanged"
            Committed="Picker_Committed">
            <controls:IconPicker.HeaderContent>
                <CheckBox
                    x:Name="LabelIconBox"
                    Content="Show initials under the icon"
                    Checked="LabelIconBox_Changed"
                    Unchecked="LabelIconBox_Changed" />
            </controls:IconPicker.HeaderContent>
        </controls:IconPicker>
    </StackPanel>
</ContentDialog>
