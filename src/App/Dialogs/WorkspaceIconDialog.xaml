<ContentDialog
    x:Class="Resesh.App.Dialogs.WorkspaceIconDialog"
    Style="{StaticResource DefaultContentDialogStyle}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Resesh.App"
    xmlns:dialogs="using:Resesh.App.Dialogs"
    Title="Workspace Icon"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <!-- The chosen icon and its name with the workspace's initials, a filter, then the icons
         that match it. Icons are
         drawn as in the rail: a font glyph, or a 16×16 path for one the font lacks. -->
    <StackPanel Width="312" Spacing="12">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Grid Width="40" Height="40">
                <FontIcon x:Name="PreviewGlyph" FontSize="20" />
                <Viewbox Width="20" Height="20">
                    <Path
                        x:Name="PreviewPath"
                        Width="16"
                        Height="16"
                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                        StrokeThickness="1"
                        StrokeLineJoin="Round" />
                </Viewbox>
                <TextBlock
                    x:Name="PreviewMonogram"
                    FontSize="15"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    x:Name="PreviewName"
                    TextTrimming="CharacterEllipsis"
                    Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    x:Name="PreviewIconName"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <!-- Typing initials picks Initials; the placeholder shows the ones from the name. -->
            <TextBox
                x:Name="InitialsBox"
                Grid.Column="2"
                Width="76"
                VerticalAlignment="Center"
                TextChanged="InitialsBox_TextChanged"
                ToolTipService.ToolTip="Up to 3 characters shown when there is no icon"
                AutomationProperties.Name="Initials" />
        </Grid>

        <TextBox
            x:Name="FilterBox"
            PlaceholderText="Filter icons (server, sql, k8s…)"
            TextChanged="FilterBox_TextChanged"
            KeyDown="FilterBox_KeyDown"
            AutomationProperties.Name="Filter icons" />

        <!-- A fixed height keeps the dialog from jumping while the filter narrows the grid. -->
        <Grid Height="296">
            <GridView
                x:Name="IconGrid"
                SelectionMode="Single"
                SelectionChanged="IconGrid_SelectionChanged"
                AutomationProperties.Name="Workspace icon">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="dialogs:WorkspaceIconChoice">
                        <Grid
                            Width="40"
                            Height="40"
                            ToolTipService.ToolTip="{x:Bind Name}"
                            AutomationProperties.Name="{x:Bind Name}">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" />
                            <Viewbox Width="18" Height="18">
                                <Path
                                    Width="16"
                                    Height="16"
                                    Data="{x:Bind app:PresentationValues.IconPathGeometry(Path)}"
                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                    StrokeThickness="1"
                                    StrokeLineJoin="Round" />
                            </Viewbox>
                            <TextBlock
                                Text="{x:Bind Text}"
                                FontSize="13"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <TextBlock
                x:Name="NoMatchText"
                Text="No icons match."
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="Collapsed" />
        </Grid>
    </StackPanel>
</ContentDialog>
