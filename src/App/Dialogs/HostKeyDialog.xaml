<ContentDialog
    x:Class="Resesh.App.Dialogs.HostKeyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <Style x:Key="FingerprintText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
    </ContentDialog.Resources>

    <Grid>
        <!-- First connection: show the offered key so it can be checked out of band. -->
        <StackPanel MinWidth="420" Spacing="8" Visibility="{x:Bind IsFirstContact}">
            <TextBlock Text="{x:Bind FirstContactMessage}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind KeyTypeLine}" FontFamily="Consolas" />
            <TextBlock Text="{x:Bind OfferedFingerprint}" Style="{StaticResource FingerprintText}" />
        </StackPanel>

        <!-- Changed key: both fingerprints, and a typed host name before Replace enables. -->
        <StackPanel MinWidth="460" Spacing="8" Visibility="{x:Bind IsMismatch}">
            <TextBlock Text="{x:Bind MismatchMessage}" TextWrapping="Wrap" />
            <TextBlock Text="Previously trusted:" FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind PreviousKeyLine}" Style="{StaticResource FingerprintText}" />
            <TextBlock Text="Offered now:" FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind OfferedKeyLine}" Style="{StaticResource FingerprintText}" />
            <TextBox
                x:Name="ConfirmBox"
                Header="{x:Bind ConfirmHeader}"
                PlaceholderText="{x:Bind Host}"
                TextChanged="ConfirmBox_TextChanged" />
        </StackPanel>
    </Grid>
</ContentDialog>
