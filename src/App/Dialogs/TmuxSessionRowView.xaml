<UserControl
    x:Class="Resesh.App.Dialogs.TmuxSessionRowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch">

    <Grid>
        <!-- A running shell: folder, then program · slot · age, with a state badge. -->
        <Grid
            Margin="0,6"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="12"
            Visibility="{x:Bind Item.IsSession, Mode=OneWay}">
            <StackPanel Spacing="2">
                <TextBlock
                    Text="{x:Bind Item.Folder, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Item.Folder, Mode=OneWay}"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Text="{x:Bind Item.Detail, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{StaticResource SessionTreeMutedForegroundBrush}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <Border
                    Padding="6,1,6,2"
                    CornerRadius="4"
                    BorderThickness="1"
                    Background="{StaticResource SessionInputBrush}"
                    BorderBrush="{StaticResource SessionChromeFrameBrush}">
                    <TextBlock Text="{x:Bind Item.State, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
                <!-- Attached elsewhere: a caution outline over the frame. A ThemeResource, so it
                     follows the dialog's theme rather than the theme the app started in. -->
                <Border
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                    Visibility="{x:Bind Item.IsAttachedElsewhere, Mode=OneWay}" />
            </Grid>
        </Grid>

        <!-- The "start a new shell" option. -->
        <StackPanel
            Margin="0,8"
            Orientation="Horizontal"
            Spacing="10"
            Visibility="{x:Bind Item.IsNew, Mode=OneWay}">
            <FontIcon Glyph="&#xE710;" FontSize="14" />
            <TextBlock Text="{x:Bind Item.Folder, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
