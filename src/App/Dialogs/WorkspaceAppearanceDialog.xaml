<ContentDialog
    x:Class="Resesh.App.Dialogs.WorkspaceAppearanceDialog"
    Style="{StaticResource DefaultContentDialogStyle}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:Resesh.App.Icons"
    Title="Icon and Color"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <!-- The rail button as it will look, then the two choices that shape it. -->
    <StackPanel MinWidth="380" Spacing="16">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Border
                x:Name="PreviewTile"
                Width="40"
                Height="40"
                CornerRadius="10">
                <Grid>
                    <TextBlock
                        x:Name="PreviewMonogram"
                        FontSize="15"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    <Image
                        x:Name="PreviewIcon"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
            <TextBlock
                x:Name="PreviewName"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis"
                Style="{ThemeResource BodyStrongTextBlockStyle}" />
        </StackPanel>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Bottom">
                <TextBlock Text="Icon" />
                <DropDownButton
                    x:Name="IconButton"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    AutomationProperties.Name="Workspace icon">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image x:Name="IconButtonImage" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock x:Name="IconButtonText" VerticalAlignment="Center" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <Flyout x:Name="IconFlyout" Placement="Bottom">
                            <GridView
                                x:Name="IconGrid"
                                MaxWidth="340"
                                MaxHeight="300"
                                SelectionMode="None"
                                IsItemClickEnabled="True"
                                ItemClick="IconGrid_ItemClick">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="icons:IconChoice">
                                        <Grid Width="36" Height="36" ToolTipService.ToolTip="{x:Bind Name}">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{x:Bind Image}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
            <ComboBox
                x:Name="ColorBox"
                Grid.Column="1"
                Header="Color"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                SelectionChanged="ColorBox_SelectionChanged" />
        </Grid>

        <TextBlock
            Style="{ThemeResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Without an icon the button shows the workspace's initials. Drop your own PNG or SVG files into %APPDATA%\Resesh\icons\ and they appear in the picker."
            TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
