<ContentDialog
    x:Class="Resesh.App.Dialogs.SessionEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:Resesh.App.Icons"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ContentDialog.Resources>
        <!-- The stock cap is 548, which the 500-wide content plus the dialog's own
             horizontal padding already exceeded: the columns had nothing to spare and
             the widest captions ran into the edge. -->
        <x:Double x:Key="ContentDialogMaxWidth">660</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="12" MinWidth="580" MaxWidth="600">
        <TextBlock
            x:Name="ValidationText"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <InfoBar x:Name="NoticeBar" IsOpen="False" IsClosable="False" Severity="Informational" />

        <SelectorBar x:Name="SectionBar" SelectionChanged="SectionBar_SelectionChanged">
            <SelectorBarItem x:Name="ConnectionSection" Text="Connection" IsSelected="True" />
            <SelectorBarItem x:Name="TerminalSection" Text="Terminal" />
            <SelectorBarItem x:Name="NotesSection" Text="Notes" />
        </SelectorBar>

        <!-- A fixed height keeps the dialog from resizing as sections change. Each
             section scrolls inside it, so a tall one is reachable instead of clipped. -->
        <Grid Height="480">
            <ScrollViewer
                x:Name="ConnectionPanel"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="0,0,12,0">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NameBox" Grid.Column="0" Header="Name" PlaceholderText="prod-web-01" />
                        <ComboBox
                            x:Name="FolderBox"
                            Grid.Column="1"
                            Header="Folder"
                            IsEditable="True"
                            PlaceholderText="(root)"
                            HorizontalAlignment="Stretch" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HostBox" Grid.Column="0" Header="Host" PlaceholderText="10.0.0.1 or host.example.com" />
                        <NumberBox
                            x:Name="PortBox"
                            Grid.Column="1"
                            Header="Port"
                            Minimum="1"
                            Maximum="65535"
                            SpinButtonPlacementMode="Compact"
                            Value="22" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="UsernameBox" Grid.Column="0" Header="Username" PlaceholderText="admin" />
                        <ComboBox
                            x:Name="AuthBox"
                            Grid.Column="1"
                            Header="Authentication"
                            SelectedIndex="0"
                            SelectionChanged="AuthBox_SelectionChanged"
                            HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Password" />
                            <ComboBoxItem Content="Private key" />
                            <ComboBoxItem Content="None" />
                        </ComboBox>
                    </Grid>

                    <Grid x:Name="KeyPathPanel" ColumnSpacing="12" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="KeyBox"
                            Grid.Column="0"
                            Header="SSH key"
                            DisplayMemberPath="Label"
                            PlaceholderText="Select a registered key"
                            HorizontalAlignment="Stretch" />
                        <Button
                            Grid.Column="1"
                            Content="Add…"
                            VerticalAlignment="Bottom"
                            Click="AddKey_Click" />
                    </Grid>

                    <StackPanel x:Name="PasswordPanel" Spacing="4">
                        <PasswordBox x:Name="PasswordBox" Header="Password" />
                        <TextBlock
                            x:Name="PasswordHint"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Stored in Windows Credential Manager"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock
                        x:Name="KeyHint"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Resesh keeps a reference to the key in its current location. Manage registered keys from the File menu."
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer
                x:Name="TerminalPanel"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="0,0,12,0"
                Visibility="Collapsed">
                <StackPanel Spacing="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="TerminalTypeBox"
                        Grid.Column="0"
                        Header="Terminal type"
                        IsEditable="True"
                        SelectedIndex="0"
                        HorizontalAlignment="Stretch">
                        <x:String>xterm-256color</x:String>
                        <x:String>xterm</x:String>
                        <x:String>vt220</x:String>
                        <x:String>vt100</x:String>
                        <x:String>linux</x:String>
                    </ComboBox>
                    <ComboBox x:Name="ColorBox" Grid.Column="1" Header="Color tag" SelectedIndex="0" HorizontalAlignment="Stretch" />
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="Icon" />
                        <DropDownButton x:Name="IconButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image x:Name="IconButtonImage" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock x:Name="IconButtonText" VerticalAlignment="Center" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <Flyout x:Name="IconFlyout" Placement="Bottom">
                                    <GridView
                                        x:Name="IconGrid"
                                        MaxWidth="340"
                                        MaxHeight="300"
                                        SelectionMode="None"
                                        IsItemClickEnabled="True"
                                        ItemClick="IconGrid_ItemClick">
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="icons:IconChoice">
                                                <Grid Width="36" Height="36" ToolTipService.ToolTip="{x:Bind Name}">
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image Source="{x:Bind Image}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Drop your own PNG/SVG files into %APPDATA%\Resesh\icons\ and they appear in the picker."
                        TextWrapping="Wrap"
                        VerticalAlignment="Bottom" />
                </Grid>

                <StackPanel Spacing="4">
                    <ToggleSwitch x:Name="PersistentToggle" Header="Persistent session" />
                    <TextBlock
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Runs the shell inside tmux on the host, so it survives dropped connections and app restarts — reconnecting resumes right where you left off. Requires tmux on the host."
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="2" Margin="0,4,0,0">
                    <TextBlock
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="Appearance overrides" />
                    <TextBlock
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Blank fields use the app-wide setting."
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="OverrideThemeBox" Grid.Column="0" Header="Theme" SelectedIndex="0" HorizontalAlignment="Stretch" />
                    <TextBox x:Name="OverrideFontFamilyBox" Grid.Column="1" Header="Terminal font family" PlaceholderText="(app setting)" />
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox
                        x:Name="OverrideFontSizeBox"
                        Grid.Column="0"
                        Header="Font size"
                        PlaceholderText="(app setting)"
                        Minimum="8"
                        Maximum="32"
                        SpinButtonPlacementMode="Compact" />
                    <NumberBox
                        x:Name="OverrideScrollbackBox"
                        Grid.Column="1"
                        Header="Scrollback lines"
                        PlaceholderText="(app setting)"
                        Minimum="1000"
                        Maximum="100000"
                        SmallChange="1000"
                        SpinButtonPlacementMode="Compact" />
                </Grid>
                <ComboBox
                    x:Name="OverrideRecordingBox"
                    Header="Automatic recording"
                    SelectedIndex="0"
                    HorizontalAlignment="Stretch">
                    <x:String>Use app setting</x:String>
                    <x:String>Always record</x:String>
                    <x:String>Never record</x:String>
                </ComboBox>
                </StackPanel>
            </ScrollViewer>

            <TextBox
                x:Name="NotesBox"
                Header="Notes"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                VerticalAlignment="Stretch"
                Visibility="Collapsed" />
        </Grid>
    </StackPanel>
</ContentDialog>
