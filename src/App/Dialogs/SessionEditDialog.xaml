<ContentDialog
    x:Class="Sessions.App.Dialogs.SessionEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
        <StackPanel Spacing="12" MinWidth="380">
            <TextBlock
                x:Name="ValidationText"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Visibility="Collapsed" />

            <InfoBar x:Name="NoticeBar" IsOpen="False" IsClosable="False" Severity="Informational" />

            <TextBox x:Name="NameBox" Header="Name" PlaceholderText="prod-web-01" />

            <ComboBox
                x:Name="FolderBox"
                Header="Folder"
                IsEditable="True"
                PlaceholderText="(root) — e.g. Datacenter/Rack 4"
                HorizontalAlignment="Stretch" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="HostBox" Grid.Column="0" Header="Host" PlaceholderText="10.0.0.1 or host.example.com" />
                <NumberBox
                    x:Name="PortBox"
                    Grid.Column="1"
                    Header="Port"
                    Minimum="1"
                    Maximum="65535"
                    SpinButtonPlacementMode="Compact"
                    Value="22" />
            </Grid>

            <TextBox x:Name="UsernameBox" Header="Username" PlaceholderText="admin" />

            <ComboBox x:Name="AuthBox" Header="Authentication" SelectedIndex="0" SelectionChanged="AuthBox_SelectionChanged" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Password" />
                <ComboBoxItem Content="Private key" />
                <ComboBoxItem Content="None" />
            </ComboBox>

            <PasswordBox
                x:Name="PasswordBox"
                Header="Password"
                PlaceholderText="Stored in Windows Credential Manager — leave blank to keep current" />

            <TextBox
                x:Name="KeyPathBox"
                Header="Private key file"
                PlaceholderText="C:\Users\you\.ssh\id_ed25519"
                Visibility="Collapsed" />
            <CheckBox x:Name="PassphraseCheck" Content="Key requires a passphrase" Visibility="Collapsed" />

            <ComboBox x:Name="ColorBox" Header="Color tag" SelectedIndex="0" HorizontalAlignment="Stretch" />

            <TextBox x:Name="TerminalTypeBox" Header="Terminal type" Text="xterm-256color" />

            <TextBox
                x:Name="NotesBox"
                Header="Notes"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                Height="72" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
