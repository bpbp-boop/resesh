<ContentDialog
    x:Class="Sessions.App.Dialogs.SessionEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <StackPanel Spacing="12">
        <TextBlock
            x:Name="ValidationText"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <InfoBar x:Name="NoticeBar" IsOpen="False" IsClosable="False" Severity="Informational" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560" Padding="0,0,14,0">
            <StackPanel Spacing="12" MinWidth="380">
                <TextBox x:Name="NameBox" Header="Name" PlaceholderText="prod-web-01" />

                <ComboBox
                    x:Name="FolderBox"
                    Header="Folder"
                    IsEditable="True"
                    PlaceholderText="(root) — e.g. Datacenter/Rack 4"
                    HorizontalAlignment="Stretch" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HostBox" Grid.Column="0" Header="Host" PlaceholderText="10.0.0.1 or host.example.com" />
                    <NumberBox
                        x:Name="PortBox"
                        Grid.Column="1"
                        Header="Port"
                        Minimum="1"
                        Maximum="65535"
                        SpinButtonPlacementMode="Compact"
                        Value="22" />
                </Grid>

                <TextBox x:Name="UsernameBox" Header="Username" PlaceholderText="admin" />

                <ComboBox x:Name="AuthBox" Header="Authentication" SelectedIndex="0" SelectionChanged="AuthBox_SelectionChanged" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Password" />
                    <ComboBoxItem Content="Private key" />
                    <ComboBoxItem Content="None" />
                </ComboBox>

                <StackPanel x:Name="PasswordPanel" Spacing="4">
                    <PasswordBox x:Name="PasswordBox" Header="Password" />
                    <TextBlock
                        x:Name="PasswordHint"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Stored in Windows Credential Manager"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid x:Name="KeyPathPanel" ColumnSpacing="8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="KeyPathBox"
                        Grid.Column="0"
                        Header="Private key file"
                        PlaceholderText="C:\Users\you\.ssh\id_ed25519" />
                    <Button
                        Grid.Column="1"
                        Content="Browse…"
                        VerticalAlignment="Bottom"
                        Click="BrowseKey_Click" />
                </Grid>
                <CheckBox x:Name="PassphraseCheck" Content="Key requires a passphrase" Visibility="Collapsed" />

                <ComboBox x:Name="ColorBox" Header="Color tag" SelectedIndex="0" HorizontalAlignment="Stretch" />

                <ComboBox
                    x:Name="TerminalTypeBox"
                    Header="Terminal type"
                    IsEditable="True"
                    SelectedIndex="0"
                    HorizontalAlignment="Stretch">
                    <x:String>xterm-256color</x:String>
                    <x:String>xterm</x:String>
                    <x:String>vt220</x:String>
                    <x:String>vt100</x:String>
                    <x:String>linux</x:String>
                </ComboBox>

                <StackPanel Spacing="4">
                    <ToggleSwitch x:Name="PersistentToggle" Header="Persistent session" />
                    <TextBlock
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Runs the shell inside tmux on the host, so it survives dropped connections and app restarts — reconnecting resumes right where you left off. Requires tmux on the host."
                        TextWrapping="Wrap" />
                </StackPanel>

                <TextBox
                    x:Name="NotesBox"
                    Header="Notes"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Height="72" />
            </StackPanel>
        </ScrollViewer>
    </StackPanel>
</ContentDialog>
