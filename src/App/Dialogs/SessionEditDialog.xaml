<ContentDialog
    x:Class="Resesh.App.Dialogs.SessionEditDialog"
    Style="{StaticResource DefaultContentDialogStyle}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:Resesh.App.Icons"
    xmlns:controls="using:Resesh.App.Controls"
    xmlns:dialogs="using:Resesh.App.Dialogs"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <!-- The template sizes the title to its content and pins it left; matching the form's
         width gives the connected-tab note room at the right of the title row. A banner
         above the tabs took the height the sections need and made them scroll. -->
    <ContentDialog.Title>
        <Grid Width="{x:Bind SessionForm.Width, Mode=OneWay}" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" TextTrimming="CharacterEllipsis" />
            <StackPanel
                x:Name="ConnectedNote"
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Connected · applies on reconnect" />
            </StackPanel>
        </Grid>
    </ContentDialog.Title>

    <ContentDialog.Resources>
        <!-- The stock cap is 548, which the 500-wide content plus the dialog's own
             horizontal padding already exceeded: the columns had nothing to spare and
             the widest captions ran into the edge. -->
        <x:Double x:Key="ContentDialogMaxWidth">660</x:Double>
    </ContentDialog.Resources>

    <StackPanel x:Name="SessionForm" Spacing="12" Width="600">
        <InfoBar x:Name="NoticeBar" IsOpen="False" IsClosable="False" Severity="Informational" />

        <SelectorBar x:Name="SectionBar" SelectionChanged="SectionBar_SelectionChanged">
            <SelectorBarItem x:Name="ConnectionSection" Text="Connection" IsSelected="True" />
            <SelectorBarItem x:Name="NetworkSection" Text="Network" />
            <SelectorBarItem x:Name="TerminalSection" Text="Terminal" />
            <SelectorBarItem x:Name="AppearanceSection" Text="Appearance" />
            <SelectorBarItem x:Name="IconSection" Text="Icon" />
            <SelectorBarItem x:Name="NotesSection" Text="Notes" />
        </SelectorBar>

        <!-- A fixed height keeps the dialog from resizing as sections change. Each
             section scrolls inside it, so a tall one is reachable instead of clipped. -->
        <Grid x:Name="SectionHost" Height="480">
            <ScrollViewer
                x:Name="ConnectionPanel"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="0,0,12,0">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBox x:Name="NameBox" Header="Name" PlaceholderText="prod-web-01" />
                            <TextBlock x:Name="NameError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <ComboBox
                            x:Name="FolderBox"
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Header="Folder"
                            IsEditable="True"
                            PlaceholderText="(root)"
                            HorizontalAlignment="Stretch" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="ProtocolBox"
                            Grid.Column="0"
                            VerticalAlignment="Top"
                            Header="Protocol"
                            SelectedIndex="0"
                            AutomationProperties.AutomationId="SessionProtocolBox"
                            SelectionChanged="ProtocolBox_SelectionChanged"
                            HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="SSH" />
                            <ComboBoxItem Content="Telnet" />
                        </ComboBox>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBox x:Name="HostBox" Header="Host" PlaceholderText="10.0.0.1 or host.example.com" />
                            <TextBlock x:Name="HostError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <NumberBox
                            x:Name="PortBox"
                            Grid.Column="2"
                            VerticalAlignment="Top"
                            Header="Port"
                            Minimum="1"
                            Maximum="65535"
                            SpinButtonPlacementMode="Compact"
                            Value="22" />
                    </Grid>

                    <InfoBar
                        x:Name="TelnetNotice"
                        IsOpen="False"
                        IsClosable="False"
                        Severity="Warning"
                        Title="Unencrypted"
                        Message="Telnet sends everything in plain text, including passwords typed at the server's login prompt. Use it for console servers and lab or management networks, not general remote access." />

                    <StackPanel x:Name="SshOptionsPanel" Spacing="12">
                    <StackPanel Spacing="4">
                        <ComboBox
                            x:Name="LoginBox"
                            Header="Login"
                            DisplayMemberPath="Label"
                            x:SuppressXamlTrimWarnings="True"
                            AutomationProperties.AutomationId="SessionLoginBox"
                            SelectionChanged="LoginBox_SelectionChanged"
                            HorizontalAlignment="Stretch" />
                        <TextBlock
                            x:Name="LoginDescription"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="UsernameBox" Grid.Column="0" Header="Username" PlaceholderText="admin" />
                        <ComboBox
                            x:Name="AuthBox"
                            Grid.Column="1"
                            Header="Authentication"
                            SelectedIndex="0"
                            SelectionChanged="AuthBox_SelectionChanged"
                            HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Password" />
                            <ComboBoxItem Content="Private key" />
                            <ComboBoxItem Content="None" />
                        </ComboBox>
                    </Grid>

                    <!-- The hint and any error sit under the picker as its caption, like the
                         password's, rather than as rows of their own. -->
                    <StackPanel x:Name="KeyPathPanel" Spacing="4" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="KeyBox"
                                Grid.Column="0"
                                Header="SSH key"
                                DisplayMemberPath="Label"
                                x:SuppressXamlTrimWarnings="True"
                                PlaceholderText="Select a registered key"
                                HorizontalAlignment="Stretch" />
                            <Button
                                Grid.Column="1"
                                Content="Add…"
                                VerticalAlignment="Bottom"
                                Click="AddKey_Click" />
                        </Grid>
                        <TextBlock x:Name="KeyError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock
                            x:Name="KeyHint"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Add… uses the key where it is. Manage keys in Settings › Identities &amp; Keys."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="PasswordPanel" Spacing="4">
                        <PasswordBox x:Name="PasswordBox" Header="Password" />
                        <TextBlock
                            x:Name="PasswordHint"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Stored in Windows Credential Manager"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Expander x:Name="AdvancedSection" Header="Advanced · Shell integration: Off" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <ComboBox
                                x:Name="ShellIntegrationBox"
                                AutomationProperties.AutomationId="SshShellIntegrationBox"
                                Header="Shell integration (experimental)"
                                SelectedIndex="0"
                                HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Off" />
                                <ComboBoxItem Content="Bash" />
                                <ComboBoxItem Content="Zsh" />
                                <ComboBoxItem Content="Fish" />
                                <ComboBoxItem Content="PowerShell (Windows)" />
                            </ComboBox>
                            <TextBlock
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Choose the account's actual shell. Use only for shell accounts, not network-device CLIs. Applies when a new terminal starts; stores a script cache remotely without editing shell profiles. PowerShell requires Persistent session to be off (Terminal section)."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer
                x:Name="NetworkPanel"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="0,0,12,0"
                Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <ComboBox
                            x:Name="ViaBox"
                            Header="Connect"
                            SelectedIndex="0"
                            AutomationProperties.AutomationId="SessionViaBox"
                            SelectionChanged="ViaBox_SelectionChanged"
                            HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Directly" />
                            <ComboBoxItem Content="Through a jump host" />
                            <ComboBoxItem x:Name="ViaProxyItem" Content="Through a proxy" />
                        </ComboBox>
                        <TextBlock
                            x:Name="ViaDescription"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="JumpPanel" Spacing="4" Visibility="Collapsed">
                        <ComboBox
                            x:Name="JumpBox"
                            Header="Jump host"
                            DisplayMemberPath="Label"
                            x:SuppressXamlTrimWarnings="True"
                            PlaceholderText="Select an SSH session"
                            AutomationProperties.AutomationId="SessionJumpBox"
                            HorizontalAlignment="Stretch" />
                        <TextBlock x:Name="JumpError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>

                    <StackPanel x:Name="ProxyPanel" Spacing="12" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="ProxyKindBox"
                                Grid.Column="0"
                                VerticalAlignment="Top"
                                Header="Proxy type"
                                SelectedIndex="0"
                                AutomationProperties.AutomationId="SessionProxyKindBox"
                                SelectionChanged="ProxyKindBox_SelectionChanged"
                                HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="SOCKS5" />
                                <ComboBoxItem Content="SOCKS4" />
                                <ComboBoxItem Content="HTTP CONNECT" />
                            </ComboBox>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBox x:Name="ProxyHostBox" Header="Proxy host" PlaceholderText="proxy.example.com" />
                                <TextBlock x:Name="ProxyHostError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                            <NumberBox
                                x:Name="ProxyPortBox"
                                Grid.Column="2"
                                VerticalAlignment="Top"
                                Header="Port"
                                Minimum="1"
                                Maximum="65535"
                                SpinButtonPlacementMode="Compact"
                                Value="1080" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ProxyUsernameBox" Grid.Column="0" Header="Proxy username (optional)" />
                            <PasswordBox x:Name="ProxyPasswordBox" Grid.Column="1" Header="Proxy password" />
                        </Grid>
                        <TextBlock
                            x:Name="ProxyPasswordHint"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="The proxy password is stored in Windows Credential Manager."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="TunnelsPanel" Spacing="8" Margin="0,4,0,0">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Tunnels" />
                            <TextBlock
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Port forwards that open when this session connects and close when it disconnects. A second tab of the same session cannot listen on the same ports."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="TunnelList" Spacing="4" />
                        <dialogs:TunnelForm x:Name="TunnelFields" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer
                x:Name="TerminalPanel"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="0,0,12,0"
                Visibility="Collapsed">
                <StackPanel Spacing="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="TerminalTypeBox"
                        Grid.Column="0"
                        Header="Terminal type"
                        IsEditable="True"
                        SelectedIndex="0"
                        HorizontalAlignment="Stretch">
                        <x:String>xterm-256color</x:String>
                        <x:String>xterm</x:String>
                        <x:String>vt220</x:String>
                        <x:String>vt100</x:String>
                        <x:String>linux</x:String>
                    </ComboBox>
                    <ComboBox
                        x:Name="TelnetEncodingBox"
                        Grid.Column="1"
                        Header="Text encoding"
                        SelectedIndex="0"
                        Visibility="Collapsed"
                        HorizontalAlignment="Stretch">
                        <x:String>Automatic (UTF-8 / CP437)</x:String>
                        <x:String>UTF-8</x:String>
                        <x:String>CP437 (BBS / ANSI Art)</x:String>
                    </ComboBox>
                </Grid>

                <StackPanel x:Name="TelnetSizePanel" Spacing="4" Visibility="Collapsed">
                    <ToggleSwitch x:Name="TelnetFixed80ColumnsToggle"
                                  AutomationProperties.AutomationId="TelnetFixed80ColumnsToggle"
                                  Header="Keep Terminal at 80 Columns" />
                    <TextBlock Text="Keeps text wrapping at 80 columns. Height follows the window. Close and reopen the session to apply."
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ToggleSwitch x:Name="TelnetReport80x25Toggle"
                                  AutomationProperties.AutomationId="TelnetReport80x25Toggle"
                                  Header="Report 80 × 25 to BBS Servers" />
                    <TextBlock Text="Reports 80 columns and 25 rows for BBS size checks. The visible terminal size stays the same. Reconnect to apply."
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel x:Name="PersistentPanel" Spacing="4">
                    <ToggleSwitch x:Name="PersistentToggle" Header="Persistent session" />
                <TextBlock x:Name="PersistentError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="The shell keeps running on the host when the connection drops or the app closes."
                        TextWrapping="Wrap" />
                    <ComboBox
                        x:Name="PersistenceBackendBox"
                        Margin="0,8,0,0"
                        MinWidth="320"
                        Header="Kept alive by"
                        AutomationProperties.AutomationId="PersistenceBackendBox">
                        <x:String>tmux</x:String>
                        <x:String>Resesh agent</x:String>
                    </ComboBox>
                    <TextBlock
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="tmux must already be on the host. The agent is uploaded to your home directory (2 MB, Linux)."
                        TextWrapping="Wrap" />
                    <ComboBox
                        x:Name="DetachedSessionsBox"
                        Margin="0,8,0,0"
                        MinWidth="320"
                        Header="When earlier shells are running"
                        AutomationProperties.AutomationId="DetachedSessionsBox">
                        <x:String>Resume it, or ask when there are several</x:String>
                        <x:String>Start a new shell, keep the others</x:String>
                        <x:String>End detached shells, then start a new one</x:String>
                    </ComboBox>
                    <TextBlock
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Applies to new tabs. Closing a tab only detaches its shell. Shells open in another tab or attached from somewhere else are never ended automatically."
                        TextWrapping="Wrap" />
                </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer
                x:Name="AppearancePanel"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="0,0,12,0"
                Visibility="Collapsed">
                <StackPanel Spacing="12">
                <!-- The icon has its own tab; the colour tag stays with the appearance settings. -->
                <ComboBox x:Name="ColorBox" Header="Color tag" SelectedIndex="0" Width="280" HorizontalAlignment="Left" />

                <StackPanel Spacing="2" Margin="0,4,0,0">
                    <TextBlock
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="Appearance overrides" />
                    <TextBlock
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Blank fields use the app-wide setting."
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="OverrideThemeBox" Grid.Column="0" Header="Theme" SelectedIndex="0" HorizontalAlignment="Stretch" />
                    <controls:FontFamilyPicker x:Name="OverrideFontFamilyBox" Grid.Column="1" Header="Terminal font" ShowAppSettingChoice="True" PlaceholderText="Use app setting" />
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox
                        x:Name="OverrideFontSizeBox"
                        Grid.Column="0"
                        Header="Font size"
                        PlaceholderText="(app setting)"
                        Minimum="8"
                        Maximum="32"
                        SpinButtonPlacementMode="Compact" />
                    <NumberBox
                        x:Name="OverrideScrollbackBox"
                        Grid.Column="1"
                        Header="Scrollback lines"
                        PlaceholderText="(app setting)"
                        Minimum="1000"
                        Maximum="100000"
                        SmallChange="1000"
                        SpinButtonPlacementMode="Compact" />
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="OverrideRecordingBox"
                        Grid.Column="0"
                        Header="Automatic recording"
                        SelectedIndex="0"
                        HorizontalAlignment="Stretch">
                        <x:String>Use app setting</x:String>
                        <x:String>Always record</x:String>
                        <x:String>Never record</x:String>
                    </ComboBox>
                    <ComboBox
                        x:Name="OverrideHistoryBox"
                        Grid.Column="1"
                        Header="Command history"
                        SelectedIndex="0"
                        HorizontalAlignment="Stretch">
                        <x:String>Use app setting</x:String>
                        <x:String>Keep history</x:String>
                        <x:String>Don't keep history</x:String>
                    </ComboBox>
                </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- The shared icon picker; custom files in the icons folder appear in "Your icons". -->
            <Grid x:Name="IconPanel" RowDefinitions="*,Auto" RowSpacing="8" Visibility="Collapsed">
                <controls:IconPicker x:Name="IconPicker" />
                <TextBlock
                    Grid.Row="1"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Drop your own PNG or SVG files into %APPDATA%\Resesh\icons\ and they appear under Your icons."
                    TextWrapping="Wrap" />
            </Grid>
            <TextBox
                x:Name="NotesBox"
                Header="Notes"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                VerticalAlignment="Stretch"
                Visibility="Collapsed" />
        </Grid>
    </StackPanel>
</ContentDialog>
