<ContentDialog
    x:Class="Resesh.App.Dialogs.TunnelsDialog"
    Style="{StaticResource DefaultContentDialogStyle}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Resesh.App.Dialogs"
    CloseButtonText="Close"
    DefaultButton="Close"
    Opened="Dialog_Opened"
    Closed="Dialog_Closed">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">660</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Body" Spacing="12" Width="560" Padding="0,0,12,0">
            <TextBlock
                Text="Port forwards carried by this tab's SSH connection. They close when the tab disconnects."
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="EmptyText"
                Text="No tunnels are open."
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel
                x:Name="TunnelList"
                Spacing="8"
                AutomationProperties.Name="Tunnels"
                AutomationProperties.AutomationId="TunnelsList" />
            <local:TunnelForm x:Name="TunnelFields" />
            <CheckBox
                x:Name="SaveBox"
                Content="Also save new tunnels with the session, so they open every time it connects"
                AutomationProperties.AutomationId="TunnelsSaveBox" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
