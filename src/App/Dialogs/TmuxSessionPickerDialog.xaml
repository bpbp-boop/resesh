<ContentDialog
    x:Class="Resesh.App.Dialogs.TmuxSessionPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Resesh.App.Dialogs"
    PrimaryButtonText="Resume"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel x:Name="Body" Spacing="12">
        <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />

        <!-- Double-click resumes (or starts) the clicked row. -->
        <ListView
            x:Name="Picker"
            MaxHeight="360"
            HorizontalAlignment="Stretch"
            SelectionMode="Single"
            ItemsSource="{x:Bind Items}"
            AutomationProperties.Name="Persistent session"
            AutomationProperties.AutomationId="ConnectRemoteSessionsList"
            SelectionChanged="Picker_SelectionChanged"
            DoubleTapped="Picker_DoubleTapped">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:TmuxSessionItem">
                    <local:TmuxSessionRowView Item="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Footer buttons share equal widths, so the long bulk action lives in the content
             where it can size to its label. Attached shells are someone's live terminal,
             so it never touches them. -->
        <Button
            HorizontalAlignment="Stretch"
            Content="{x:Bind EndDetachedText}"
            Visibility="{x:Bind HasDetached}"
            AutomationProperties.AutomationId="EndDetachedAndStartNew"
            Click="EndDetached_Click" />

        <TextBlock
            Text="To skip this question, change “When earlier shells are running” in Session Settings › Terminal."
            TextWrapping="Wrap"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{StaticResource SessionTreeMutedForegroundBrush}" />
    </StackPanel>
</ContentDialog>
