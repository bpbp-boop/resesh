<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The app ships as Native AOT: keep this library free of trimming and AOT warnings. -->
    <IsAotCompatible>true</IsAotCompatible>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Resesh.Terminal</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <GhosttyVtArchitecture Condition="'$(Platform)'=='x64'">x64</GhosttyVtArchitecture>
    <GhosttyVtArchitecture Condition="'$(Platform)'=='ARM64'">arm64</GhosttyVtArchitecture>
    <GhosttyVtArchitecture Condition="'$(GhosttyVtArchitecture)'=='' and '$(RuntimeIdentifier)'=='win-x64'">x64</GhosttyVtArchitecture>
    <GhosttyVtArchitecture Condition="'$(GhosttyVtArchitecture)'=='' and '$(RuntimeIdentifier)'=='win-arm64'">arm64</GhosttyVtArchitecture>
    <GhosttyVtDir>$(MSBuildThisFileDirectory)..\..\.artifacts\ghostty-vt\$(GhosttyVtArchitecture)\</GhosttyVtDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.6" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.6" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(GhosttyVtArchitecture)'!=''">
    <!-- The terminal's native libraries, built by eng/build-ghostty-vt.ps1 (BuildGhosttyVt below
         runs it before the copy when they are missing or out of date). -->
    <None Include="$(GhosttyVtDir)ghostty-vt.dll;$(GhosttyVtDir)reseshvt.dll;$(GhosttyVtDir)LICENSE.ghostty.txt"
          Link="GhosttyVt\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- What the native build depends on. Listed for Visual Studio's fast up-to-date check, which
         otherwise skips this project when only the shim or the pin changed. -->
    <GhosttyVtInput Include="$(MSBuildThisFileDirectory)..\..\eng\ghostty-vt.json;$(MSBuildThisFileDirectory)..\..\eng\build-ghostty-vt.ps1;$(MSBuildThisFileDirectory)Native\Shim\**\*" />
    <UpToDateCheckInput Include="@(GhosttyVtInput)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Symbols Nerd Font Mono (github.com/ryanoasis/nerd-fonts v3.4.0, MIT): the prompt and
         status-line icons, for machines with no Nerd Font installed. -->
    <None Include="Fonts\SymbolsNerdFontMono-Regular.ttf;Fonts\LICENSE.nerd-fonts.txt"
          Link="Fonts\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Rebuilds the native libraries when the pin, the build script or the shim changed since they
    were last built, so a build from Visual Studio never runs against a stale reseshvt ABI. The
    check is a content hash stamped next to the DLLs, not timestamps, so switching branches
    and back doesn't rebuild. Skipped on CI (which caches the DLLs on the same inputs), in
    design-time builds, and with -p:SkipGhosttyVtBuild=true.
  -->
  <PropertyGroup>
    <GhosttyVtStamp>$(GhosttyVtDir)inputs.sha256</GhosttyVtStamp>
    <GhosttyVtPowerShell Condition="Exists('$(ProgramFiles)\PowerShell\7\pwsh.exe')">&quot;$(ProgramFiles)\PowerShell\7\pwsh.exe&quot;</GhosttyVtPowerShell>
    <GhosttyVtPowerShell Condition="'$(GhosttyVtPowerShell)'==''">powershell.exe</GhosttyVtPowerShell>
  </PropertyGroup>

  <Target Name="BuildGhosttyVt"
          Condition="'$(GhosttyVtArchitecture)'!='' and '$(DesignTimeBuild)'!='true' and '$(SkipGhosttyVtBuild)'!='true' and '$(CI)'!='true'">
    <GetFileHash Files="@(GhosttyVtInput)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_GhosttyVtInputHash" />
    </GetFileHash>
    <ReadLinesFromFile File="$(GhosttyVtStamp)" Condition="Exists('$(GhosttyVtStamp)')">
      <Output TaskParameter="Lines" PropertyName="_GhosttyVtBuiltHash" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_GhosttyVtInputsHash>@(_GhosttyVtInputHash->'%(Filename)%(Extension)=%(FileHash)', ',')</_GhosttyVtInputsHash>
      <_GhosttyVtStale Condition="'$(_GhosttyVtInputsHash)'!='$(_GhosttyVtBuiltHash)' or !Exists('$(GhosttyVtDir)ghostty-vt.dll') or !Exists('$(GhosttyVtDir)reseshvt.dll')">true</_GhosttyVtStale>
    </PropertyGroup>
    <Message Condition="'$(_GhosttyVtStale)'=='true'" Importance="high"
             Text="Building the terminal's native libraries for $(GhosttyVtArchitecture) (the first build downloads Zig and Ghostty and takes several minutes)..." />
    <Exec Condition="'$(_GhosttyVtStale)'=='true'"
          Command="$(GhosttyVtPowerShell) -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\eng\build-ghostty-vt.ps1&quot; -Architecture $(GhosttyVtArchitecture)" />
    <WriteLinesToFile Condition="'$(_GhosttyVtStale)'=='true'" File="$(GhosttyVtStamp)"
                      Lines="$(_GhosttyVtInputsHash)" Overwrite="true" />
  </Target>

  <Target Name="RequireGhosttyVt" BeforeTargets="BeforeBuild" DependsOnTargets="BuildGhosttyVt"
          Condition="'$(GhosttyVtArchitecture)'!=''">
    <Error Condition="!Exists('$(GhosttyVtDir)ghostty-vt.dll') or !Exists('$(GhosttyVtDir)reseshvt.dll')"
           Text="The terminal's native libraries are not built for $(GhosttyVtArchitecture). Run eng/build-ghostty-vt.ps1 -Architecture $(GhosttyVtArchitecture)." />
  </Target>

</Project>
