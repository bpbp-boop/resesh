<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GhosttyVtArchitecture Condition="'$(Platform)'=='ARM64' or '$(RuntimeIdentifier)'=='win-arm64' or '$(PROCESSOR_ARCHITECTURE)'=='ARM64'">arm64</GhosttyVtArchitecture>
    <GhosttyVtArchitecture Condition="'$(GhosttyVtArchitecture)'==''">x64</GhosttyVtArchitecture>
    <GhosttyVtDir>$(MSBuildThisFileDirectory)..\..\.artifacts\ghostty-vt\$(GhosttyVtArchitecture)\</GhosttyVtDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <Using Include="Xunit" />
    <!-- The command tracker is plain C# over ICommandBuffer: test it without WinUI or the
         native terminal. -->
    <Compile Include="../../src/Terminal/Native/CommandTracker.cs" Link="Native/CommandTracker.cs" />
    <Compile Include="../../src/Terminal/Native/Highlighter.cs" Link="Native/Highlighter.cs" />
    <Compile Include="../../src/Terminal/Native/TerminalCell.cs" Link="Native/TerminalCell.cs" />
    <Compile Include="../../src/Terminal/Native/GhosttyNative.cs" Link="Native/GhosttyNative.cs" />
    <Compile Include="../../src/Terminal/Native/TerminalCommandBuffer.cs" Link="Native/TerminalCommandBuffer.cs" />
    <Compile Include="../../src/Terminal/Native/OverviewIndex.cs" Link="Native/OverviewIndex.cs" />
    <Compile Include="../../src/Terminal/Native/LineTimes.cs" Link="Native/LineTimes.cs" />
    <Compile Include="../../src/Terminal/Native/BuiltinGlyphs.cs" Link="Native/BuiltinGlyphs.cs" />
    <Compile Include="../../src/Terminal/TerminalCommandExecution.cs" Link="TerminalCommandExecution.cs" />
    <Compile Include="../../src/Terminal/TerminalCommandRecord.cs" Link="TerminalCommandRecord.cs" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(GhosttyVtDir)ghostty-vt.dll') and Exists('$(GhosttyVtDir)reseshvt.dll')">
    <None Include="$(GhosttyVtDir)ghostty-vt.dll;$(GhosttyVtDir)reseshvt.dll"
          Link="GhosttyVt\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
