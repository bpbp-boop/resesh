+HwndTerminalSnapshot HwndTerminal::CaptureSnapshot() const
+{
+    if (!_terminal)
+    {
+        return {};
+    }
+
+    std::unique_ptr<TextBuffer> bufferCopy;
+    HwndTerminalSnapshot snapshot;
+    {
+        const auto lock = _terminal->LockForReading();
+        const auto& source = _terminal->GetTextBuffer();
+        const auto size = source.GetSize().Dimensions();
+        bufferCopy = std::make_unique<TextBuffer>(size, source.GetCurrentAttributes(), 25, false, nullptr);
+        bufferCopy->CopyProperties(source);
+        for (til::CoordType row = 0; row < size.height; ++row)
+        {
+            source.CopyRow(row, row, *bufferCopy);
+        }
+        bufferCopy->CopyHyperlinkMaps(source);
+
+        snapshot.Size = _terminal->GetViewport().Dimensions();
+        const auto cursor = _terminal->GetCursorPosition();
+        snapshot.Cursor = { cursor.x, cursor.y - _terminal->ViewStartIndex() };
+        snapshot.CursorVisible = source.GetCursor().IsVisible();
+        snapshot.ViewportTop = _terminal->GetScrollOffset();
+        snapshot.ViewportHeight = _terminal->GetViewport().Height();
+        snapshot.ScrollOffset = _terminal->ViewStartIndex() - snapshot.ViewportTop;
+        snapshot.AlternateBuffer = _terminal->IsAlternateBufferActive();
+    }
+
+    bufferCopy->SerializeTo(snapshot.Ansi);
+    if (!snapshot.Ansi.empty() && snapshot.Ansi.front() == L'\uFEFF')
+    {
+        snapshot.Ansi.erase(snapshot.Ansi.begin());
+    }
+
+    const auto cursorRow = std::clamp(snapshot.Cursor.y, 0, std::max(0, snapshot.ViewportHeight - 1));
+    fmt::format_to(
+        std::back_inserter(snapshot.Ansi),
+        FMT_COMPILE(L"\x1b[{};{}H\x1b[?25{}"),
+        cursorRow + 1,
+        snapshot.Cursor.x + 1,
+        snapshot.CursorVisible ? L'h' : L'l');
+    return snapshot;
+}
+
+HRESULT HwndTerminal::ResizeCharacters(const til::size dimensions)
+{
+    RETURN_HR_IF(E_INVALIDARG, dimensions.width <= 0 || dimensions.height <= 0);
+    RETURN_HR_IF_NULL(E_NOT_VALID_STATE, _terminal);
+    const auto lock = _terminal->LockForWriting();
+    RETURN_IF_FAILED(_terminal->UserResize(dimensions));
+    _terminal->UpdatePatternsUnderLock();
+    _updateHighlights(true);
+    _renderer->TriggerRedrawAll();
+    return S_OK;
+}
 
