+[[nodiscard]] HRESULT AtlasEngine::_drawPersistentHighlights(std::span<const RenderDecoration>& highlights, const u16 row, const u16 begX, const u16 endX) noexcept
+try
+{
+    if (highlights.empty())
+    {
+        return S_OK;
+    }
+
+    const til::CoordType y = row;
+    const auto offset = til::point{ _api.viewportOffset.x, _api.viewportOffset.y };
