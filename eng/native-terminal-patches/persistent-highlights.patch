+    void ReseshTerminalAbiTests::CapturesAnsiSnapshots()
+    {
+        const auto module = LoadAbiModule();
+        const auto closeModule = wil::scope_exit([&]() noexcept { FreeLibrary(module); });
+        const auto create = LoadExport<decltype(&ReseshTerminalCreate)>(module, "ReseshTerminalCreate");
+        const auto destroy = LoadExport<decltype(&ReseshTerminalDestroy)>(module, "ReseshTerminalDestroy");
+        const auto sendOutput = LoadExport<decltype(&ReseshTerminalSendOutput)>(module, "ReseshTerminalSendOutput");
+        const auto resizeCharacters = LoadExport<decltype(&ReseshTerminalResizeCharacters)>(
+            module, "ReseshTerminalResizeCharacters");
+        const auto captureSnapshot = LoadExport<decltype(&ReseshTerminalCaptureSnapshot)>(
+            module, "ReseshTerminalCaptureSnapshot");
+        const auto parent = CreateParentWindow();
+        const auto closeParent = wil::scope_exit([&]() noexcept { DestroyWindow(parent); });
+        const auto options = DefaultOptions(parent);
+        ReseshTerminalHandle terminal{};
+        VERIFY_SUCCEEDED(create(&options, &terminal));
+        const auto closeTerminal = wil::scope_exit([&]() noexcept { VERIFY_SUCCEEDED(destroy(terminal)); });
+
+        VERIFY_SUCCEEDED(resizeCharacters(terminal, 90, 25));
+        constexpr wchar_t output[]{ L"\x1b]0;snapshot title\x07\x1b]7;file://host/work\x07\x1b[31mwide \x754c\x1b[0m" };
+        VERIFY_SUCCEEDED(sendOutput(terminal, output, gsl::narrow<uint32_t>(std::size(output) - 1)));
+
+        ReseshTerminalSnapshot snapshot{
+            .structSize = sizeof(ReseshTerminalSnapshot),
+            .abiMajor = RESESH_TERMINAL_ABI_MAJOR,
+            .abiMinor = RESESH_TERMINAL_ABI_MINOR,
+        };
+        uint32_t required{};
+        VERIFY_ARE_EQUAL(
+            HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER),
+            captureSnapshot(terminal, &snapshot, nullptr, 0, &required));
+        VERIFY_IS_GREATER_THAN(required, 0u);
+        VERIFY_ARE_EQUAL(1u, snapshot.schemaVersion);
+        VERIFY_ARE_EQUAL(90, snapshot.columns);
+        VERIFY_ARE_EQUAL(25, snapshot.rows);
+        VERIFY_IS_TRUE(snapshot.captureSequence > 0);
+        VERIFY_IS_TRUE(snapshot.unixTimeMilliseconds > 0);
+
+        std::wstring payload(required, L'\0');
+        VERIFY_SUCCEEDED(captureSnapshot(terminal, &snapshot, payload.data(), required, &required));
+        const std::wstring_view ansi{ payload.data() + snapshot.ansiOffset, snapshot.ansiLength };
+        const std::wstring_view title{ payload.data() + snapshot.titleOffset, snapshot.titleLength };
+        const std::wstring_view workingDirectory{
+            payload.data() + snapshot.workingDirectoryOffset,
+            snapshot.workingDirectoryLength
+        };
+        VERIFY_IS_TRUE(ansi.find(L"wide \x754c") != std::wstring_view::npos);
+        VERIFY_ARE_EQUAL(std::wstring_view{ L"snapshot title" }, title);
+        VERIFY_ARE_EQUAL(std::wstring_view{ L"file://host/work" }, workingDirectory);
+    }
