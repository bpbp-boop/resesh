+HRESULT HwndTerminal::SetHighlightRules(const std::span<const ReseshTerminalHighlightRule> rules)
+{
+    std::vector<HwndTerminalHighlightRule> compiledRules;
+    compiledRules.reserve(rules.size());
+
+    for (const auto& r : rules)
+    {
+        RETURN_HR_IF(E_INVALIDARG, r.patternLength > 1024 * 1024 || (r.patternLength > 0 && !r.pattern));
+        const std::wstring_view patternView{ r.pattern, r.patternLength };
+        if (patternView.empty())
+        {
+            continue;
+        }
+
+        uint32_t icuFlags{ 0 };
+        if ((r.flags & ReseshTerminalHighlightMatchCase) == 0)
+        {
+            WI_SetFlag(icuFlags, UREGEX_CASE_INSENSITIVE);
+        }
+        if ((r.flags & ReseshTerminalHighlightRegex) != 0)
+        {
+            WI_SetFlag(icuFlags, UREGEX_MULTILINE);
+        }
+        else
+        {
+            WI_SetFlag(icuFlags, UREGEX_LITERAL);
+        }
+
+        UErrorCode status = U_ZERO_ERROR;
+        auto re = til::ICU::CreateRegex(patternView, icuFlags, &status);
+        if (U_FAILURE(status) || !re)
+        {
+            return HRESULT_FROM_WIN32(ERROR_INVALID_DATATYPE);
+        }
+
+        compiledRules.push_back(HwndTerminalHighlightRule{
+            .Id = r.id,
+            .Pattern = std::wstring{ patternView },
+            .RegularExpression = (r.flags & ReseshTerminalHighlightRegex) != 0,
+            .MatchCase = (r.flags & ReseshTerminalHighlightMatchCase) != 0,
+            .ShowInOverview = (r.flags & ReseshTerminalHighlightShowInOverview) != 0,
+            .Foreground = til::color{
+                static_cast<uint8_t>(r.foreground & 0xff),
+                static_cast<uint8_t>((r.foreground >> 8) & 0xff),
+                static_cast<uint8_t>((r.foreground >> 16) & 0xff),
+                255 },
+            .Background = til::color{
+                static_cast<uint8_t>(r.background & 0xff),
+                static_cast<uint8_t>((r.background >> 8) & 0xff),
+                static_cast<uint8_t>((r.background >> 16) & 0xff),
+                static_cast<uint8_t>((r.background >> 24) & 0xff) },
+            .Priority = r.priority,
+            .Regex = std::move(re),
+        });
+    }
+
+    if (_terminal)
+    {
+        const auto lock = _terminal->LockForWriting();
+        _highlightRules = std::move(compiledRules);
+        _lastHighlightMutationId = 0;
+        _updateHighlights(true);
+    }
+    else
+    {
+        _highlightRules = std::move(compiledRules);
+    }
+
+    return S_OK;
+}
+
+void HwndTerminal::ClearHighlightRules()
+{
+    if (_terminal)
+    {
+        const auto lock = _terminal->LockForWriting();
+        _highlightRules.clear();
+        _highlightSpans.clear();
+        _highlightRows.clear();
+        _lastHighlightMutationId = 0;
+        _terminal->SetPersistentHighlights({});
+    }
+    else
+    {
+        _highlightRules.clear();
+        _highlightSpans.clear();
+        _highlightRows.clear();
+        _lastHighlightMutationId = 0;
+    }
+    if (_renderer)
+    {
+        _renderer->TriggerRedrawAll();
+    }
+}
+
+std::vector<HwndTerminalHighlightRow> HwndTerminal::GetHighlightRows() const
+{
+    if (_terminal)
+    {
+        const auto lock = _terminal->LockForReading();
+        return _highlightRows;
+    }
+    return _highlightRows;
+}
+
+void HwndTerminal::_updateHighlights(const bool forceRescan)
+{
+    if (!_terminal)
+    {
+        return;
+    }
+
+    if (_highlightRules.empty() || _terminal->IsAlternateBufferActive())
+    {
+        _highlightSpans.clear();
+        _highlightRows.clear();
+        _terminal->SetPersistentHighlights({});
+        if (_renderer)
+        {
+            _renderer->TriggerRedrawAll();
+        }
+        return;
+    }
+
+    const auto& textBuffer = _terminal->GetTextBuffer();
+    const auto currentMutationId = textBuffer.GetLastMutationId();
+    if (!forceRescan && currentMutationId == _lastHighlightMutationId)
+    {
+        return;
+    }
+
+    const auto bufferGeneration = currentMutationId;
+    const auto totalRows = textBuffer.TotalRowCount();
+    const auto bottomRow = textBuffer.GetSize().BottomInclusive();
+    const auto committedEnd = std::min<til::CoordType>(totalRows, bottomRow + 1);
+
+    std::vector<HwndTerminalHighlightSpan> newSpans;
+
+    for (til::CoordType row = 0; row < committedEnd; )
+    {
+        const auto lineStart = row;
+        const auto lineEnd = std::min<til::CoordType>(committedEnd, _logicalLineEnd(row) + 1);
+        row = lineEnd;
+
+        auto utext = Microsoft::Console::ICU::UTextFromTextBuffer(textBuffer, lineStart, lineEnd);
+
+        for (const auto& rule : _highlightRules)
+        {
+            UErrorCode status = U_ZERO_ERROR;
+            uregex_setUText(rule.Regex.get(), &utext, &status);
+            if (U_SUCCESS(status) && uregex_find(rule.Regex.get(), -1, &status))
+            {
+                do
+                {
+                    auto range = Microsoft::Console::ICU::BufferRangeFromMatch(&utext, rule.Regex.get());
+                    newSpans.push_back({
+                        .RuleId = rule.Id,
+                        .Start = range.start,
+                        .End = range.end,
+                        .BufferGeneration = bufferGeneration,
+                        .Priority = rule.Priority,
+                        .Foreground = rule.Foreground,
+                        .Background = rule.Background,
+                        .ShowInOverview = rule.ShowInOverview,
+                    });
+                } while (uregex_findNext(rule.Regex.get(), &status));
+            }
+        }
+    }
+
+    if (textBuffer.GetLastMutationId() != bufferGeneration)
+    {
+        return;
+    }
+
+    _lastHighlightMutationId = bufferGeneration;
+    _highlightSpans = std::move(newSpans);
+
+    std::sort(_highlightSpans.begin(), _highlightSpans.end(), [](const auto& a, const auto& b) {
+        if (a.Start.y != b.Start.y)
+        {
+            return a.Start.y < b.Start.y;
+        }
+        if (a.Priority != b.Priority)
+        {
+            return a.Priority < b.Priority;
+        }
+        return a.RuleId < b.RuleId;
+    });
+
+    std::vector<Microsoft::Console::Render::RenderDecoration> decorations;
+    const auto bufferWidth = textBuffer.GetSize().Width();
+    for (const auto& span : _highlightSpans)
+    {
+        auto effectiveEnd = span.End;
+        if (effectiveEnd.x == 0 && effectiveEnd.y > span.Start.y)
+        {
+            effectiveEnd.y--;
+            effectiveEnd.x = bufferWidth;
+        }
+
+        if (span.Start.y == effectiveEnd.y)
+        {
+            decorations.push_back({
+                .span = til::point_span{ span.Start, effectiveEnd },
+                .foreground = span.Foreground,
+                .background = span.Background,
+                .priority = span.Priority,
+            });
+        }
+        else
+        {
+            decorations.push_back({
+                .span = til::point_span{ span.Start, til::point{ bufferWidth, span.Start.y } },
+                .foreground = span.Foreground,
+                .background = span.Background,
+                .priority = span.Priority,
+            });
+            for (auto y = span.Start.y + 1; y < effectiveEnd.y; ++y)
+            {
+                decorations.push_back({
+                    .span = til::point_span{ til::point{ 0, y }, til::point{ bufferWidth, y } },
+                    .foreground = span.Foreground,
+                    .background = span.Background,
+                    .priority = span.Priority,
+                });
+            }
+            if (effectiveEnd.x > 0)
+            {
+                decorations.push_back({
+                    .span = til::point_span{ til::point{ 0, effectiveEnd.y }, effectiveEnd },
+                    .foreground = span.Foreground,
+                    .background = span.Background,
+                    .priority = span.Priority,
+                });
+            }
+        }
+    }
+    _terminal->SetPersistentHighlights(std::move(decorations));
+
+    std::map<int32_t, std::pair<uint32_t, uint32_t>> overviewMap;
+    for (const auto& span : _highlightSpans)
+    {
+        if (!span.ShowInOverview)
+        {
+            continue;
+        }
+        const auto colorRef = static_cast<COLORREF>(span.Foreground);
+        const auto lastRow = (span.End.x == 0 && span.End.y > span.Start.y) ? span.End.y - 1 : span.End.y;
+        for (auto r = span.Start.y; r <= lastRow; ++r)
+        {
+            auto& entry = overviewMap[r];
+            entry.first++;
+            entry.second = colorRef;
+        }
+    }
+
+    _highlightRows.clear();
+    _highlightRows.reserve(overviewMap.size());
+    for (const auto& [rowIdx, data] : overviewMap)
+    {
+        _highlightRows.push_back({
+            .Row = rowIdx,
+            .Count = data.first,
+            .Color = data.second,
+        });
+    }
+
+    if (_renderer)
+    {
+        _renderer->TriggerRedrawAll();
+    }
+}
