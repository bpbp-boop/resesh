+    void ReseshTerminalAbiTests::AppliesPersistentHighlightRulesAndPrecedence()
+    {
+        const auto module = LoadAbiModule();
+        const auto closeModule = wil::scope_exit([&]() noexcept { FreeLibrary(module); });
+        const auto create = LoadExport<decltype(&ReseshTerminalCreate)>(module, "ReseshTerminalCreate");
+        const auto destroy = LoadExport<decltype(&ReseshTerminalDestroy)>(module, "ReseshTerminalDestroy");
+        const auto sendOutput = LoadExport<decltype(&ReseshTerminalSendOutput)>(module, "ReseshTerminalSendOutput");
+        const auto setRules = LoadExport<decltype(&ReseshTerminalSetHighlightRules)>(
+            module, "ReseshTerminalSetHighlightRules");
+        const auto resizeCharacters = LoadExport<decltype(&ReseshTerminalResizeCharacters)>(
+            module, "ReseshTerminalResizeCharacters");
+        const auto clearRules = LoadExport<decltype(&ReseshTerminalClearHighlightRules)>(
+            module, "ReseshTerminalClearHighlightRules");
+        const auto getHighlightRows = LoadExport<decltype(&ReseshTerminalGetHighlightRows)>(
+            module, "ReseshTerminalGetHighlightRows");
+        const auto parent = CreateParentWindow();
+        const auto closeParent = wil::scope_exit([&]() noexcept { DestroyWindow(parent); });
+        const auto options = DefaultOptions(parent);
+        ReseshTerminalHandle terminal{};
+        VERIFY_SUCCEEDED(create(&options, &terminal));
+        const auto closeTerminal = wil::scope_exit([&]() noexcept { VERIFY_SUCCEEDED(destroy(terminal)); });
+
+        VERIFY_SUCCEEDED(resizeCharacters(terminal, 80, 10));
+        constexpr wchar_t sampleOutput[]{
+            L"Interface GigabitEthernet0/1 is down, eth0 is up\r\n"
+            L"Host 192.168.1.1 error critical timeout alert\r\n"
+            L"Server ok reachable synchronized\r\n"
+        };
+        VERIFY_SUCCEEDED(sendOutput(terminal, sampleOutput, gsl::narrow<uint32_t>(std::size(sampleOutput) - 1)));
+
+        constexpr wchar_t ifacePattern[]{ LR"(\b(?:GigabitEthernet|eth)\d+(?:/\d+)*\b)" };
+        constexpr wchar_t downPattern[]{ LR"(\b(?:down|error|critical|timeout|alert)\b)" };
+        constexpr wchar_t upPattern[]{ LR"(\b(?:up|ok|reachable|synchronized)\b)" };
+
+        std::array<ReseshTerminalHighlightRule, 3> validRules{
+            ReseshTerminalHighlightRule{
+                .structSize = sizeof(ReseshTerminalHighlightRule),
+                .abiMajor = RESESH_TERMINAL_ABI_MAJOR,
+                .abiMinor = RESESH_TERMINAL_ABI_MINOR,
+                .id = 1,
+                .pattern = ifacePattern,
+                .patternLength = gsl::narrow<uint32_t>(std::size(ifacePattern) - 1),
+                .flags = ReseshTerminalHighlightRegex,
+                .foreground = 0x007BC0E5, // #e5c07b
+                .background = 0,
+                .priority = 10,
+            },
+            ReseshTerminalHighlightRule{
+                .structSize = sizeof(ReseshTerminalHighlightRule),
+                .abiMajor = RESESH_TERMINAL_ABI_MAJOR,
+                .abiMinor = RESESH_TERMINAL_ABI_MINOR,
+                .id = 2,
+                .pattern = downPattern,
+                .patternLength = gsl::narrow<uint32_t>(std::size(downPattern) - 1),
+                .flags = ReseshTerminalHighlightRegex | ReseshTerminalHighlightShowInOverview,
+                .foreground = 0x005555FF, // #ff5555
+                .background = 0x385555FF, // bold tint
+                .priority = 20,
+            },
+            ReseshTerminalHighlightRule{
+                .structSize = sizeof(ReseshTerminalHighlightRule),
+                .abiMajor = RESESH_TERMINAL_ABI_MAJOR,
+                .abiMinor = RESESH_TERMINAL_ABI_MINOR,
+                .id = 3,
+                .pattern = upPattern,
+                .patternLength = gsl::narrow<uint32_t>(std::size(upPattern) - 1),
+                .flags = ReseshTerminalHighlightRegex,
+                .foreground = 0x008BD123, // #23d18b
+                .background = 0,
+                .priority = 10,
+            },
+        };
+
+        // 1. Valid rules apply
+        VERIFY_SUCCEEDED(setRules(terminal, validRules.data(), gsl::narrow<uint32_t>(validRules.size())));
+
+        // Check overview rows for the ruler (downPattern has showInOverview, matches rows 0 and 1)
+        uint32_t requiredRows{};
+        VERIFY_ARE_EQUAL(
+            HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER),
+            getHighlightRows(terminal, nullptr, 0, &requiredRows));
+        VERIFY_ARE_EQUAL(2u, requiredRows);
+        std::vector<ReseshTerminalHighlightRow> rows(requiredRows);
+        VERIFY_SUCCEEDED(getHighlightRows(terminal, rows.data(), requiredRows, &requiredRows));
+        VERIFY_ARE_EQUAL(0, rows[0].row);
+        VERIFY_ARE_EQUAL(1u, rows[0].count); // "down"
+        VERIFY_ARE_EQUAL(1, rows[1].row);
+        VERIFY_ARE_EQUAL(4u, rows[1].count); // "error", "critical", "timeout", "alert"
+
+        // 2. Invalid regex reports typed error and does NOT alter active rules
+        constexpr wchar_t invalidPattern[]{ L"(unclosed group" };
+        std::array<ReseshTerminalHighlightRule, 1> invalidRules{
+            ReseshTerminalHighlightRule{
+                .structSize = sizeof(ReseshTerminalHighlightRule),
+                .abiMajor = RESESH_TERMINAL_ABI_MAJOR,
+                .abiMinor = RESESH_TERMINAL_ABI_MINOR,
+                .id = 99,
+                .pattern = invalidPattern,
+                .patternLength = gsl::narrow<uint32_t>(std::size(invalidPattern) - 1),
+                .flags = ReseshTerminalHighlightRegex,
+                .foreground = 0x00FFFFFF,
+                .background = 0,
+                .priority = 100,
+            },
+        };
+        VERIFY_ARE_EQUAL(HRESULT_FROM_WIN32(ERROR_INVALID_DATATYPE),
+            setRules(terminal, invalidRules.data(), gsl::narrow<uint32_t>(invalidRules.size())));
+
+        // Active overview rows still intact
+        uint32_t rowsStillIntact{};
+        VERIFY_ARE_EQUAL(
+            HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER),
+            getHighlightRows(terminal, nullptr, 0, &rowsStillIntact));
+        VERIFY_ARE_EQUAL(2u, rowsStillIntact);
+
+        // 3. Catastrophic regex with cancellation / timeout policy without hanging
+        constexpr wchar_t catastrophicPattern[]{ L"(a+)+$" };
+        std::array<ReseshTerminalHighlightRule, 1> catastrophicRules{
+            ReseshTerminalHighlightRule{
+                .structSize = sizeof(ReseshTerminalHighlightRule),
+                .abiMajor = RESESH_TERMINAL_ABI_MAJOR,
+                .abiMinor = RESESH_TERMINAL_ABI_MINOR,
+                .id = 100,
+                .pattern = catastrophicPattern,
+                .patternLength = gsl::narrow<uint32_t>(std::size(catastrophicPattern) - 1),
+                .flags = ReseshTerminalHighlightRegex,
+                .foreground = 0x00FFFFFF,
+                .background = 0,
+                .priority = 1,
+            },
+        };
+        VERIFY_SUCCEEDED(setRules(terminal, catastrophicRules.data(), gsl::narrow<uint32_t>(catastrophicRules.size())));
+        constexpr wchar_t backtrackingPayload[]{ L"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaX\r\n" };
+        VERIFY_SUCCEEDED(sendOutput(terminal, backtrackingPayload, gsl::narrow<uint32_t>(std::size(backtrackingPayload) - 1)));
+
+        // 4. Clear highlight rules resets active highlights and ruler rows
+        VERIFY_SUCCEEDED(clearRules(terminal));
+        uint32_t clearedRows{};
+        VERIFY_SUCCEEDED(getHighlightRows(terminal, nullptr, 0, &clearedRows));
+        VERIFY_ARE_EQUAL(0u, clearedRows);
+
+        // 5. Exercises the search-highlights-marks-and-bookmarks parity fixture
+        constexpr wchar_t chunk1[]{ L"\x1b]133;A\x07PS C:\\Work> \x1b]133;B\x07echo ERROR-42\r\n" };
+        constexpr wchar_t chunk2[]{ L"\x1b]133;C\x07ERROR-42 at https://example.test/error/42\r\n" };
+        constexpr wchar_t chunk3[]{ L"\x1b]133;D;0\x07PS C:\\Work> " };
+        VERIFY_SUCCEEDED(sendOutput(terminal, chunk1, gsl::narrow<uint32_t>(std::size(chunk1) - 1)));
+        VERIFY_SUCCEEDED(sendOutput(terminal, chunk2, gsl::narrow<uint32_t>(std::size(chunk2) - 1)));
+        VERIFY_SUCCEEDED(sendOutput(terminal, chunk3, gsl::narrow<uint32_t>(std::size(chunk3) - 1)));
+
+        constexpr wchar_t errorPattern[]{ L"ERROR-[0-9]+" };
+        std::array<ReseshTerminalHighlightRule, 1> errorHighlightRules{
+            ReseshTerminalHighlightRule{
+                .structSize = sizeof(ReseshTerminalHighlightRule),
+                .abiMajor = RESESH_TERMINAL_ABI_MAJOR,
+                .abiMinor = RESESH_TERMINAL_ABI_MINOR,
+                .id = 200,
+                .pattern = errorPattern,
+                .patternLength = gsl::narrow<uint32_t>(std::size(errorPattern) - 1),
+                .flags = ReseshTerminalHighlightRegex | ReseshTerminalHighlightShowInOverview,
+                .foreground = 0x000000FF,
+                .background = 0,
+                .priority = 50,
+            },
+        };
+        VERIFY_SUCCEEDED(setRules(terminal, errorHighlightRules.data(), gsl::narrow<uint32_t>(errorHighlightRules.size())));
+
+        uint32_t errorOverviewRows{};
+        VERIFY_ARE_EQUAL(HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER), getHighlightRows(terminal, nullptr, 0, &errorOverviewRows));
+        VERIFY_IS_GREATER_THAN_OR_EQUAL(errorOverviewRows, 2u);
+        std::vector<ReseshTerminalHighlightRow> errorRows(errorOverviewRows);
+        VERIFY_SUCCEEDED(getHighlightRows(terminal, errorRows.data(), errorOverviewRows, &errorOverviewRows));
+
+        const auto search = LoadExport<decltype(&ReseshTerminalSearch)>(module, "ReseshTerminalSearch");
+        constexpr wchar_t queryError[]{ L"ERROR-42" };
+        ReseshTerminalSearchRequest searchReq{
+            .structSize = sizeof(ReseshTerminalSearchRequest),
+            .abiMajor = RESESH_TERMINAL_ABI_MAJOR,
+            .abiMinor = RESESH_TERMINAL_ABI_MINOR,
+            .query = queryError,
+            .queryLength = gsl::narrow<uint32_t>(std::size(queryError) - 1),
+            .flags = ReseshTerminalSearchForward | ReseshTerminalSearchExecute,
+            .scrollOffset = 0,
+        };
+        ReseshTerminalSearchState searchRes{};
+        VERIFY_SUCCEEDED(search(terminal, &searchReq, &searchRes));
+        VERIFY_ARE_EQUAL(2, searchRes.totalMatches);
+    }
+}
