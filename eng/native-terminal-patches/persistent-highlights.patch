+CATCH_RETURN()
+
+HRESULT __stdcall ReseshTerminalCaptureSnapshot(
+    const ReseshTerminalHandle terminal,
+    ReseshTerminalSnapshot* const snapshot,
+    wchar_t* const payload,
+    const uint32_t capacity,
+    uint32_t* const requiredCapacity)
+try
+{
+    RETURN_HR_IF_NULL(E_INVALIDARG, snapshot);
+    RETURN_HR_IF_NULL(E_INVALIDARG, requiredCapacity);
+    RETURN_HR_IF(HRESULT_FROM_WIN32(ERROR_REVISION_MISMATCH),
+                 !IsCompatible(snapshot->structSize, snapshot->abiMajor, sizeof(ReseshTerminalSnapshot)));
+
+    return WithTerminal(terminal, [&](TerminalState& state) {
+        auto terminalSnapshot = state.terminal->CaptureSnapshot();
+        std::wstring title;
+        std::wstring workingDirectory;
+        uint64_t captureSequence;
+        {
+            const std::scoped_lock lock{ state.eventMutex };
+            title = state.title;
+            workingDirectory = state.workingDirectory;
+            captureSequence = state.nextSequence - 1;
+        }
+
+        const auto required64 = terminalSnapshot.Ansi.size() + title.size() + workingDirectory.size();
+        RETURN_HR_IF(E_OUTOFMEMORY, required64 > MaximumSnapshotCharacters);
+        const auto required = gsl::narrow<uint32_t>(required64);
+        *requiredCapacity = required;
+
+        const auto ansiLength = gsl::narrow<uint32_t>(terminalSnapshot.Ansi.size());
+        const auto titleLength = gsl::narrow<uint32_t>(title.size());
+        const auto workingDirectoryLength = gsl::narrow<uint32_t>(workingDirectory.size());
+        const auto unixTime = std::chrono::duration_cast<std::chrono::milliseconds>(
+                                  std::chrono::system_clock::now().time_since_epoch())
+                                  .count();
+        *snapshot = {
+            sizeof(ReseshTerminalSnapshot),
+            RESESH_TERMINAL_ABI_MAJOR,
+            RESESH_TERMINAL_ABI_MINOR,
+            1,
+            (terminalSnapshot.CursorVisible ? ReseshTerminalSnapshotCursorVisible : 0u) |
+                (terminalSnapshot.AlternateBuffer ? ReseshTerminalSnapshotAlternateBuffer : 0u),
+            terminalSnapshot.Size.width,
+            terminalSnapshot.ViewportHeight,
+            terminalSnapshot.Cursor.x,
+            terminalSnapshot.Cursor.y,
+            terminalSnapshot.ViewportTop,
+            terminalSnapshot.ViewportHeight,
+            terminalSnapshot.ScrollOffset,
+            captureSequence,
+            unixTime,
+            0,
+            ansiLength,
+            ansiLength,
+            titleLength,
+            ansiLength + titleLength,
+            workingDirectoryLength,
+        };
+
+        RETURN_HR_IF(HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER), capacity < required || (required > 0 && !payload));
+        auto output = payload;
+        output = std::copy(terminalSnapshot.Ansi.begin(), terminalSnapshot.Ansi.end(), output);
+        output = std::copy(title.begin(), title.end(), output);
+        std::copy(workingDirectory.begin(), workingDirectory.end(), output);
+        return S_OK;
+    });
+}
+CATCH_RETURN()
+
+HRESULT __stdcall ReseshTerminalSetHighlightRules(
+    const ReseshTerminalHandle terminal,
+    const ReseshTerminalHighlightRule* const rules,
+    const uint32_t count)
+try
+{
+    RETURN_HR_IF(E_INVALIDARG, count > 1024 || (count > 0 && !rules));
+    for (uint32_t i = 0; i < count; ++i)
+    {
+        RETURN_HR_IF(HRESULT_FROM_WIN32(ERROR_REVISION_MISMATCH),
+                     !IsCompatible(rules[i].structSize, rules[i].abiMajor, sizeof(ReseshTerminalHighlightRule)));
+    }
+    return WithTerminal(terminal, [&](TerminalState& state) {
+        return state.terminal->SetHighlightRules(std::span<const ReseshTerminalHighlightRule>{ rules, count });
+    });
+}
+CATCH_RETURN()
+
+HRESULT __stdcall ReseshTerminalClearHighlightRules(const ReseshTerminalHandle terminal)
+try
+{
+    return WithTerminal(terminal, [&](TerminalState& state) {
+        state.terminal->ClearHighlightRules();
+        return S_OK;
+    });
+}
+CATCH_RETURN()
+
+HRESULT __stdcall ReseshTerminalGetHighlightRows(
+    const ReseshTerminalHandle terminal,
+    ReseshTerminalHighlightRow* const rows,
+    const uint32_t capacity,
+    uint32_t* const requiredCapacity)
+try
+{
+    RETURN_HR_IF_NULL(E_INVALIDARG, requiredCapacity);
+    return WithTerminal(terminal, [&](TerminalState& state) {
+        const auto highlightRows = state.terminal->GetHighlightRows();
+        const auto required = gsl::narrow<uint32_t>(highlightRows.size());
+        *requiredCapacity = required;
+        RETURN_HR_IF(HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER), capacity < required || (required > 0 && !rows));
+        for (uint32_t i = 0; i < required; ++i)
+        {
+            rows[i] = {
+                .structSize = sizeof(ReseshTerminalHighlightRow),
+                .abiMajor = RESESH_TERMINAL_ABI_MAJOR,
+                .abiMinor = RESESH_TERMINAL_ABI_MINOR,
+                .row = highlightRows[i].Row,
+                .count = highlightRows[i].Count,
+                .color = highlightRows[i].Color,
+            };
+        }
+        return S_OK;
+    });
+}
+CATCH_RETURN()
