+    uint32_t ReadSnapshotU32(const std::span<const uint8_t> bytes, const size_t offset)
+    {
+        return static_cast<uint32_t>(bytes[offset]) |
+               static_cast<uint32_t>(bytes[offset + 1]) << 8 |
+               static_cast<uint32_t>(bytes[offset + 2]) << 16 |
+               static_cast<uint32_t>(bytes[offset + 3]) << 24;
+    }
+
+    void WriteSnapshotU16(std::vector<uint8_t>& bytes, const size_t offset, const uint16_t value)
+    {
+        bytes[offset] = static_cast<uint8_t>(value);
+        bytes[offset + 1] = static_cast<uint8_t>(value >> 8);
+    }
+
+    void WriteSnapshotU32(std::vector<uint8_t>& bytes, const size_t offset, const uint32_t value)
+    {
+        for (size_t index = 0; index < 4; ++index)
+            bytes[offset + index] = static_cast<uint8_t>(value >> (index * 8));
+    }
+
+    uint32_t SnapshotCrc32(const std::span<const uint8_t> bytes)
+    {
+        auto crc = UINT32_MAX;
+        for (const auto value : bytes)
+        {
+            crc ^= value;
+            for (size_t bit = 0; bit < 8; ++bit)
+                crc = (crc >> 1) ^ (0xEDB88320u & (0u - (crc & 1u)));
+        }
+        return ~crc;
+    }
+
+    std::vector<uint8_t> SnapshotStateFields(const std::span<const uint8_t> snapshot)
+    {
+        std::vector<uint8_t> state;
+        for (size_t offset = 24; offset < snapshot.size();)
+        {
+            const auto id = static_cast<uint16_t>(snapshot[offset] | snapshot[offset + 1] << 8);
+            const auto length = ReadSnapshotU32(snapshot, offset + 4);
+            const auto end = offset + 8 + length;
+            VERIFY_IS_TRUE(end <= snapshot.size());
+            if (id != 1)
+                state.insert(state.end(), snapshot.begin() + offset, snapshot.begin() + end);
+            offset = end;
+        }
+        return state;
+    }
+
