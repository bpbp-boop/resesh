+                            cursor.Column <= 0 || cursor.Column > SHRT_MAX ||
+                            cursor.Page <= 0 || cursor.Page > SHRT_MAX);
+        }
+        THROW_HR_IF(E_INVALIDARG, !reader.Done());
+        return state;
+    }
+}
