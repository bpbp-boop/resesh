+
+uint32_t Terminal::ReseshSystemModes() const noexcept
+{
+    uint32_t result{};
+    for (size_t i = 0; i <= static_cast<size_t>(Mode::BracketedPaste); ++i)
+    {
+        if (_systemMode.test(static_cast<Mode>(i)))
+        {
+            result |= 1u << i;
+        }
+    }
+    return result;
+}
+
+uint32_t Terminal::ReseshInputModes() const noexcept
+{
+    uint32_t result{};
+    for (size_t i = 0; i <= static_cast<size_t>(TerminalInput::Mode::AlternateScroll); ++i)
+    {
+        if (_terminalInput.GetInputMode(static_cast<TerminalInput::Mode>(i)))
+        {
+            result |= 1u << i;
+        }
+    }
+    return result;
+}
+
+std::wstring_view Terminal::ReseshPendingSequence() const noexcept
+{
+    return _stateMachine->GetPendingSequence();
+}
+
+AdaptDispatch& Terminal::ReseshDispatch() noexcept
+{
+    auto& engine = reinterpret_cast<OutputStateMachineEngine&>(_stateMachine->Engine());
+    return static_cast<AdaptDispatch&>(engine.Dispatch());
+}
+
+void Terminal::RestoreReseshSnapshot(
+    std::unique_ptr<TextBuffer> mainBuffer,
+    std::unique_ptr<TextBuffer> alternateBuffer,
+    const Viewport mutableViewport,
+    const til::CoordType scrollOffset,
+    const uint32_t systemModes,
+    const uint32_t inputModes,
+    const std::wstring_view pendingSequence,
+    const std::wstring_view title,
+    const std::wstring_view workingDirectory)
+{
+    _assertLocked();
+    THROW_HR_IF_NULL(E_INVALIDARG, mainBuffer);
+    const auto mainSize = mainBuffer->GetSize().Dimensions();
+    const auto viewport = mutableViewport.ToInclusive();
+    THROW_HR_IF(E_INVALIDARG,
+                viewport.left != 0 ||
+                    viewport.right != mainSize.width - 1 ||
+                    viewport.top < 0 ||
+                    viewport.bottom >= mainSize.height ||
+                    scrollOffset < 0 ||
+                    scrollOffset > viewport.top);
+
+    const auto alternateActive = alternateBuffer != nullptr;
+    mainBuffer->SetAsActiveBuffer(!alternateActive);
+    if (alternateBuffer)
+    {
+        THROW_HR_IF(E_INVALIDARG, alternateBuffer->GetSize().Dimensions() != mutableViewport.Dimensions());
+        alternateBuffer->SetAsActiveBuffer(true);
+    }
+
+    _mainBuffer = std::move(mainBuffer);
+    _altBuffer = std::move(alternateBuffer);
+    _mutableViewport = mutableViewport;
+    _scrollbackLines = mainSize.height - mutableViewport.Height();
+    _scrollOffset = scrollOffset;
+    _altBufferSize = _altBuffer ? _altBuffer->GetSize().Dimensions() : mutableViewport.Dimensions();
+    _title = std::wstring{ title };
+    _workingDirectory.assign(workingDirectory);
+
+    for (size_t i = 0; i <= static_cast<size_t>(Mode::BracketedPaste); ++i)
+    {
+        _systemMode.set(static_cast<Mode>(i), (systemModes & (uint32_t{ 1 } << i)) != 0);
+    }
+    for (size_t i = 0; i <= static_cast<size_t>(TerminalInput::Mode::AlternateScroll); ++i)
+    {
+        _terminalInput.SetInputMode(
+            static_cast<TerminalInput::Mode>(i),
+            (inputModes & (uint32_t{ 1 } << i)) != 0);
+    }
+    _stateMachine->RestorePendingSequence(pendingSequence);
+
+    _selection = {};
+    _searchHighlights.clear();
+    _persistentHighlights.clear();
+    _clearPatternTree();
+    UpdatePatternsUnderLock();
+    _activeBuffer().TriggerRedrawAll();
+    _NotifyScrollEvent();
+}
