+                    viewport->Width() != mainData->Size.width ||
+                    viewport->BottomInclusive() >= mainData->Size.height ||
+                    (alternateData && alternateData->Size != viewport->Dimensions()) ||
+                    (!dispatchState->TabStops.empty() &&
+                     dispatchState->TabStops.size() != static_cast<size_t>(viewport->Width())) ||
+                    dispatchState->ScrollMargins.left < 0 ||
+                    dispatchState->ScrollMargins.top < 0 ||
+                    dispatchState->ScrollMargins.right >= viewport->Width() ||
+                    dispatchState->ScrollMargins.bottom >= viewport->Height() ||
+                    nextMarkId == 0 || markGeneration == 0);
+
+    const auto buildBuffer = [&](SnapshotBufferData& data, const bool active) {
+        auto buffer = std::make_unique<TextBuffer>(
+            data.Size,
+            data.CurrentAttribute,
+            data.CursorSize,
+            active,
+            _renderer.get());
+        for (const auto& link : data.Links)
+            buffer->ReseshRestoreHyperlink(link.Id, link.Uri, link.CustomId);
+        buffer->ReseshRestoreNextHyperlinkId(data.NextHyperlinkId);
+        for (til::CoordType y = 0; y < data.Size.height; ++y)
