+AdaptDispatch::ReseshSnapshot AdaptDispatch::CaptureReseshSnapshot() const
+{
+    ReseshSnapshot snapshot;
+    snapshot.TabStops = _tabStopColumns;
+    snapshot.InitializeDefaultTabStops = _initDefaultTabStops;
+    snapshot.UsingAlternateBuffer = _usingAltBuffer;
+    snapshot.ScrollMargins = _scrollMargins;
+    snapshot.Output = _termOutput.CaptureReseshSnapshot();
+    for (size_t i = 0; i < snapshot.SavedCursors.size(); ++i)
+    {
+        const auto& source = _savedCursorState[i];
+        auto& destination = snapshot.SavedCursors[i];
+        destination.Row = source.Row;
+        destination.Column = source.Column;
+        destination.Page = source.Page;
+        destination.DelayedWrap = source.IsDelayedEOLWrap;
+        destination.OriginRelative = source.IsOriginModeRelative;
+        destination.Attributes = source.Attributes;
+        destination.Output = source.TermOutput.CaptureReseshSnapshot();
+    }
+    for (size_t i = 0; i <= static_cast<size_t>(Mode::PageCursorCoupling); ++i)
+    {
+        if (_modes.test(static_cast<Mode>(i)))
+        {
+            snapshot.Modes |= uint32_t{ 1 } << i;
+        }
+    }
+    return snapshot;
+}
+
+void AdaptDispatch::RestoreReseshSnapshot(const ReseshSnapshot& snapshot)
+{
+    THROW_HR_IF(E_INVALIDARG,
+                snapshot.TabStops.size() > SHRT_MAX ||
+                    std::ranges::any_of(snapshot.TabStops, [](const auto stop) { return stop > 1; }) ||
+                    (snapshot.Modes >> (static_cast<size_t>(Mode::PageCursorCoupling) + 1)) != 0);
+
+    auto output = TerminalOutput{};
+    output.RestoreReseshSnapshot(snapshot.Output);
+    std::array<CursorState, 2> savedCursors;
+    for (size_t i = 0; i < savedCursors.size(); ++i)
+    {
+        const auto& source = snapshot.SavedCursors[i];
+        auto& destination = savedCursors[i];
+        destination.Row = source.Row;
+        destination.Column = source.Column;
+        destination.Page = source.Page;
+        destination.IsDelayedEOLWrap = source.DelayedWrap;
+        destination.IsOriginModeRelative = source.OriginRelative;
+        destination.Attributes = source.Attributes;
+        destination.TermOutput.RestoreReseshSnapshot(source.Output);
+    }
+
+    _tabStopColumns = snapshot.TabStops;
+    _initDefaultTabStops = snapshot.InitializeDefaultTabStops;
+    _savedCursorState = std::move(savedCursors);
+    _usingAltBuffer = snapshot.UsingAlternateBuffer;
+    _scrollMargins = snapshot.ScrollMargins;
+    _termOutput = std::move(output);
+    for (size_t i = 0; i <= static_cast<size_t>(Mode::PageCursorCoupling); ++i)
+    {
+        _modes.set(static_cast<Mode>(i), (snapshot.Modes & (uint32_t{ 1 } << i)) != 0);
+    }
+    if (_sixelParser)
+    {
+        _sixelParser->SetDisplayMode(_modes.test(Mode::SixelDisplay));
+    }
+}
