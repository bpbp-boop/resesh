+        default:
+            THROW_HR_IF(E_INVALIDARG, minor <= SnapshotMinor);
+            break;
+        }
     }
+    THROW_HR_IF(E_INVALIDARG,
+                !hasMetadata || !mainData || !viewport || !hasText || !hasMarks || !dispatchState ||
+                    alternateActive != alternateData.has_value() ||
