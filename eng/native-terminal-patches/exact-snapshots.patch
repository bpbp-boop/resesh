+std::vector<uint8_t> HwndTerminal::CaptureExactSnapshot(
+    const std::wstring_view title,
+    const std::wstring_view workingDirectory,
+    const uint64_t captureSequence,
+    const int64_t unixTimeMilliseconds) const
+{
+    THROW_HR_IF_NULL(E_NOT_VALID_STATE, _terminal);
+    SnapshotWriter payload;
+    const auto lock = _terminal->LockForReading();
+
+    SnapshotWriter metadata;
+    metadata.String(L"v1.24.11911.0");
+    metadata.String(L"terminal-parser-v1");
+    const auto viewport = _terminal->ReseshMutableViewport().ToInclusive();
+    metadata.I32(viewport.left);
+    metadata.I32(viewport.top);
+    metadata.I32(viewport.right);
+    metadata.I32(viewport.bottom);
+    metadata.I32(_terminal->ReseshUserScrollOffset());
+    metadata.U32(_terminal->ReseshSystemModes());
+    metadata.U32(_terminal->ReseshInputModes());
+    metadata.U8(_terminal->IsAlternateBufferActive());
+    metadata.U64(captureSequence);
+    metadata.I64(unixTimeMilliseconds);
+    const auto& colors = _terminal->GetRenderSettings().GetColorTable();
+    metadata.U32(gsl::narrow<uint32_t>(colors.size()));
+    for (const auto color : colors)
+        metadata.U32(color);
+    for (size_t alias = 0; alias < static_cast<size_t>(ColorAlias::ENUM_COUNT); ++alias)
+        metadata.U32(gsl::narrow<uint32_t>(_terminal->GetRenderSettings().GetColorAliasIndex(static_cast<ColorAlias>(alias))));
+    payload.Field(SnapshotMetadata, metadata);
+
+    SnapshotWriter main;
+    WriteBuffer(main, _terminal->ReseshMainBuffer());
+    payload.Field(SnapshotMainBuffer, main);
+    if (const auto alternate = _terminal->ReseshAlternateBuffer())
+    {
+        SnapshotWriter alt;
+        WriteBuffer(alt, *alternate);
+        payload.Field(SnapshotAlternateBuffer, alt);
+    }
+
+    SnapshotWriter text;
+    text.String(title);
+    text.String(workingDirectory);
+    text.String(_terminal->ReseshPendingSequence());
+    payload.Field(SnapshotTextState, text);
+
+    SnapshotWriter marks;
+    marks.U64(_nextMarkId);
+    marks.U64(_markGeneration);
+    marks.U32(gsl::narrow<uint32_t>(_applicationCommands.size()));
+    for (const auto& [id, command] : _applicationCommands)
+    {
+        marks.U64(id);
+        marks.String(command.Command);
+        marks.I32(command.CommandStart.x);
+        marks.I32(command.CommandStart.y);
+        marks.I32(command.CommandEnd.x);
+        marks.I32(command.CommandEnd.y);
+    }
+    payload.Field(SnapshotApplicationMarks, marks);
+
+    SnapshotWriter dispatch;
+    WriteDispatchState(dispatch, _terminal->ReseshDispatch().CaptureReseshSnapshot());
+    payload.Field(SnapshotDispatchState, dispatch);
+
+    THROW_HR_IF(E_OUTOFMEMORY, payload.Data.size() > MaximumSnapshotBytes - SnapshotHeaderSize);
+    SnapshotWriter result;
+    result.U32(SnapshotMagic);
+    result.U16(SnapshotMajor);
+    result.U16(SnapshotMinor);
+    result.U32(0x000000ff);
+    result.U32(gsl::narrow<uint32_t>(payload.Data.size()));
+    result.U32(SnapshotCrc32(payload.Data));
+    result.U32(0);
+    result.Bytes(payload.Data);
+    return result.Data;
+}
