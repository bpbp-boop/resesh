-        cursorRow + 1,
-        snapshot.Cursor.x + 1,
-        snapshot.CursorVisible ? L'h' : L'l');
-    return snapshot;
+    auto mainBuffer = buildBuffer(*mainData, !alternateActive);
+    auto alternateBuffer = alternateData ? buildBuffer(*alternateData, true) : nullptr;
+    const auto lock = _terminal->LockForWriting();
+    auto& renderSettings = _terminal->GetRenderSettings();
+    for (size_t i = 0; i < colors.size(); ++i)
+        renderSettings.SetColorTableEntry(i, colors[i]);
+    for (size_t i = 0; i < aliases.size(); ++i)
+        renderSettings.SetColorAliasIndex(static_cast<ColorAlias>(i), aliases[i]);
+    _terminal->RestoreReseshSnapshot(
+        std::move(mainBuffer),
+        std::move(alternateBuffer),
+        *viewport,
+        scrollOffset,
+        systemModes,
+        inputModes,
+        pendingSequence,
+        restored.Title,
+        restored.WorkingDirectory);
+    _terminal->ReseshDispatch().RestoreReseshSnapshot(*dispatchState);
+    _nextMarkId = nextMarkId;
+    _markGeneration = markGeneration;
+    _applicationCommands = std::move(applicationCommands);
+    ClearSearch();
+    _updateHighlights(true);
+    restored.SystemModes = systemModes;
+    restored.AlternateActive = alternateActive;
+    return restored;
 }
 
