+HwndTerminalSnapshotMetadata HwndTerminal::RestoreExactSnapshot(const std::span<const uint8_t> snapshot)
+{
+    THROW_HR_IF_NULL(E_NOT_VALID_STATE, _terminal);
+    THROW_HR_IF(E_INVALIDARG, snapshot.size() < SnapshotHeaderSize || snapshot.size() > MaximumSnapshotBytes);
+    SnapshotReader header{ snapshot };
+    THROW_HR_IF(E_INVALIDARG, header.U32() != SnapshotMagic);
+    THROW_HR_IF(HRESULT_FROM_WIN32(ERROR_REVISION_MISMATCH), header.U16() != SnapshotMajor);
+    const auto minor = header.U16();
+    const auto features = header.U32();
+    const auto payloadLength = header.U32();
+    const auto checksum = header.U32();
+    const auto reserved = header.U32();
+    THROW_HR_IF(E_INVALIDARG,
+                reserved != 0 ||
+                    payloadLength != snapshot.size() - SnapshotHeaderSize ||
+                    SnapshotCrc32(snapshot.subspan(SnapshotHeaderSize)) != checksum ||
+                    (features & RequiredSnapshotFeatures) != RequiredSnapshotFeatures ||
+                    (minor <= SnapshotMinor && features != RequiredSnapshotFeatures));
+
+    std::optional<SnapshotBufferData> mainData;
+    std::optional<SnapshotBufferData> alternateData;
+    std::optional<Viewport> viewport;
+    til::CoordType scrollOffset{};
+    uint32_t systemModes{};
+    uint32_t inputModes{};
+    bool alternateActive{};
+    HwndTerminalSnapshotMetadata restored;
+    std::wstring pendingSequence;
+    std::array<COLORREF, TextColor::TABLE_SIZE> colors{};
+    std::array<uint32_t, static_cast<size_t>(ColorAlias::ENUM_COUNT)> aliases{};
+    bool hasMetadata{};
+    uint64_t nextMarkId{};
+    uint64_t markGeneration{};
+    std::unordered_map<uint64_t, HwndTerminalApplicationMark> applicationCommands;
+    bool hasMarks{};
+    bool hasText{};
+    std::optional<AdaptDispatch::ReseshSnapshot> dispatchState;
+
+    SnapshotReader fields{ snapshot.subspan(SnapshotHeaderSize) };
+    while (!fields.Done())
+    {
+        fields.Need(SnapshotFieldHeaderSize);
+        const auto id = fields.U16();
+        const auto fieldFlags = fields.U16();
+        THROW_HR_IF(E_INVALIDARG, id <= SnapshotDispatchState && fieldFlags != 0);
+        const auto length = fields.U32();
+        const auto bytes = fields.Bytes(length);
+        SnapshotReader field{ bytes };
+        switch (id)
+        {
+        case SnapshotMetadata:
+        {
+            THROW_HR_IF(E_INVALIDARG, hasMetadata);
+            THROW_HR_IF(E_INVALIDARG, field.String() != L"v1.24.11911.0");
+            field.String(); // parser version is informational within schema major 1.
+            const til::inclusive_rect rect{ field.I32(), field.I32(), field.I32(), field.I32() };
+            THROW_HR_IF(E_INVALIDARG, rect.left != 0 || rect.right < rect.left || rect.bottom < rect.top);
+            viewport = Viewport::FromInclusive(rect);
+            scrollOffset = field.I32();
+            systemModes = field.U32();
+            inputModes = field.U32();
+            alternateActive = ReadSnapshotBool(field);
+            restored.CaptureSequence = field.U64();
+            restored.UnixTimeMilliseconds = field.I64();
+            const auto colorCount = field.U32();
+            THROW_HR_IF(E_INVALIDARG, colorCount != colors.size());
+            for (auto& color : colors)
+                color = field.U32();
+            for (auto& alias : aliases)
+            {
+                alias = field.U32();
+                THROW_HR_IF(E_INVALIDARG, alias >= colors.size());
+            }
+            THROW_HR_IF(E_INVALIDARG, !field.Done());
+            hasMetadata = true;
+            break;
+        }
+        case SnapshotMainBuffer:
+            THROW_HR_IF(E_INVALIDARG, mainData.has_value());
+            mainData = ReadBuffer(field);
+            break;
+        case SnapshotAlternateBuffer:
+            THROW_HR_IF(E_INVALIDARG, alternateData.has_value());
+            alternateData = ReadBuffer(field);
+            break;
+        case SnapshotTextState:
+            THROW_HR_IF(E_INVALIDARG, hasText);
+            restored.Title = field.String();
+            restored.WorkingDirectory = field.String();
+            pendingSequence = field.String();
+            THROW_HR_IF(E_INVALIDARG, !field.Done());
+            hasText = true;
+            break;
+        case SnapshotApplicationMarks:
+        {
+            THROW_HR_IF(E_INVALIDARG, hasMarks);
+            nextMarkId = field.U64();
+            markGeneration = field.U64();
+            const auto count = field.U32();
+            THROW_HR_IF(E_INVALIDARG, count > MaximumSnapshotRows);
+            for (uint32_t i = 0; i < count; ++i)
+            {
+                const auto idValue = field.U64();
+                HwndTerminalApplicationMark command{
+                    field.String(),
+                    { field.I32(), field.I32() },
+                    { field.I32(), field.I32() },
