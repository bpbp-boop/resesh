+            for (const auto& cell : data.Rows[y].Cells)
+                cells.emplace_back(cell.Text, cell.Width, cell.Attribute);
+            row.WriteCells(OutputCellIterator{ std::span<const OutputCell>{ cells } }, 0);
+            row.SetWrapForced(data.Rows[y].Wrapped);
+            row.SetDoubleBytePadded(data.Rows[y].DoubleBytePadded);
+            row.SetLineRendition(data.Rows[y].Rendition);
+            row.SetScrollbarData(data.Rows[y].Mark);
+        }
+        auto& cursor = buffer->GetCursor();
+        cursor.SetPosition(data.Cursor);
+        cursor.SetStyle(data.CursorSize, data.CursorTypeValue);
+        cursor.SetIsVisible(data.CursorVisible);
+        cursor.SetIsOn(data.CursorOn);
