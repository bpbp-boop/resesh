+TerminalOutput::ReseshSnapshot TerminalOutput::CaptureReseshSnapshot() const noexcept
+{
+    ReseshSnapshot snapshot;
+    snapshot.UserPreferenceCharset = static_cast<uint32_t>(_upssId);
+    snapshot.UserPreferenceCharsetIs96 = _upssTranslationTable.size() == 96;
+    for (size_t i = 0; i < snapshot.CharacterSets.size(); ++i)
+    {
+        snapshot.CharacterSets[i] = static_cast<uint32_t>(_gsetIds[i]);
+        snapshot.CharacterSetsAre96[i] = _gsetTranslationTables[i].size() == 96;
+    }
+    snapshot.LeftSet = gsl::narrow_cast<uint32_t>(_glSetNumber);
+    snapshot.RightSet = gsl::narrow_cast<uint32_t>(_grSetNumber);
+    snapshot.SingleShiftSet = gsl::narrow_cast<uint32_t>(_ssSetNumber);
+    snapshot.GrTranslationEnabled = _grTranslationEnabled;
+    snapshot.DrcsCharset = static_cast<uint32_t>(_drcsId);
+    snapshot.DrcsCharsetIs96 = _drcsTranslationTable.size() == 96;
+    return snapshot;
+}
+
+void TerminalOutput::RestoreReseshSnapshot(const ReseshSnapshot& snapshot)
+{
+    THROW_HR_IF(E_INVALIDARG,
+                snapshot.LeftSet > 3 ||
+                    snapshot.RightSet > 3 ||
+                    snapshot.SingleShiftSet > 3);
+
+    TerminalOutput restored{ snapshot.GrTranslationEnabled };
+    restored.AssignUserPreferenceCharset(
+        static_cast<VTID>(snapshot.UserPreferenceCharset),
+        snapshot.UserPreferenceCharsetIs96);
+    THROW_HR_IF(E_INVALIDARG,
+                static_cast<uint32_t>(restored.GetUserPreferenceCharsetId()) != snapshot.UserPreferenceCharset ||
+                    (restored.GetUserPreferenceCharsetSize() == 96) != snapshot.UserPreferenceCharsetIs96);
+    for (size_t i = 0; i < snapshot.CharacterSets.size(); ++i)
+    {
+        if (snapshot.CharacterSetsAre96[i])
+        {
+            restored.Designate96Charset(i, static_cast<VTID>(snapshot.CharacterSets[i]));
+        }
+        else
+        {
+            restored.Designate94Charset(i, static_cast<VTID>(snapshot.CharacterSets[i]));
+        }
+        THROW_HR_IF(E_INVALIDARG,
+                    static_cast<uint32_t>(restored.GetCharsetId(i)) != snapshot.CharacterSets[i] ||
+                        (restored.GetCharsetSize(i) == 96) != snapshot.CharacterSetsAre96[i]);
+    }
+    if (snapshot.DrcsCharset != 0)
+    {
+        if (snapshot.DrcsCharsetIs96)
+        {
+            restored.SetDrcs96Designation(static_cast<VTID>(snapshot.DrcsCharset));
+        }
+        else
+        {
+            restored.SetDrcs94Designation(static_cast<VTID>(snapshot.DrcsCharset));
+        }
+    }
+    restored.LockingShift(snapshot.LeftSet);
+    restored.LockingShiftRight(snapshot.RightSet);
+    if (snapshot.SingleShiftSet != 0)
+    {
+        restored.SingleShift(snapshot.SingleShiftSet);
+    }
+    *this = std::move(restored);
+}
