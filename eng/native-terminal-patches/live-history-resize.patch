+[[nodiscard]] HRESULT Terminal::SetHistorySize(const til::CoordType historySize, til::CoordType* const rowsRemoved) noexcept
+try
+{
+    RETURN_HR_IF_NULL(E_INVALIDARG, rowsRemoved);
+    RETURN_HR_IF(E_INVALIDARG, historySize < 0);
+    RETURN_HR_IF_NULL(E_NOT_VALID_STATE, _mainBuffer);
+    _assertLocked();
+
+    *rowsRemoved = 0;
+    const auto viewportSize = _mutableViewport.Dimensions();
+    const auto newBufferHeight = std::clamp(viewportSize.height + historySize, 1, SHRT_MAX);
+    const auto oldBufferHeight = _mainBuffer->GetSize().Height();
+    const auto configuredSizeChanged = historySize != _scrollbackLines;
+    _scrollbackLines = historySize;
+
+    if (newBufferHeight == oldBufferHeight)
+    {
+        if (!configuredSizeChanged)
+        {
+            return S_FALSE;
+        }
+        _NotifyScrollEvent();
+        return S_OK;
+    }
+
+    ClearSelection();
+
+    const auto oldMutableTop = _mutableViewport.Top();
+    const auto oldVisibleTop = std::max(0, oldMutableTop - _scrollOffset);
+    const auto retainedHistory = newBufferHeight - viewportSize.height;
+    const auto removed = std::max(0, oldMutableTop - retainedHistory);
+
+    _mainBuffer->ResizeHeight(newBufferHeight, removed);
+    *rowsRemoved = removed;
+
+    const auto newMutableTop = oldMutableTop - removed;
+    _mutableViewport = Viewport::FromDimensions({ 0, newMutableTop }, viewportSize);
+    const auto newVisibleTop = std::clamp(oldVisibleTop - removed, 0, newMutableTop);
+    _scrollOffset = newMutableTop - newVisibleTop;
+
+    _searchHighlights.clear();
+    _persistentHighlights.clear();
+    _clearPatternTree();
+
+    if (!_inAltBuffer())
+    {
+        _mainBuffer->TriggerRedrawAll();
+    }
+    _NotifyScrollEvent();
+    return S_OK;
+}
+CATCH_RETURN()
 
