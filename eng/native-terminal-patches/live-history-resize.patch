+void TextBuffer::ResizeHeight(const til::CoordType newHeight, const til::CoordType rowsToDrop)
+{
+    THROW_HR_IF(E_INVALIDARG, newHeight <= 0 || rowsToDrop < 0 || rowsToDrop > _height);
+
+    const auto cursorPosition = GetCursor().GetPosition();
+    THROW_HR_IF(E_INVALIDARG, rowsToDrop > cursorPosition.y);
+
+    TextBuffer newBuffer{ { _width, newHeight }, _currentAttributes, 0, _isActiveBuffer, _renderer };
+    const auto copyableRows = std::min<til::CoordType>(_height - rowsToDrop, newHeight);
+    for (til::CoordType row = 0; row < copyableRows; ++row)
+    {
+        CopyRow(row + rowsToDrop, row, newBuffer);
+        newBuffer.GetMutableRowByOffset(row).SetScrollbarData(
+            GetRowByOffset(row + rowsToDrop).GetScrollbarData());
+    }
+
+    // Keep this in sync with ResizeTraditional(). The hyperlink maps and current
+    // attributes belong to this buffer and remain valid for every retained row.
+    _buffer = std::move(newBuffer._buffer);
+    _bufferEnd = newBuffer._bufferEnd;
+    _commitWatermark = newBuffer._commitWatermark;
+    _initialAttributes = newBuffer._initialAttributes;
+    _bufferRowStride = newBuffer._bufferRowStride;
+    _bufferOffsetChars = newBuffer._bufferOffsetChars;
+    _bufferOffsetCharOffsets = newBuffer._bufferOffsetCharOffsets;
+    _height = gsl::narrow<uint16_t>(newHeight);
+    _SetFirstRowIndex(0);
+    ++_lastMutationId;
+
+    auto adjustedCursor = cursorPosition;
+    adjustedCursor.y -= rowsToDrop;
+    GetCursor().SetPosition(ClampPositionWithinLine(adjustedCursor));
+}
