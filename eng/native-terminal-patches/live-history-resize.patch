+HRESULT HwndTerminal::SetHistorySize(const int32_t historySize)
+{
+    RETURN_HR_IF_NULL(E_NOT_VALID_STATE, _terminal);
+
+    const auto lock = _terminal->LockForWriting();
+    const auto wasAlternateBufferActive = _terminal->IsAlternateBufferActive();
+    const auto focusedSearch = _searcher.GetCurrent();
+    const auto focusedSearchStart = focusedSearch ? std::optional{ focusedSearch->start } : std::nullopt;
+
+    til::CoordType rowsRemoved{};
+    const auto result = _terminal->SetHistorySize(historySize, &rowsRemoved);
+    RETURN_IF_FAILED(result);
+    if (result == S_FALSE)
+    {
+        return S_FALSE;
+    }
+
+    _terminal->UpdatePatternsUnderLock();
+    if (_searchActive && !wasAlternateBufferActive)
+    {
+        auto oldResults = _searcher.ExtractResults();
+        _searcher.Reset(*_terminal, _searchQuery, _searchFlags, _searchReverse);
+        if (focusedSearchStart)
+        {
+            auto rebased = *focusedSearchStart;
+            rebased.y = std::max(0, rebased.y - rowsRemoved);
+            _searcher.MoveToPoint(rebased);
+        }
+
+        _terminal->SetSearchHighlights(_searcher.Results());
+        _terminal->SetSearchHighlightFocused(
+            gsl::narrow<size_t>(std::max<ptrdiff_t>(0, _searcher.CurrentMatch())));
+        _renderer->TriggerSearchHighlight(oldResults);
+        _searchState = {
+            .TotalMatches = gsl::narrow<int32_t>(_searcher.Results().size()),
+            .CurrentMatch = gsl::narrow<int32_t>(_searcher.CurrentMatch()),
+            .Invalidated = true,
+            .InvalidRegex = !_searcher.IsOk(),
+        };
+    }
+    std::erase_if(_applicationCommands, [&](auto& entry) {
+        auto& command = entry.second;
+        if (command.CommandStart.y < rowsRemoved)
+        {
+            return true;
+        }
+        command.CommandStart.y -= rowsRemoved;
+        command.CommandEnd.y = std::max(0, command.CommandEnd.y - rowsRemoved);
+        return false;
+    });
+    _hoveredHyperlinkId = 0;
+    _hoveredHyperlinkInterval.reset();
+    _pressedLink.reset();
+
+    ++_markGeneration;
+    _updateHighlights(true);
+    return S_OK;
+}
