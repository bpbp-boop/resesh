+uint32_t HwndTerminal::SendPointerEvent(
+    const UINT message,
+    const WPARAM buttons,
+    const LPARAM position,
+    const short wheelDelta) noexcept
+try
+{
+    uint32_t result{};
+    const auto withCursor = [&]() {
+        if (_hoveredHyperlinkId != 0 || _hoveredHyperlinkInterval)
+        {
+            result |= ReseshTerminalPointerHandCursor;
+        }
+        return result;
+    };
+
+    const auto shiftPressed = GetKeyState(VK_SHIFT) < 0;
+    const auto wheelButtons = buttons | (static_cast<WPARAM>(static_cast<uint16_t>(wheelDelta)) << 16);
+    if (!shiftPressed && _CanSendVTMouseInput() && _SendMouseEvent(message, wheelButtons, position))
+    {
+        result |= ReseshTerminalPointerHandled;
+        if (message == WM_LBUTTONDOWN || message == WM_MBUTTONDOWN || message == WM_RBUTTONDOWN)
+        {
+            result |= ReseshTerminalPointerCapture;
+        }
+        else if (message == WM_LBUTTONUP || message == WM_MBUTTONUP || message == WM_RBUTTONUP)
+        {
+            result |= ReseshTerminalPointerRelease;
+        }
+        return withCursor();
+    }
+
+    switch (message)
+    {
+    case WM_LBUTTONDOWN:
+        _UpdateHoveredLink(position);
+        if (!shiftPressed)
+        {
+            if (auto link = _LinkAt(position))
+            {
+                _pressedLink = std::move(link);
+                result |= ReseshTerminalPointerHandled | ReseshTerminalPointerCapture;
+                return withCursor();
+            }
+        }
+        LOG_IF_FAILED(_StartSelection(position));
+        result |= ReseshTerminalPointerHandled | ReseshTerminalPointerCapture;
+        break;
+    case WM_LBUTTONUP:
+        if (_pressedLink)
+        {
+            const auto pressed = std::exchange(_pressedLink, std::nullopt);
+            if (const auto released = _LinkAt(position);
+                released && released == pressed && _openLinkCallback)
+            {
+                _openLinkCallback(released->first, released->second);
+            }
+        }
+        else if (_copyOnSelect)
+        {
+            CopySelection(false);
+        }
+        _singleClickTouchdownPos = std::nullopt;
+        result |= ReseshTerminalPointerHandled | ReseshTerminalPointerRelease;
+        break;
+    case WM_MBUTTONUP:
+    case WM_RBUTTONUP:
+        result |= ReseshTerminalPointerRelease;
+        break;
+    case WM_MOUSEMOVE:
+        if (WI_IsFlagSet(buttons, MK_LBUTTON))
+        {
+            LOG_IF_FAILED(_MoveSelection(position));
+            result |= ReseshTerminalPointerHandled;
+        }
+        _UpdateHoveredLink(position);
+        break;
+    case WM_MOUSELEAVE:
+        _ClearHoveredLink();
+        break;
+    case WM_RBUTTONDOWN:
+    {
+        const auto copied = !_copyOnSelect && CopySelection(true);
+        if (_copyOnSelect)
+        {
+            _ClearSelection();
+        }
+        if (_rightClickPaste && !_readOnly &&
+            (_copyOnSelect || !copied) && _pasteRequestCallback)
+        {
+            _pasteRequestCallback();
+        }
+        result |= ReseshTerminalPointerHandled;
+        break;
+    }
+    default:
+        break;
+    }
+
+    return withCursor();
+}
+catch (...)
+{
+    LOG_CAUGHT_EXCEPTION();
+    return 0;
+}
