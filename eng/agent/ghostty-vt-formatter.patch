+test "Page VT with hyperlinks" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+
+    var builder: std.Io.Writer.Allocating = .init(alloc);
+    defer builder.deinit();
+
+    var t = try Terminal.init(io, alloc, .{
+        .cols = 80,
+        .rows = 24,
+    });
+    defer t.deinit(alloc);
+
+    var s = t.vtStream();
+    defer s.deinit();
+
+    // One link without an ID, one with, and one left open at the end
+    s.nextSlice("\x1b]8;;https://example.com\x1b\\one\x1b]8;;\x1b\\ " ++
+        "\x1b]8;id=x;https://example.org\x1b\\two\x1b]8;;\x1b\\ plain " ++
+        "\x1b]8;;https://example.net\x1b\\open");
+
+    const pages = &t.screens.active.pages;
+    const page = pages.pages.last.?.page();
+    var formatter: PageFormatter = .init(page, .{ .emit = .vt });
+
+    try formatter.format(&builder.writer);
+    const output = builder.writer.buffered();
+
+    try testing.expectEqualStrings(
+        "\x1b]8;;https://example.com\x1b\\one\x1b]8;;\x1b\\ " ++
+            "\x1b]8;id=x;https://example.org\x1b\\two\x1b]8;;\x1b\\ plain " ++
+            "\x1b]8;;https://example.net\x1b\\open\x1b]8;;\x1b\\",
+        output,
+    );
+
+    // Read back by a second terminal, the cells carry the same links
+    var t2 = try Terminal.init(io, alloc, .{
+        .cols = 80,
+        .rows = 24,
+    });
+    defer t2.deinit(alloc);
+
+    var s2 = t2.vtStream();
+    defer s2.deinit();
+    s2.nextSlice(output);
+
+    const page2 = t2.screens.active.pages.pages.last.?.page();
+    const cells = page2.getCells(page2.getRow(0));
+    try testing.expect(cells[0].hyperlink);
+    try testing.expect(!cells[3].hyperlink);
+    try testing.expect(cells[4].hyperlink);
+    const link = page2.hyperlink_set.get(
+        page2.memory,
+        page2.lookupHyperlink(&cells[4]).?,
+    );
+    try testing.expectEqualStrings(
+        "https://example.org",
+        link.uri.offset.ptr(page2.memory)[0..link.uri.len],
+    );
+    try testing.expectEqualStrings(
+        "x",
+        link.id.explicit.offset.ptr(page2.memory)[0..link.id.explicit.len],
+    );
+    try testing.expect(t2.screens.active.cursor.hyperlink == null);
+}
