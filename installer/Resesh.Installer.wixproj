<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <InstallerPlatform Condition="'$(InstallerPlatform)' == ''">x64</InstallerPlatform>
    <IntermediateOutputPath>obj\$(InstallerPlatform)\$(Configuration)\</IntermediateOutputPath>
    <OutputName>resesh-$(ProductVersion)-windows-$(InstallerPlatform)</OutputName>
    <OutputType>Package</OutputType>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.0.0</ProductVersion>
    <DefineConstants>$(DefineConstants);ProductVersion=$(ProductVersion)</DefineConstants>
    <DebugType>none</DebugType>
    <SuppressIces>$(SuppressIces);ICE03</SuppressIces>
    <!-- Bundle.wxs in this directory belongs to Resesh.Bundle.wixproj. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Package.wxs" />
  </ItemGroup>

  <ItemGroup>
    <BindPath Include="$(PayloadDir)" BindName="Payload" />
  </ItemGroup>

  <Target Name="ValidateInstallerInputs" BeforeTargets="Build">
    <Error Condition="'$(PayloadDir)' == ''" Text="PayloadDir must point to a Resesh release build." />
    <Error Condition="!Exists('$(PayloadDir)\Resesh.App.exe')" Text="PayloadDir does not contain Resesh.App.exe." />
    <!-- The terminal's native libraries (libghostty-vt and the reseshvt shim): no terminal works without them. -->
    <Error Condition="!Exists('$(PayloadDir)\GhosttyVt\ghostty-vt.dll') Or !Exists('$(PayloadDir)\GhosttyVt\reseshvt.dll')"
           Text="PayloadDir has no GhosttyVt libraries. Run eng/build-ghostty-vt.ps1 for this architecture before building the app." />
    <!-- The session agent for Linux hosts. The app runs without it, falling back to tmux,
         so only a package that left it out by accident is refused here. -->
    <Error Condition="!Exists('$(PayloadDir)\Agent\agent-manifest.json') Or !Exists('$(PayloadDir)\Agent\x86_64\resesh-agent') Or !Exists('$(PayloadDir)\Agent\aarch64\resesh-agent')"
           Text="PayloadDir has no session agent. Run eng/build-agent.ps1 before building the app." />
  </Target>
</Project>
