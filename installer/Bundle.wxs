<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle
    Name="resesh"
    Manufacturer="resesh"
    Version="$(ProductVersion)"
    UpgradeCode="7B7F9C7D-2F0A-4E1B-9D25-9C4B7A1E63F2"
    IconSourceFile="..\src\App\Assets\app.ico"
    AboutUrl="https://resesh.net/">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense" LicenseUrl="" />
    </BootstrapperApplication>

    <!-- VC++ 2015-2022 runtime; Bld gates out pre-VS2022 14.x installs that predate
         what the Windows App SDK links against. -->
    <util:RegistrySearch
      Id="VCRedistInstalled"
      Root="HKLM"
      Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\$(Arch)"
      Value="Installed"
      Variable="VCRedistInstalled" />
    <util:RegistrySearch
      Id="VCRedistBld"
      Root="HKLM"
      Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\$(Arch)"
      Value="Bld"
      Variable="VCRedistBld" />

    <!-- WebView2 Evergreen runtime, per-machine install. -->
    <util:RegistrySearch
      Id="WebView2Version"
      Root="HKLM"
      Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
      Value="pv"
      Variable="WebView2Version" />

    <Chain>
      <ExePackage
        Id="VCRedist"
        DisplayName="Microsoft Visual C++ 2015-2022 Runtime"
        SourceFile="prereqs\vc_redist.$(Arch).exe"
        Permanent="yes"
        Cache="remove"
        DetectCondition="VCRedistInstalled = 1 AND VCRedistBld &gt;= 30000"
        InstallArguments="/install /quiet /norestart">
        <ExitCode Value="3010" Behavior="success" />
      </ExePackage>

      <ExePackage
        Id="WebView2"
        DisplayName="Microsoft Edge WebView2 Runtime"
        SourceFile="prereqs\MicrosoftEdgeWebView2Setup.exe"
        Permanent="yes"
        Cache="remove"
        DetectCondition="WebView2Version &lt;&gt; &quot;&quot; AND WebView2Version &lt;&gt; &quot;0.0.0.0&quot;"
        InstallArguments="/silent /install">
        <ExitCode Value="3010" Behavior="success" />
      </ExePackage>

      <MsiPackage SourceFile="$(MsiPath)" Visible="no" />
    </Chain>
  </Bundle>
</Wix>
