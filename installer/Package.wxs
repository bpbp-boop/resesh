<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Resesh"
    Manufacturer="Resesh"
    Version="$(ProductVersion)"
    UpgradeCode="E284A090-DB9E-4E77-8E76-607841ED669E"
    Scope="perMachine"
    InstallerVersion="500"
    Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="ReseshIcon" SourceFile="..\src\App\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="ReseshIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://resesh.net/" />
    <Property Id="ARPHELPLINK" Value="https://github.com/bpbp-boop/resesh/issues" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Resesh" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <Files Include="!(bindpath.Payload)\**" Directory="INSTALLFOLDER">
      <Exclude Files="!(bindpath.Payload)\Resesh.App.exe" />
    </Files>

    <Component Directory="INSTALLFOLDER">
      <File Id="ReseshExecutable" Source="!(bindpath.Payload)\Resesh.App.exe" KeyPath="yes">
        <Shortcut
          Id="ReseshStartMenuShortcut"
          Directory="ProgramMenuFolder"
          Name="Resesh"
          WorkingDirectory="INSTALLFOLDER"
          Advertise="yes" />
      </File>
    </Component>
  </Package>
</Wix>
